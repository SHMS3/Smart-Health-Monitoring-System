@{
    ViewData["Title"] = "Dashboard";
}

<style>
    body {
        background-color: #f5f7fb;
    }

    .dashboard-header {
        margin-bottom: 25px;
    }

        .dashboard-header h3 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .dashboard-header p {
            margin: 0;
            color: #6c757d;
        }

    /* ===== CARD DASHBOARD ===== */
    .card-dashboard {
        border: none;
        border-radius: 18px;
        color: #fff;
        overflow: hidden;
        position: relative;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        height: 100%;
    }

        .card-dashboard:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        .card-dashboard .card-body {
            padding: 25px;
        }

        .card-dashboard h6 {
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.9;
            margin-bottom: 15px;
        }

        .card-dashboard h2 {
            font-size: 36px;
            font-weight: bold;
            margin: 0;
        }

        .card-dashboard .icon {
            position: absolute;
            right: 20px;
            bottom: 15px;
            font-size: 55px;
            opacity: 0.2;
        }

    /* Gradient màu */
    .bg-blue {
        background: linear-gradient(135deg, #36d1dc, #5b86e5);
    }

    .bg-green {
        background: linear-gradient(135deg, #11998e, #38ef7d);
    }

    .bg-orange {
        background: linear-gradient(135deg, #f7971e, #ffd200);
    }

    .bg-red {
        background: linear-gradient(135deg, #ee0979, #ff6a00);
    }

    .bg-purple {
        background: linear-gradient(135deg, #7f00ff, #9b59b6);
    }

    /* ===== ACTIVITY ===== */
    .activity-card {
        background: linear-gradient(145deg, #111827, #1e293b);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 22px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.25);
        color: #f1f5f9;
    }

    .activity-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 25px;
        color: #ffffff;
    }

    .activity-item {
        display: flex;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        transition: all 0.25s ease;
    }

        .activity-item:hover {
            transform: translateX(5px);
            background: rgba(255,255,255,0.02);
            border-radius: 12px;
            padding-left: 10px;
        }

        .activity-item:last-child {
            border-bottom: none;
        }

    .avatar-circle {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #06b6d4);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
        margin-right: 16px;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(59,130,246,.35);
    }

    .activity-content {
        color: #cbd5e1;
    }

        .activity-content b {
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
        }

        .activity-content small {
            color: #94a3b8 !important;
            font-size: 13px;
        }
</style>

<div class="container-fluid">

    <!-- HEADER -->
    <div class="dashboard-header">
        <h3>Dashboard</h3>
        <p>Tổng quan hệ thống quản lý bệnh án</p>
    </div>

    <!-- CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="card card-dashboard bg-blue">
                <div class="card-body">
                    <h6>Tổng số người dùng</h6>
                    <h2>@ViewBag.NumberOfCustomers</h2>
                    <div class="icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-dashboard bg-green">
                <div class="card-body">
                    <h6>Tổng số bác sĩ</h6>
                    <h2>@ViewBag.NumberOfBookings</h2>
                    <div class="icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-dashboard bg-orange">
                <div class="card-body">
                    <h6>Tổng số bệnh nhân</h6>
                    <h2>@ViewBag.NumberOfRooms</h2>
                    <div class="icon">
                        <i class="bi bi-door-open-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-dashboard bg-red">
                <div class="card-body">
                    <h6>Tổng số dịch vụ</h6>
                    <h2>12</h2>
                    <div class="icon">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-dashboard bg-purple">
                <div class="card-body">
                    <h6>Tổng số ý kiến</h6>
                    <h2>0</h2>
                    <div class="icon">
                        <i class="bi bi-chat-left-text-fill"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ACTIVITY -->
    <div class="card activity-card p-4 mt-4">

        <h5 class="activity-title">
            <i class="fas fa-clock me-2 text-info"></i>
            Hoạt động gần đây
        </h5>

        <div class="activity-item">
            <div class="avatar-circle">NV</div>

            <div class="activity-content">
                <b>Nguyen Van A</b> đăng ký môn học Web
                <br />
                <small>5 phút trước</small>
            </div>
        </div>

        <div class="activity-item">
            <div class="avatar-circle">TT</div>

            <div class="activity-content">
                <b>Tran Thi B</b> nộp bài tập Cấu trúc dữ liệu
                <br />
                <small>15 phút trước</small>
            </div>
        </div>

        <div class="activity-item">
            <div class="avatar-circle">LV</div>

            <div class="activity-content">
                <b>Le Van C</b> cập nhật thông tin cá nhân
                <br />
                <small>1 giờ trước</small>
            </div>
        </div>

    </div>

</div>