<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartHealth</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #3730a3;
            --primary-soft: #eef2ff;
            --bg-body: #f1f5f9;
            --sidebar-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --radius: 12px;
            --shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            --sidebar-width: 280px;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            overflow-x: hidden;
        }

        /* Bố cục chính sử dụng Flex */
        .app-container {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar cố định bên trái */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            border-right: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
            position: fixed;
            height: 100vh;
            z-index: 1050;
        }

        /* Content wrapper bên phải */
        .main-content {
            flex: 1;
            margin-left: var(--sidebar-width);
            display: flex;
            flex-direction: column;
            min-width: 0; /* Chống vỡ layout khi có bảng rộng */
            transition: all 0.3s ease;
        }

        /* Logo Area */
        .sidebar-header {
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--primary);
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: var(--primary);
            color: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .logo-name {
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: -0.5px;
        }

        /* Navigation Menu */
        .nav-list {
            padding: 0.5rem 1rem;
            flex: 1;
            overflow-y: auto;
        }

        .nav-group-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            margin: 1.5rem 0 0.5rem 0.5rem;
            letter-spacing: 1px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.8rem 1rem;
            color: var(--text-muted);
            border-radius: var(--radius);
            transition: 0.2s;
            text-decoration: none;
            font-weight: 500;
        }

            .nav-link:hover {
                background: var(--primary-soft);
                color: var(--primary);
            }

            .nav-link.active {
                background: var(--primary);
                color: white !important;
                box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
            }

        .nav-icon {
            width: 20px;
            font-size: 1.1rem;
        }

        /* Topbar */
        .topbar {
            height: 70px;
            background: white;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .search-box {
            background: #f1f5f9;
            border-radius: 10px;
            padding: 5px 15px;
            display: flex;
            align-items: center;
            width: 300px;
        }

            .search-box input {
                border: none;
                background: transparent;
                outline: none;
                padding-left: 10px;
                width: 100%;
                font-size: 0.9rem;
            }

        /* Action Buttons */
        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            position: relative;
            text-decoration: none;
        }

        .notif-dot {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 8px;
            height: 8px;
            background: #ef4444;
            border: 2px solid white;
            border-radius: 50%;
        }

        /* Responsive Mobile */
        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0;
            }

            .topbar {
                padding: 0 1rem;
            }
        }

        /* Footer Status */
        .sidebar-footer {
            padding: 1rem;
            border-top: 1px solid #f1f5f9;
        }

        .status-pill {
            background: #ecfdf5;
            color: #059669;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
        }

        .dot {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
        }
    </style>
</head>
<body>

    <div class="app-container">
        <aside class="sidebar" id="sidebar">
            <a class="sidebar-header" asp-controller="Home" asp-action="Index">
                <div class="logo-icon"><i class="fas fa-heartbeat"></i></div>
                <div class="logo-name">SmartHealth</div>
            </a>

            <div class="nav-list">
                <div class="nav-group-label">Tổng quan</div>
                <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-th-large nav-icon"></i> Dashboard
                </a>
                <a class="nav-link" href="#"><i class="fas fa-bell nav-icon"></i> Thông báo</a>

                <div class="nav-group-label">Quản lý</div>
                <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Users" ? "active" : "")" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="fas fa-user-shield nav-icon"></i> Người dùng & Roles
                </a>
                <a class="nav-link" href="#"><i class="fas fa-user-md nav-icon"></i> Bác sĩ</a>
                <a class="nav-link" href="#"><i class="fas fa-users nav-icon"></i> Bệnh nhân</a>
                <a class="nav-link" href="#"><i class="fas fa-lock nav-icon"></i> Tài khoản bị khóa</a>


                <div class="nav-group-label">Hệ thống</div>
                <a class="nav-link" href="#"><i class="fas fa-cog nav-icon"></i> Cấu hình</a>
            </div>

            <div class="sidebar-footer">
                <div class="status-pill">
                    <span class="dot"></span> Hệ thống ổn định
                </div>
            </div>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn d-lg-none" onclick="toggleSidebar()">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>

                <div class="topbar-actions">
                    <a href="#" class="icon-btn">
                        <i class="fas fa-bell"></i>
                        <span class="notif-dot"></span>
                    </a>
                    <a asp-action="Index" asp-controller="Home" asp-area="Admin" class="icon-btn"><i class="fas fa-home"></i></a>

                    <div class="d-flex align-items-center gap-2 ms-2">
                        <div class="text-end d-none d-sm-block">
                            <div class="fw-bold" style="font-size: 0.9rem;">Admin</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Quản trị viên</div>
                        </div>
                        <img src="https://ui-avatars.com/api/?name=Admin&background=4f46e5&color=fff" class="rounded-circle" width="40" height="40">
                    </div>
                </div>
            </header>

            <div class="p-4 p-lg-5">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>