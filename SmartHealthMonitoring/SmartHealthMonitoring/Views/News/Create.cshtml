@model SmartHealthMonitoring.Models.HealthNewsPost

@{
    ViewData["Title"] = "Tạo bài tin tức";
    Layout = "_AdminLayout";
    bool isEdit = Model.Id > 0;
}

<style>
    .create-news-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        border-radius: 16px;
        padding: 1.8rem 2.5rem;
        color: #fff;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }
    .create-news-header::before {
        content: '';
        position: absolute;
        width: 250px; height: 250px;
        background: radial-gradient(circle, rgba(26,115,200,0.3) 0%, transparent 70%);
        top: -70px; right: -60px;
        border-radius: 50%;
    }
    .ai-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.8rem;
        margin-top: 8px;
    }
    .form-card {
        border: none;
        border-radius: 14px;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
        overflow: hidden;
    }
    .form-card .card-header {
        background: #f8fafc;
        border-bottom: 1px solid #e0eaf4;
        padding: 1rem 1.5rem;
        font-weight: 700;
        color: #1a2340;
        font-size: 0.95rem;
    }
    .form-card .card-body { padding: 1.5rem; }
    .form-label {
        font-weight: 600;
        font-size: 0.88rem;
        color: #374151;
        margin-bottom: 6px;
    }
    .form-control, .form-select {
        border: 1.5px solid #e0eaf4;
        border-radius: 10px;
        font-size: 0.9rem;
        transition: border-color .2s, box-shadow .2s;
    }
    .form-control:focus, .form-select:focus {
        border-color: #1a73c8;
        box-shadow: 0 0 0 3px rgba(26,115,200,.1);
    }
    .content-editor {
        min-height: 380px;
        font-family: 'Segoe UI', monospace;
        font-size: 0.88rem;
    }
    .preview-panel {
        border: 2px dashed #c8d8e8;
        border-radius: 12px;
        padding: 1.5rem;
        background: #f8fbff;
        min-height: 200px;
    }
    .preview-panel h4 { color: #1a2340; font-weight: 700; font-size: 1.1rem; margin-bottom: 10px; }
    .preview-panel .preview-body { font-size: 0.88rem; color: #374151; line-height: 1.7; }
    .btn-publish {
        background: linear-gradient(135deg, #059669, #10b981);
        border: none; color: white;
        border-radius: 10px; padding: 10px 28px;
        font-weight: 700; font-size: 0.9rem;
        transition: all .2s;
        box-shadow: 0 4px 14px rgba(5,150,105,.3);
    }
    .btn-publish:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(5,150,105,.4); color: white; }
    .btn-draft {
        background: #f59e0b; border: none; color: white;
        border-radius: 10px; padding: 10px 28px;
        font-weight: 700; font-size: 0.9rem;
        transition: all .2s;
    }
    .btn-draft:hover { background: #d97706; color: white; }
    .char-count { font-size: 0.75rem; color: #8a9bb0; text-align: right; margin-top: 4px; }

    /* ── AI Panel ── */
    .ai-panel {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4c1d95 100%);
        border-radius: 16px;
        padding: 1.5rem 2rem;
        color: #fff;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }
    .ai-panel::before {
        content: '';
        position: absolute;
        width: 220px; height: 220px;
        background: radial-gradient(circle, rgba(167,139,250,.35) 0%, transparent 70%);
        top: -60px; right: -50px;
        border-radius: 50%;
        pointer-events: none;
    }
    .ai-panel-title {
        font-size: 1rem; font-weight: 700;
        display: flex; align-items: center; gap: 8px;
        margin-bottom: 1rem;
    }
    .ai-panel .form-label { color: rgba(255,255,255,.85); font-size: 0.83rem; font-weight: 600; }
    .ai-panel .form-control,
    .ai-panel .form-select {
        background: rgba(255,255,255,.12);
        border: 1.5px solid rgba(255,255,255,.25);
        color: #fff;
        border-radius: 10px;
    }
    .ai-panel .form-control::placeholder { color: rgba(255,255,255,.5); }
    .ai-panel .form-control:focus,
    .ai-panel .form-select:focus {
        background: rgba(255,255,255,.18);
        border-color: #a78bfa;
        box-shadow: 0 0 0 3px rgba(167,139,250,.25);
        color: #fff;
    }
    .ai-panel .form-select option { background: #312e81; color: #fff; }
    .btn-ai-generate {
        background: linear-gradient(135deg, #7c3aed, #a855f7);
        border: none; color: white;
        border-radius: 10px; padding: 10px 28px;
        font-weight: 700; font-size: 0.9rem;
        transition: all .2s;
        box-shadow: 0 4px 14px rgba(124,58,237,.4);
        white-space: nowrap;
    }
    .btn-ai-generate:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(124,58,237,.55); color: white; }
    .btn-ai-generate:disabled { opacity: .65; cursor: not-allowed; }
    .ai-success-badge {
        display: inline-flex; align-items: center; gap: 6px;
        background: rgba(52,211,153,.2); border: 1px solid rgba(52,211,153,.4);
        border-radius: 20px; padding: 4px 14px; font-size: 0.8rem;
        color: #6ee7b7; margin-top: 8px;
    }
</style>

<div class="create-news-header">
    <div style="position:relative;z-index:1;">
        <h4 class="mb-1 fw-bold">
            <i class="fas fa-@(isEdit ? "edit" : "plus-circle") me-2"></i>
            @(isEdit ? "Chỉnh sửa bài tin tức" : "Tạo bài tin tức mới")
        </h4>
        @if (!string.IsNullOrEmpty(Model.Source) && Model.Source != "Manual")
        {
            <div class="ai-indicator">
                <i class="fas fa-robot"></i>
                AI tạo từ @(Model.Source == "PatientStatistics" ? "Thống kê Lâm sàng" : "Thống kê Thói quen")
            </div>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success rounded-3 mb-3">@TempData["Success"]</div>
}

<!-- ═══════════════════════ AI PANEL ═══════════════════════ -->
<div class="ai-panel" id="aiPanel">
    <div style="position:relative;z-index:1;">
        <div class="ai-panel-title">
            <i class="fas fa-robot"></i>
            <span>✨ AI Viết Bài Tự Động</span>
        </div>
        <p style="font-size:0.82rem;opacity:.8;margin-bottom:1rem;">
            Chọn nguồn thống kê, nhập chủ đề và để AI tự động viết tiêu đề, tóm tắt và nội dung bài viết.
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label"><i class="fas fa-database me-1"></i>Nguồn dữ liệu</label>
                <select id="aiSource" class="form-select">
                    <option value="PatientStatistics">📊 Thống kê Lâm sàng (Nhân khẩu &amp; Triệu chứng)</option>
                    <option value="HabitStatistics">🏃 Thống kê Thói quen Hằng ngày</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label"><i class="fas fa-pen-fancy me-1"></i>Yêu cầu cho AI (tùy chọn)</label>
                <input type="text" id="aiPrompt" class="form-control"
                       placeholder="VD: top 5 thói quen xấu, chế độ ăn lành mạnh..." />
            </div>
            <div class="col-md-3">
                <button type="button" id="btnAiGenerate" class="btn btn-ai-generate w-100"
                        onclick="generateWithAI()">
                    <i class="fas fa-magic me-2"></i>AI viết bài
                </button>
            </div>
        </div>
        <!-- Loading & result badges -->
        <div id="aiStatus" class="mt-3" style="display:none;">
            <div id="aiLoading" style="display:none;">
                <div class="spinner-border spinner-border-sm text-warning me-2" role="status"></div>
                <span style="font-size:0.85rem;opacity:.9;">AI đang viết bài, vui lòng chᷗ...</span>
            </div>
            <div id="aiDone" style="display:none;">
                <span class="ai-success-badge">
                    <i class="fas fa-check-circle"></i> AI đã điền xong! Hãy kiểm tra và chỉnh sửa nội dung bên dưới.
                </span>
            </div>
            <div id="aiError" style="display:none;font-size:0.85rem;color:#fca5a5;"></div>
        </div>
    </div>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" id="newsForm" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="Source" value="@Model.Source" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger rounded-3 mb-3">
            <i class="fas fa-exclamation-circle me-2"></i>
            <div asp-validation-summary="All"></div>
        </div>
    }

    <div class="row g-4">
        <!-- Left column: form fields -->
        <div class="col-lg-8">
            <div class="card form-card mb-4">
                <div class="card-header"><i class="fas fa-pen me-2 text-primary"></i>Nội dung bài viết</div>
                <div class="card-body">
                    <!-- Title -->
                    <div class="mb-4">
                        <label class="form-label" for="Title">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input id="Title" name="Title" class="form-control"
                               value="@Model.Title"
                               placeholder="Nhập tiêu đề hấp dẫn, tối đa 120 ký tự..." maxlength="200"
                               oninput="updateCharCount('Title','titleCount',120)"
                               required />
                        <div class="char-count"><span id="titleCount">@(Model.Title?.Length ?? 0)</span>/120 ký tự</div>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Summary -->
                    <div class="mb-4">
                        <label class="form-label" for="Summary">Tóm tắt (hiển thị trên trang chủ) <span class="text-danger">*</span></label>
                        <textarea id="Summary" name="Summary" class="form-control" rows="3"
                                  placeholder="Tóm tắt ngắn gọn 2-3 câu, hiển thị dưới tiêu đề trên trang chủ..."
                                  maxlength="500"
                                  oninput="updateCharCount('Summary','summaryCount',300)">@Model.Summary</textarea>
                        <div class="char-count"><span id="summaryCount">@(Model.Summary?.Length ?? 0)</span>/300 ký tự</div>
                        <span asp-validation-for="Summary" class="text-danger small"></span>
                    </div>

                    <!-- Content -->
                    <div class="mb-3">
                        <label class="form-label" for="Content">Nội dung đầy đủ <span class="text-danger">*</span></label>
                        <textarea id="Content" name="Content" class="form-control">@Model.Content</textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right column: meta + actions -->
        <div class="col-lg-4">
            <div class="card form-card mb-4">
                <div class="card-header"><i class="fas fa-cog me-2 text-secondary"></i>Cài đặt</div>
                <div class="card-body">
                    <!-- Thumbnail Upload -->
                    <div class="mb-3">
                        <label class="form-label">Ảnh đại diện</label>
                        <input type="hidden" name="ThumbnailUrl" value="@Model.ThumbnailUrl" />
                        <input type="file" name="uploadImage" class="form-control" accept="image/*"
                               onchange="previewUpload(this)" />
                        <div class="mt-2 text-muted" style="font-size:0.8rem;">(Có thể tải ảnh lên từ máy tính)</div>
                        <div class="mt-2">
                            <img id="thumbPreview"
                                 src="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "/images/banner.jpg" : Model.ThumbnailUrl)"
                                 alt="Thumbnail preview"
                                 style="width:100%;height:140px;object-fit:cover;border-radius:10px;border:2px solid #e0eaf4;" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="card form-card">
                <div class="card-header"><i class="fas fa-paper-plane me-2 text-success"></i>Gửi duyệt</div>
                <div class="card-body">
                    <p class="text-muted" style="font-size:0.82rem;">
                        <i class="fas fa-info-circle me-1"></i>
                        Chọn <strong>Gửi duyệt</strong> để gửi yêu cầu đăng bài cho Quản trị viên, hoặc <strong>Lưu nháp</strong> để chỉnh sửa sau.
                    </p>
                    <div class="d-grid gap-2">
                        <button type="submit" name="action" value="publish" class="btn btn-publish">
                            <i class="fas fa-paper-plane me-2"></i>Gửi duyệt
                        </button>
                        <button type="submit" name="action" value="draft" class="btn btn-draft">
                            <i class="fas fa-save me-2"></i>Lưu nháp
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<!-- TinyMCE Rich Text Editor CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    // Khởi tạo TinyMCE
    tinymce.init({
        selector: '#Content',
        height: 500,
        menubar: false,
        plugins: [
            'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
            'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
            'insertdatetime', 'media', 'table', 'help', 'wordcount'
        ],
        toolbar: 'undo redo | blocks | ' +
            'bold italic forecolor | alignleft aligncenter ' +
            'alignright alignjustify | bullist numlist outdent indent | ' +
            'removeformat | help',
        content_style: 'body { font-family:Inter,sans-serif; font-size:14px }',
        setup: function (editor) {
            editor.on('change', function () {
                editor.save();
            });
        }
    });

    function updateCharCount(inputId, countId, max) {
        const val = document.getElementById(inputId).value.length;
        document.getElementById(countId).textContent = val;
        document.getElementById(countId).style.color = val > max ? '#dc3545' : '#8a9bb0';
    }

    function previewUpload(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('thumbPreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    document.getElementById('Title').addEventListener('input', function () {
        updateCharCount('Title', 'titleCount', 120);
    });
    document.getElementById('Summary').addEventListener('input', function () {
        updateCharCount('Summary', 'summaryCount', 300);
    });

    // Init char counts
    updateCharCount('Title', 'titleCount', 120);
    updateCharCount('Summary', 'summaryCount', 300);

    // ═══════════════════════════════════════
    // AI Generate AJAX
    // ═══════════════════════════════════════
    async function generateWithAI() {
        const source = document.getElementById('aiSource').value;
        const prompt = document.getElementById('aiPrompt').value.trim();
        const btn    = document.getElementById('btnAiGenerate');
        const status = document.getElementById('aiStatus');
        const loading = document.getElementById('aiLoading');
        const done    = document.getElementById('aiDone');
        const errDiv  = document.getElementById('aiError');

        btn.disabled = true;
        status.style.display = '';
        loading.style.display = '';
        done.style.display    = 'none';
        errDiv.style.display  = 'none';
        errDiv.textContent    = '';

        try {
            // Lấy CSRF token từ form
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const formData = new FormData();
            formData.append('source', source);
            formData.append('userPrompt', prompt);
            formData.append('__RequestVerificationToken', token);

            const resp = await fetch('@Url.Action("GenerateNewsAjax", "AdminNews")', {
                method: 'POST',
                body: formData
            });

            if (!resp.ok) throw new Error('Lỗi HTTP ' + resp.status);
            const data = await resp.json();

            if (!data.success) throw new Error(data.error || 'AI không trả về kết quả.');

            // Fill Title
            const titleEl = document.getElementById('Title');
            titleEl.value = data.title || '';
            updateCharCount('Title', 'titleCount', 120);

            // Fill Summary
            const summaryEl = document.getElementById('Summary');
            summaryEl.value = data.summary || '';
            updateCharCount('Summary', 'summaryCount', 300);

            // Fill Content vào TinyMCE
            if (tinymce.get('Content')) {
                tinymce.get('Content').setContent(data.content || '');
                tinymce.get('Content').save();
            } else {
                document.getElementById('Content').value = data.content || '';
            }

            // Cập nhật Source hidden field
            const sourceHidden = document.querySelector('input[name="Source"]');
            if (sourceHidden) sourceHidden.value = data.source || 'Manual';

            loading.style.display = 'none';
            done.style.display    = '';
            // Scroll xuống vùng nội dung
            document.getElementById('Title').scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err) {
            loading.style.display = 'none';
            errDiv.style.display  = '';
            errDiv.textContent    = '❌ ' + (err.message || 'Đã xảy ra lỗi.');
        } finally {
            btn.disabled = false;
        }
    }

    // Nếu mở trang qua nút "AI tạo tin tức" từ Index, tự scroll xuống AI panel
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('aiMode') === 'true') {
        document.getElementById('aiPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
</script>
}
