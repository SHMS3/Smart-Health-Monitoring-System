@model List<SmartHealthMonitoring.Models.DoctorWorkSchedule>
@{
    ViewData["Title"] = "Cấu hình Lịch làm việc";
    var days = new[] { "Chủ Nhật", "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7" };
    // Group schedules by DayOfWeek
    var scheduleMap = Model.GroupBy(s => s.DayOfWeek).ToDictionary(g => g.Key, g => g.ToList());
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    body { font-family: 'Inter', sans-serif; background: #f0f4f8; }
    .page-header {
        background: linear-gradient(135deg, #1e3a5f 0%, #2d6a9f 100%);
        color: white; border-radius: 20px; padding: 32px 40px; margin-bottom: 28px;
    }
    .schedule-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
    .day-card {
        background: white; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.06);
        overflow: hidden; transition: box-shadow .2s;
    }
    .day-card:hover { box-shadow: 0 8px 30px rgba(0,0,0,.12); }
    .day-header {
        padding: 16px 20px; font-weight: 600; font-size: .95rem;
        border-bottom: 1px solid #f0f4f8; display: flex; align-items: center; gap: 10px;
    }
    .day-header.active { background: linear-gradient(90deg,#e8f4fd,#f0f9ff); color: #1e3a5f; }
    .day-header.inactive { background: #f8fafc; color: #94a3b8; }
    .day-dot { width: 10px; height: 10px; border-radius: 50%; }
    .day-dot.active { background: #22c55e; }
    .day-dot.inactive { background: #cbd5e1; }
    .day-body { padding: 16px 20px; }
    .slot-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .slot-row input[type=time] {
        border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 6px 10px;
        font-size: .88rem; color: #334155; flex: 1; outline: none;
        transition: border-color .2s;
    }
    .slot-row input[type=time]:focus { border-color: #2d6a9f; }
    .btn-add-slot {
        display: flex; align-items: center; gap: 6px;
        background: none; border: 1.5px dashed #94a3b8; border-radius: 8px;
        padding: 8px 14px; font-size: .83rem; color: #64748b; cursor: pointer;
        width: 100%; justify-content: center; margin-top: 6px; transition: all .2s;
    }
    .btn-add-slot:hover { border-color: #2d6a9f; color: #2d6a9f; background: #f0f9ff; }
    .btn-remove { background: none; border: none; color: #ef4444; cursor: pointer; font-size: 1.1rem; padding: 2px 6px; border-radius: 6px; }
    .btn-remove:hover { background: #fef2f2; }
    .toggle-switch { position: relative; display: inline-block; width: 44px; height: 24px; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider {
        position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
        background: #cbd5e1; transition: .3s; border-radius: 24px;
    }
    .toggle-slider:before {
        position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px;
        background: white; transition: .3s; border-radius: 50%;
    }
    input:checked + .toggle-slider { background: #22c55e; }
    input:checked + .toggle-slider:before { transform: translateX(20px); }
    .save-bar {
        position: sticky; bottom: 20px; background: white; border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0,0,0,.15); padding: 16px 28px;
        display: flex; justify-content: flex-end; gap: 12px; margin-top: 28px;
    }
    .btn-save {
        background: linear-gradient(135deg, #1e3a5f, #2d6a9f); color: white;
        border: none; border-radius: 10px; padding: 10px 28px; font-weight: 600; cursor: pointer; transition: opacity .2s;
    }
    .btn-save:hover { opacity: .9; }
</style>

<div class="container pt-5 mt-3 pb-5">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-1 fw-bold">📅 Cấu hình Lịch làm việc</h1>
                <p class="mb-0 opacity-75">Thiết lập khung giờ khám hàng tuần. Hệ thống sẽ tự động sinh slot 14 ngày tới.</p>
            </div>
            <a asp-action="Index" asp-controller="DoctorDashboard" class="btn btn-light btn-sm">
                ← Về Dashboard
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 border-0 shadow-sm mb-4">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <!-- Block Time Form -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-3 text-warning"><i class="fas fa-ban me-2"></i>Block thời gian nghỉ</h6>
            <form asp-action="BlockTime" method="post" class="d-flex gap-3 align-items-end flex-wrap">
                @Html.AntiForgeryToken()
                <div>
                    <label class="form-label small text-muted">Từ</label>
                    <input type="datetime-local" name="blockStart" class="form-control rounded-3" required>
                </div>
                <div>
                    <label class="form-label small text-muted">Đến</label>
                    <input type="datetime-local" name="blockEnd" class="form-control rounded-3" required>
                </div>
                <button type="submit" class="btn btn-warning fw-semibold rounded-3">
                    <i class="fas fa-lock me-2"></i>Block giờ này
                </button>
            </form>
        </div>
    </div>

    <!-- Lịch 7 ngày -->
    <div class="schedule-grid" id="scheduleGrid">
        @for (byte dow = 0; dow <= 6; dow++)
        {
            var daySchedules = scheduleMap.ContainsKey(dow) ? scheduleMap[dow] : new List<SmartHealthMonitoring.Models.DoctorWorkSchedule>();
            var isActive = daySchedules.Any();
            <div class="day-card" data-dow="@dow">
                <div class="day-header @(isActive ? "active" : "inactive")">
                    <div class="day-dot @(isActive ? "active" : "inactive")"></div>
                    <span>@days[dow]</span>
                    <label class="toggle-switch ms-auto">
                        <input type="checkbox" class="day-toggle" data-dow="@dow" @(isActive ? "checked" : "")>
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="day-body slot-container" id="slots-@dow">
                    @if (daySchedules.Any())
                    {
                        foreach (var s in daySchedules)
                        {
                            <div class="slot-row">
                                <input type="time" name="startTime" value="@s.StartTime.ToString("HH:mm")" placeholder="Từ">
                                <span class="text-muted">→</span>
                                <input type="time" name="endTime" value="@s.EndTime.ToString("HH:mm")" placeholder="Đến">
                                <button type="button" class="btn-remove" onclick="this.closest('.slot-row').remove()">×</button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small text-center py-2 mb-0">Ngày nghỉ</p>
                    }
                </div>
                <div class="px-4 pb-3">
                    <button type="button" class="btn-add-slot" onclick="addSlot(@dow)">
                        <i class="fas fa-plus"></i> Thêm ca
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Save Bar -->
    <div class="save-bar">
        <span class="text-muted small align-self-center me-auto">💡 Mỗi ca là một khung giờ làm việc. Hệ thống sẽ sinh slot 30 phút/lần.</span>
        <button type="button" class="btn-save" onclick="saveSchedule()">
            <i class="fas fa-save me-2"></i>Lưu lịch làm việc
        </button>
    </div>
</div>

@section Scripts {
<script>
function addSlot(dow) {
    const container = document.getElementById(`slots-${dow}`);
    // Remove "Ngày nghỉ" placeholder if present
    const placeholder = container.querySelector('p');
    if (placeholder) placeholder.remove();

    const row = document.createElement('div');
    row.className = 'slot-row';
    row.innerHTML = `
        <input type="time" name="startTime" value="08:00" placeholder="Từ">
        <span class="text-muted">→</span>
        <input type="time" name="endTime" value="12:00" placeholder="Đến">
        <button type="button" class="btn-remove" onclick="this.closest('.slot-row').remove()">×</button>
    `;
    container.appendChild(row);
}

async function saveSchedule() {
    const payload = [];

    document.querySelectorAll('.day-card').forEach(card => {
        const dow      = parseInt(card.dataset.dow);
        const isActive = card.querySelector('.day-toggle').checked;
        if (!isActive) return;

        card.querySelectorAll('.slot-row').forEach(row => {
            const start = row.querySelector('[name=startTime]').value;
            const end   = row.querySelector('[name=endTime]').value;
            if (start && end) {
                payload.push({ dayOfWeek: dow, startTime: start, endTime: end, slotDurationMinutes: 30 });
            }
        });
    });

    const token = document.querySelector('input[name=__RequestVerificationToken]')?.value
               ?? '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] ?? '';

    const res = await fetch('/DoctorSchedule/Save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify(payload)
    });

    if (res.ok) {
        Swal.fire({ icon: 'success', title: 'Đã lưu!', text: 'Slot sẽ được sinh tự động ngay.', timer: 2000, showConfirmButton: false });
    } else {
        Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không thể lưu lịch. Vui lòng thử lại.' });
    }
}
</script>
}
