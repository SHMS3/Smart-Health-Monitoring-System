@model SmartHealthMonitoring.ViewModels.Admin.AdminSettingsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cài đặt Admin";
    var initials = string.Join("", (Model.Profile.FullName ?? "A")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .TakeLast(2)
        .Select(word => word[0].ToString().ToUpper()));
    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "A";
    }
    var securityActive = Model.ActiveSection == "security";
    var profileActive = !securityActive;
}

@section Styles {
    <style>
        .settings-shell {
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(320px, .8fr);
            gap: 24px;
            align-items: start;
        }

        .settings-hero {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
        }

        .settings-identity {
            display: flex;
            align-items: center;
            gap: 16px;
            min-width: 0;
        }

        .settings-avatar {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            background: #e0f2fe;
            color: #0369a1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: 'Outfit', sans-serif;
            font-size: 1.35rem;
            font-weight: 800;
            flex-shrink: 0;
        }

        .settings-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.6rem;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
        }

        .settings-subtitle {
            color: #64748b;
            margin: 4px 0 0;
            font-size: .92rem;
        }

        .settings-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border-radius: 999px;
            padding: 8px 13px;
            font-size: .8rem;
            font-weight: 700;
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #bbf7d0;
            white-space: nowrap;
        }

        .settings-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .05);
            overflow: hidden;
        }

        .settings-card + .settings-card {
            margin-top: 24px;
        }

        .settings-card.highlight {
            border-color: #93c5fd;
            box-shadow: 0 12px 32px rgba(14, 165, 233, .12);
        }

        .settings-card-header {
            padding: 20px 24px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .settings-card-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: #2563eb;
            flex-shrink: 0;
        }

        .settings-card-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.05rem;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
        }

        .settings-card-body {
            padding: 24px;
        }

        .settings-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .settings-field label {
            display: block;
            font-size: .78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #64748b;
            margin-bottom: 7px;
        }

        .settings-input {
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 11px 13px;
            color: #0f172a;
            background: #f8fafc;
        }

        .settings-input:focus {
            border-color: #0ea5e9;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(14, 165, 233, .12);
        }

        .field-validation-error,
        .validation-summary-errors {
            color: #dc2626;
            font-size: .78rem;
            font-weight: 600;
        }

        .settings-actions {
            margin-top: 22px;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        .settings-primary-btn {
            border: 0;
            border-radius: 12px;
            background: #0ea5e9;
            color: #fff;
            font-weight: 800;
            padding: 10px 18px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 8px 18px rgba(14, 165, 233, .24);
        }

        .settings-primary-btn:hover {
            background: #0284c7;
            color: #fff;
        }

        .settings-danger-btn {
            background: #ef4444;
            box-shadow: 0 8px 18px rgba(239, 68, 68, .20);
        }

        .settings-danger-btn:hover {
            background: #dc2626;
        }

        .settings-meta-list {
            display: grid;
            gap: 12px;
        }

        .settings-meta-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 13px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .settings-meta-item:last-child {
            border-bottom: 0;
        }

        .settings-meta-label {
            color: #64748b;
            font-size: .82rem;
            font-weight: 700;
        }

        .settings-meta-value {
            color: #0f172a;
            font-weight: 800;
            text-align: right;
        }

        .settings-link-list {
            display: grid;
            gap: 10px;
        }

        .settings-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            color: #0f172a;
            text-decoration: none;
            transition: all .18s ease;
        }

        .settings-link:hover {
            border-color: #bae6fd;
            background: #f0f9ff;
            color: #0369a1;
        }

        .settings-link i:first-child {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: #f1f5f9;
            color: #0f172a;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .settings-link span {
            flex: 1;
            font-weight: 800;
            font-size: .9rem;
        }

        .settings-note {
            display: flex;
            gap: 12px;
            padding: 14px;
            border-radius: 12px;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
            font-size: .86rem;
            font-weight: 600;
        }

        @@media (max-width: 992px) {
            .settings-shell {
                grid-template-columns: 1fr;
            }

            .settings-hero {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @@media (max-width: 640px) {
            .settings-form-grid {
                grid-template-columns: 1fr;
            }

            .settings-actions {
                justify-content: stretch;
            }

            .settings-primary-btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
}

<div class="settings-hero">
    <div class="settings-identity">
        <div class="settings-avatar">@initials</div>
        <div class="min-w-0">
            <h1 class="settings-title">Cài đặt Admin</h1>
            <p class="settings-subtitle">@Model.Profile.FullName • @Model.Profile.Email</p>
        </div>
    </div>
    <span class="settings-pill">
        <i class="fas fa-user-shield"></i>
        Quản trị viên
    </span>
</div>

<div class="settings-shell">
    <div>
        <div class="settings-card @(profileActive ? "highlight" : "")">
            <div class="settings-card-header">
                <div class="settings-card-icon">
                    <i class="fas fa-id-card"></i>
                </div>
                <h2 class="settings-card-title">Hồ sơ tài khoản</h2>
            </div>
            <div class="settings-card-body">
                <form asp-controller="AdminSettings" asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Profile.UserId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="mb-3"></div>

                    <div class="settings-form-grid">
                        <div class="settings-field">
                            <label asp-for="Profile.FullName">Họ và tên</label>
                            <input asp-for="Profile.FullName" class="form-control settings-input" autocomplete="name" />
                            <span asp-validation-for="Profile.FullName"></span>
                        </div>

                        <div class="settings-field">
                            <label asp-for="Profile.Email">Email đăng nhập</label>
                            <input asp-for="Profile.Email" class="form-control settings-input" autocomplete="email" />
                            <span asp-validation-for="Profile.Email"></span>
                        </div>
                    </div>

                    <div class="settings-actions">
                        <button type="submit" class="settings-primary-btn">
                            <i class="fas fa-save"></i>
                            Lưu hồ sơ
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="settings-card @(securityActive ? "highlight" : "")">
            <div class="settings-card-header">
                <div class="settings-card-icon" style="background:#fef2f2;color:#dc2626;">
                    <i class="fas fa-lock"></i>
                </div>
                <h2 class="settings-card-title">Bảo mật</h2>
            </div>
            <div class="settings-card-body">
                @if (Model.IsGoogleAccount)
                {
                    <div class="settings-note">
                        <i class="fab fa-google"></i>
                        <span>Tài khoản này đang xác thực bằng Google.</span>
                    </div>
                }
                else
                {
                    <form asp-controller="AdminSettings" asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="mb-3"></div>

                        <div class="settings-form-grid">
                            <div class="settings-field">
                                <label asp-for="Password.CurrentPassword">Mật khẩu hiện tại</label>
                                <input asp-for="Password.CurrentPassword" class="form-control settings-input" autocomplete="current-password" />
                                <span asp-validation-for="Password.CurrentPassword"></span>
                            </div>

                            <div class="settings-field">
                                <label asp-for="Password.NewPassword">Mật khẩu mới</label>
                                <input asp-for="Password.NewPassword" class="form-control settings-input" autocomplete="new-password" />
                                <span asp-validation-for="Password.NewPassword"></span>
                            </div>

                            <div class="settings-field">
                                <label asp-for="Password.ConfirmNewPassword">Xác nhận mật khẩu</label>
                                <input asp-for="Password.ConfirmNewPassword" class="form-control settings-input" autocomplete="new-password" />
                                <span asp-validation-for="Password.ConfirmNewPassword"></span>
                            </div>
                        </div>

                        <div class="settings-actions">
                            <button type="submit" class="settings-primary-btn settings-danger-btn">
                                <i class="fas fa-key"></i>
                                Đổi mật khẩu
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <aside>
        <div class="settings-card">
            <div class="settings-card-header">
                <div class="settings-card-icon" style="background:#ecfdf5;color:#047857;">
                    <i class="fas fa-shield-halved"></i>
                </div>
                <h2 class="settings-card-title">Trạng thái</h2>
            </div>
            <div class="settings-card-body">
                <div class="settings-meta-list">
                    <div class="settings-meta-item">
                        <span class="settings-meta-label">Vai trò</span>
                        <span class="settings-meta-value">Admin</span>
                    </div>
                    <div class="settings-meta-item">
                        <span class="settings-meta-label">Ngày tạo</span>
                        <span class="settings-meta-value">@Model.Profile.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="settings-meta-item">
                        <span class="settings-meta-label">Kiểu đăng nhập</span>
                        <span class="settings-meta-value">@(Model.IsGoogleAccount ? "Google" : "Email")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="settings-card">
            <div class="settings-card-header">
                <div class="settings-card-icon" style="background:#fff7ed;color:#c2410c;">
                    <i class="fas fa-screwdriver-wrench"></i>
                </div>
                <h2 class="settings-card-title">Cài đặt nhanh</h2>
            </div>
            <div class="settings-card-body">
                <div class="settings-link-list">
                    <a asp-controller="StandardThreshold" asp-action="Index" class="settings-link">
                        <i class="fas fa-sliders-h"></i>
                        <span>Ngưỡng chuẩn y tế</span>
                        <i class="fas fa-chevron-right"></i>
                    </a>
                    <a asp-controller="AdminEmailTemplate" asp-action="Index" class="settings-link">
                        <i class="fas fa-envelope-open-text"></i>
                        <span>Mẫu Email</span>
                        <i class="fas fa-chevron-right"></i>
                    </a>
                    <a asp-controller="AdminAuditLog" asp-action="Index" class="settings-link">
                        <i class="fas fa-clipboard-check"></i>
                        <span>Nhật ký hoạt động</span>
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
