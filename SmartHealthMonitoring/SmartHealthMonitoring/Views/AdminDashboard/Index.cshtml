@model SmartHealthMonitoring.ViewModels.Admin.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard Tổng quan";
}

<h3 class="fw-bold mb-4 text-dark">Bảng Điều Khiển</h3>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
            <div class="text-primary mb-2"><i class="fas fa-user-md fa-2x"></i></div>
            <h2 class="fw-bold text-dark mb-0">@Model.TotalDoctors</h2>
            <p class="text-muted small mb-0">Bác sĩ hoạt động</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
            <div class="text-success mb-2"><i class="fas fa-users fa-2x"></i></div>
            <h2 class="fw-bold text-dark mb-0">@Model.TotalPatients</h2>
            <p class="text-muted small mb-0">Bệnh nhân</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
            <div class="text-info mb-2"><i class="fas fa-notes-medical fa-2x"></i></div>
            <h2 class="fw-bold text-dark mb-0">@Model.TotalClinicalRecords</h2>
            <p class="text-muted small mb-0">Hồ sơ Cận lâm sàng</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-danger bg-opacity-10">
            <div class="text-danger mb-2"><i class="fas fa-flag fa-2x"></i></div>
            <h2 class="fw-bold text-danger mb-0">@Model.TotalPendingAlerts</h2>
            <p class="text-danger small mb-0 fw-medium">Cảnh báo Tồn đọng</p>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-bottom p-4">
        <h6 class="fw-bold mb-0"><i class="fas fa-bell text-warning me-2"></i> Cảnh báo Cờ đỏ Mới nhất (Top 5)</h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted small">
                <tr>
                    <th class="ps-4">Tên Bệnh nhân</th>
                    <th>Mức độ</th>
                    <th class="text-end pe-4">Thời gian quét (FlaggedAt)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.RecentAlerts)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-dark">@item.PatientName</td>
                        <td><span class="badge bg-danger rounded-pill px-3">@item.WarningLevel</span></td>
                        <td class="text-end pe-4 text-muted small">@item.FlaggedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>