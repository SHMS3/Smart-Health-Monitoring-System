@model List<SmartHealthMonitoring.Models.HealthNewsPost>

@{
    ViewData["Title"] = "Quản lý Tin tức";
    Layout = "_AdminLayout";
    string currentStatus = ViewBag.CurrentStatus ?? "all";
}

<style>
    .news-admin-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        border-radius: 16px;
        padding: 2rem 2.5rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
    }
    .news-admin-header::before {
        content: '';
        position: absolute;
        width: 280px; height: 280px;
        background: radial-gradient(circle, rgba(26,115,200,0.3) 0%, transparent 70%);
        top: -80px; right: -60px;
        border-radius: 50%;
    }
    .news-status-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }
    .status-tab {
        padding: 7px 18px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        border: 2px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all .2s;
    }
    .status-tab.all        { border-color: #6c757d; color: #6c757d; }
    .status-tab.all.active { background: #6c757d; color: white; }
    .status-tab.published        { border-color: #198754; color: #198754; }
    .status-tab.published.active { background: #198754; color: white; }
    .status-tab.draft        { border-color: #ffc107; color: #856404; }
    .status-tab.draft.active { background: #ffc107; color: #000; }
    .status-tab.hidden        { border-color: #dc3545; color: #dc3545; }
    .status-tab.hidden.active { background: #dc3545; color: white; }

    .news-table-card {
        border: none;
        border-radius: 14px;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
        overflow: hidden;
    }
    .news-table thead {
        background: linear-gradient(135deg, #1565c0, #1a73c8);
        color: white;
    }
    .news-table thead th { font-weight: 600; font-size: 0.85rem; padding: 14px 16px; border: none; }
    .news-table tbody td { padding: 14px 16px; vertical-align: middle; font-size: 0.88rem; }
    .news-table tbody tr { transition: background .15s; }
    .news-table tbody tr:hover { background: #f0f7ff; }

    .badge-status-published { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .badge-status-draft     { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
    .badge-status-hidden    { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

    .news-thumb-sm {
        width: 70px; height: 50px;
        object-fit: cover;
        border-radius: 8px;
    }
    .news-title-cell {
        max-width: 280px;
    }
    .news-title-text {
        font-weight: 600; color: #1a2340;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .source-badge {
        display: inline-block;
        font-size: 0.72rem; font-weight: 600;
        padding: 2px 8px; border-radius: 10px;
        margin-top: 4px;
    }
    .source-patient  { background: #dbeafe; color: #1e40af; }
    .source-habit    { background: #fce7f3; color: #9d174d; }
    .source-manual   { background: #f3f4f6; color: #374151; }
    .action-btn-group { display: flex; gap: 6px; flex-wrap: nowrap; }
</style>

<div class="news-admin-header">
    <div style="position:relative;z-index:1;">
        <h4 class="mb-1 fw-bold"><i class="fas fa-newspaper me-2"></i>Quản lý Tin tức Sức khỏe</h4>
        <p class="mb-0 opacity-75" style="font-size:0.9rem;">Xem, đăng, ẩn và chỉnh sửa các bài tin tức sức khỏe cho bệnh nhân.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="news-status-tabs mb-0">
        <a href="@Url.Action("Index")" class="status-tab all @(currentStatus == "all" ? "active" : "")">
            <i class="fas fa-list me-1"></i>Tất cả
        </a>
        <a href="@Url.Action("Index", new { status = "Published" })" class="status-tab published @(currentStatus == "Published" ? "active" : "")">
            <i class="fas fa-check-circle me-1"></i>Đã đăng
        </a>
        <a href="@Url.Action("Index", new { status = "Pending" })" class="status-tab text-warning @(currentStatus == "Pending" ? "active" : "")">
            <i class="fas fa-clock me-1"></i>Chờ duyệt
        </a>
        <a href="@Url.Action("Index", new { status = "Draft" })" class="status-tab draft @(currentStatus == "Draft" ? "active" : "")">
            <i class="fas fa-pencil-alt me-1"></i>Nháp
        </a>
        <a href="@Url.Action("Index", new { status = "Hidden" })" class="status-tab hidden @(currentStatus == "Hidden" ? "active" : "")">
            <i class="fas fa-eye-slash me-1"></i>Đã ẩn
        </a>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-aiMode="true" class="btn rounded-pill px-4 fw-bold"
           style="background:linear-gradient(135deg,#7c3aed,#a855f7);border:none;color:white;box-shadow:0 4px 14px rgba(124,58,237,.35);">
            <i class=" fas fa-paper-plane"></i> Tạo tin tức
        </a>
    </div>
</div>

<div class="card news-table-card">
    <div class="table-responsive">
        <table class="table news-table mb-0">
            <thead>
                <tr>
                    <th style="width:80px;">Ảnh</th>
                    <th>Tiêu đề</th>
                    <th>Nguồn</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Tác giả</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-newspaper fa-3x mb-3 d-block opacity-25"></i>
                            Chưa có bài tin tức nào. Hãy tạo bài mới hoặc dùng AI để tạo từ thống kê!
                        </td>
                    </tr>
                }
                @foreach (var post in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(post.ThumbnailUrl))
                            {
                                <img src="@post.ThumbnailUrl" class="news-thumb-sm" alt="thumb" />
                            }
                            else
                            {
                                <div class="news-thumb-sm d-flex align-items-center justify-content-center"
                                     style="background:#e8f4fd;border-radius:8px;">
                                    <i class="fas fa-newspaper text-primary"></i>
                                </div>
                            }
                        </td>
                        <td class="news-title-cell">
                            <div class="news-title-text">@post.Title</div>
                        </td>
                        <td>
                            @{
                                var srcClass = post.Source switch {
                                    "PatientStatistics" => "source-patient",
                                    "HabitStatistics"   => "source-habit",
                                    _ => "source-manual"
                                };
                                var srcLabel = post.Source switch {
                                    "PatientStatistics" => "📊 Lâm sàng",
                                    "HabitStatistics"   => "🏃 Thói quen",
                                    _ => "✏️ Thủ công"
                                };
                            }
                            <span class="source-badge @srcClass">@srcLabel</span>
                        </td>
                        <td>
                            @{
                                var badgeClass = post.Status switch {
                                    "Published" => "badge-status-published",
                                    "Draft"     => "badge-status-draft",
                                    "Hidden"    => "badge-status-hidden",
                                    "Pending"   => "bg-warning text-dark",
                                    _ => "badge-status-draft"
                                };
                                var statusLabel = post.Status switch {
                                    "Published" => "✅ Đã đăng",
                                    "Draft"     => "📝 Nháp",
                                    "Hidden"    => "👁️ Đã ẩn",
                                    "Pending"   => "⏳ Chờ duyệt",
                                    _ => post.Status
                                };
                            }
                            <span class="badge rounded-pill @badgeClass px-3 py-2">@statusLabel</span>
                            @if(post.Status == "Draft" && !string.IsNullOrEmpty(post.RejectionReason))
                            {
                                <i class="fas fa-exclamation-circle text-danger ms-2" title="Bị từ chối: @post.RejectionReason"></i>
                            }
                        </td>
                        <td style="white-space:nowrap;">
                            <i class="fas fa-calendar-alt text-muted me-1"></i>
                            @post.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            <small class="text-muted">@post.AuthorName</small>
                        </td>
                        <td>
                            <div class="action-btn-group justify-content-center">
                                @if ((post.Status == "Draft" || post.Status == "Pending") && post.AuthorName == ViewBag.CurrentAuthor)
                                {
                                    <a asp-action="Edit" asp-route-id="@post.Id"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                       title="Chỉnh sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@post.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                title="Xóa"
                                                onclick="return confirm('Bạn có chắc muốn xóa bài viết này?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
