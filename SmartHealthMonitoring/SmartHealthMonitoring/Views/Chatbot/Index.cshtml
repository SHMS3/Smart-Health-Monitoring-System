@{
    ViewData["Title"] = "Trợ lý sức khỏe AI";
    var fullName = User.FindFirst("FullName")?.Value ?? "bạn";
}

@section Styles {
<style>
    /* CSS Variables fallback (main _Layout doesn't define these) */
    :root {
        --text: #0f172a;
        --text-sub: #475569;
        --text-muted: #94a3b8;
        --bg-soft: #f8fafc;
        --border: #e2e8f0;
        --danger: #ef4444;
    }

    /* ══════════════════════════════════════════════
       AI CHATBOT — Premium UI
       ══════════════════════════════════════════════ */


    .chatbot-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 24px 32px;
        height: calc(100vh - 90px - 40px);
        display: flex;
        flex-direction: column;
    }

    .chatbot-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
    }

    .chatbot-header .icon-box {
        width: 48px; height: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, #10b981, #06b6d4);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 14px rgba(16,185,129,.3);
        flex-shrink: 0;
    }

    .chatbot-header .icon-box i { color: #fff; font-size: 20px; }

    .chatbot-header h1 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.4rem; font-weight: 800;
        background: linear-gradient(135deg, #10b981, #06b6d4);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text; margin: 0;
    }

    .chatbot-header .subtitle {
        font-size: .8rem; color: var(--text-muted); margin-top: -2px;
    }

    /* ── CHAT CONTAINER ── */
    .chatbot-container {
        flex: 1; display: flex; flex-direction: column;
        background: #fff; border-radius: 20px;
        border: 1px solid var(--border); overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,.06);
        min-height: 0;
    }

    /* ── MESSAGES ── */
    .chatbot-messages {
        flex: 1; overflow-y: auto; padding: 24px;
        display: flex; flex-direction: column; gap: 6px;
        background: linear-gradient(180deg, #f0fdf4 0%, #fff 100%);
    }

    .chatbot-messages::-webkit-scrollbar { width: 4px; }
    .chatbot-messages::-webkit-scrollbar-thumb { background: rgba(16,185,129,.2); border-radius: 2px; }

    /* Message rows */
    .cb-msg-row {
        display: flex; align-items: flex-end; gap: 10px;
        max-width: 75%;
        animation: cbMsgIn .3s ease-out;
    }

    .cb-msg-row.user { align-self: flex-end; flex-direction: row-reverse; }
    .cb-msg-row.ai { align-self: flex-start; }

    .cb-msg-avatar {
        width: 32px; height: 32px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: .7rem; color: #fff; flex-shrink: 0; font-weight: 700;
    }

    .cb-msg-row.ai .cb-msg-avatar {
        background: linear-gradient(135deg, #10b981, #06b6d4);
    }

    .cb-msg-row.user .cb-msg-avatar {
        background: linear-gradient(135deg, #0ea5e9, #6366f1);
    }

    .cb-msg-bubble {
        padding: 12px 16px; border-radius: 16px;
        font-size: .88rem; line-height: 1.6;
        word-wrap: break-word; max-width: 100%;
    }

    .cb-msg-row.user .cb-msg-bubble {
        background: linear-gradient(135deg, #0ea5e9, #6366f1);
        color: #fff; border-bottom-right-radius: 4px;
    }

    .cb-msg-row.ai .cb-msg-bubble {
        background: #f1f5f9; color: var(--text);
        border-bottom-left-radius: 4px;
        border: 1px solid var(--border);
    }

    .cb-msg-time {
        font-size: .65rem; margin-top: 4px; opacity: .7;
    }

    .cb-msg-row.user .cb-msg-time { text-align: right; color: rgba(255,255,255,.7); }
    .cb-msg-row.ai .cb-msg-time { text-align: left; color: var(--text-muted); }

    /* AI typing indicator */
    .cb-typing {
        display: flex; align-items: center; gap: 10px;
        align-self: flex-start; padding: 8px 0;
        animation: cbMsgIn .3s ease-out;
    }

    .cb-typing .cb-msg-avatar {
        width: 32px; height: 32px; border-radius: 10px;
        background: linear-gradient(135deg, #10b981, #06b6d4);
        display: flex; align-items: center; justify-content: center;
    }

    .cb-typing-dots {
        display: flex; gap: 4px;
        background: #f1f5f9; padding: 12px 18px;
        border-radius: 16px; border-bottom-left-radius: 4px;
        border: 1px solid var(--border);
    }

    .cb-typing-dots span {
        width: 8px; height: 8px; border-radius: 50%;
        background: #94a3b8; animation: cbDotBounce 1.4s infinite;
    }

    .cb-typing-dots span:nth-child(2) { animation-delay: .2s; }
    .cb-typing-dots span:nth-child(3) { animation-delay: .4s; }

    /* ── INPUT AREA ── */
    .chatbot-input-area {
        padding: 16px 24px; border-top: 1px solid var(--border);
        background: #fff; display: flex; align-items: center; gap: 12px;
    }

    .chatbot-input-area input {
        flex: 1; padding: 12px 18px;
        border: 1.5px solid var(--border); border-radius: 12px;
        font-size: .9rem; color: var(--text); outline: none;
        transition: border-color .2s, box-shadow .2s;
        background: var(--bg-soft);
    }

    .chatbot-input-area input:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16,185,129,.1);
        background: #fff;
    }

    .chatbot-input-area input:disabled {
        opacity: .6; cursor: not-allowed;
    }

    .chatbot-input-area input::placeholder { color: var(--text-muted); }

    .cb-btn-send {
        width: 46px; height: 46px; border-radius: 12px;
        border: none; background: linear-gradient(135deg, #10b981, #06b6d4);
        color: #fff; font-size: 1rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all .2s;
        box-shadow: 0 4px 14px rgba(16,185,129,.3);
        flex-shrink: 0;
    }

    .cb-btn-send:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(16,185,129,.4); }
    .cb-btn-send:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }

    /* ══════════════════════════════════════════════
       FEEDBACK WIDGET
       ══════════════════════════════════════════════ */

    .cb-feedback {
        display: flex; align-items: center; gap: 10px;
        align-self: flex-start;
        animation: cbFeedbackIn .4s ease-out;
        max-width: 85%;
    }

    .cb-feedback-card {
        background: linear-gradient(135deg, rgba(16,185,129,.06), rgba(6,182,212,.06));
        border: 1.5px solid rgba(16,185,129,.2);
        border-radius: 16px; padding: 14px 18px;
        display: flex; flex-direction: column; gap: 10px;
    }

    .cb-feedback-question {
        font-size: .85rem; font-weight: 600; color: var(--text);
        display: flex; align-items: center; gap: 8px;
    }

    .cb-feedback-question i {
        color: #10b981; font-size: 1rem;
    }

    .cb-feedback-actions {
        display: flex; gap: 8px;
    }

    .cb-feedback-btn {
        display: flex; align-items: center; gap: 6px;
        padding: 8px 18px; border-radius: 10px;
        border: 1.5px solid var(--border); background: #fff;
        font-size: .82rem; font-weight: 600; cursor: pointer;
        transition: all .2s;
    }

    .cb-feedback-btn i { font-size: 1rem; }

    .cb-feedback-btn.like {
        color: #10b981;
    }
    .cb-feedback-btn.like:hover {
        background: rgba(16,185,129,.1); border-color: #10b981;
        transform: translateY(-1px);
    }

    .cb-feedback-btn.dislike {
        color: #ef4444;
    }
    .cb-feedback-btn.dislike:hover {
        background: rgba(239,68,68,.08); border-color: #ef4444;
        transform: translateY(-1px);
    }

    /* Feedback: Thank you state */
    .cb-feedback-thanks {
        display: flex; align-items: center; gap: 8px;
        font-size: .82rem; font-weight: 600; color: #10b981;
        padding: 8px 16px;
        background: rgba(16,185,129,.08); border-radius: 10px;
    }

    /* Feedback: Contact doctor CTA */
    .cb-contact-doctor {
        animation: cbFeedbackIn .4s ease-out;
        align-self: flex-start;
        max-width: 85%;
    }

    .cb-contact-card {
        background: linear-gradient(135deg, rgba(99,102,241,.06), rgba(14,165,233,.06));
        border: 1.5px solid rgba(99,102,241,.2);
        border-radius: 16px; padding: 16px 20px;
        display: flex; flex-direction: column; gap: 12px;
    }

    .cb-contact-card .cb-contact-text {
        font-size: .85rem; color: var(--text); line-height: 1.5;
    }

    .cb-contact-card .cb-contact-text i {
        color: #6366f1; margin-right: 6px;
    }

    .cb-btn-contact-doctor {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 22px; border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #6366f1, #0ea5e9);
        color: #fff; font-size: .85rem; font-weight: 700;
        cursor: pointer; transition: all .3s;
        box-shadow: 0 4px 14px rgba(99,102,241,.3);
        align-self: flex-start;
    }

    .cb-btn-contact-doctor:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(99,102,241,.45);
    }

    .cb-btn-skip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 16px; border-radius: 8px;
        border: 1.5px solid var(--border); background: #fff;
        color: var(--text-muted); font-size: .8rem; font-weight: 600;
        cursor: pointer; transition: all .2s;
        align-self: flex-start;
    }

    .cb-btn-skip:hover {
        border-color: var(--text-muted); color: var(--text);
    }

    .cb-contact-actions {
        display: flex; gap: 10px; align-items: center;
    }

    /* ── ANIMATIONS ── */
    @@keyframes cbMsgIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes cbDotBounce { 0%,80%,100% { transform: scale(0.6); opacity: .4; } 40% { transform: scale(1); opacity: 1; } }
    @@keyframes cbFeedbackIn { from { opacity: 0; transform: translateY(8px) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }

    /* ── WELCOME ── */
    .cb-welcome {
        display: flex; flex-direction: column; align-items: center;
        justify-content: center; gap: 16px; padding: 40px;
        text-align: center; flex: 1;
    }

    .cb-welcome-icon {
        width: 72px; height: 72px; border-radius: 50%;
        background: linear-gradient(135deg, rgba(16,185,129,.12), rgba(6,182,212,.12));
        display: flex; align-items: center; justify-content: center;
    }

    .cb-welcome-icon i {
        font-size: 2rem;
        background: linear-gradient(135deg, #10b981, #06b6d4);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .cb-welcome h3 {
        font-size: 1.1rem; font-weight: 700; color: var(--text); margin: 0;
    }

    .cb-welcome p {
        font-size: .85rem; color: var(--text-muted); max-width: 380px; line-height: 1.6;
    }

    .cb-suggestions {
        display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;
        margin-top: 8px;
    }

    .cb-suggestion-chip {
        padding: 8px 16px; border-radius: 50px;
        border: 1.5px solid var(--border); background: #fff;
        font-size: .8rem; color: var(--text); cursor: pointer;
        transition: all .2s; font-weight: 500;
    }

    .cb-suggestion-chip:hover {
        border-color: #10b981; color: #10b981;
        background: rgba(16,185,129,.04);
        transform: translateY(-1px);
    }

    @@media (max-width: 768px) {
        .chatbot-page { padding: 12px; }
        .cb-msg-row { max-width: 90%; }
        .cb-feedback { max-width: 95%; }
        .cb-contact-doctor { max-width: 95%; }
    }
</style>
}

<div class="chatbot-page">
    <div class="chatbot-header">
        <div class="icon-box"><i class="fas fa-robot"></i></div>
        <div>
            <h1>Trợ lý sức khỏe AI</h1>
            <div class="subtitle">Hỗ trợ bởi trí tuệ nhân tạo — phản hồi tức thì 24/7</div>
        </div>
    </div>

    <div class="chatbot-container">
        <!-- Messages area -->
        <div class="chatbot-messages" id="chatBox">
            <!-- Welcome state -->
            <div class="cb-welcome" id="cbWelcome">
                <div class="cb-welcome-icon">
                    <i class="fas fa-heartbeat"></i>
                </div>
                <h3>Xin chào, @fullName! 👋</h3>
                <p>Tôi là trợ lý sức khỏe AI của HeartCare. Hãy hỏi tôi bất cứ điều gì về sức khỏe tim mạch, chế độ ăn, sinh hiệu, hoặc lịch uống thuốc.</p>
                <div class="cb-suggestions">
                    <button class="cb-suggestion-chip" onclick="useSuggestion(this)">💓 Nhịp tim bao nhiêu là bình thường?</button>
                    <button class="cb-suggestion-chip" onclick="useSuggestion(this)">🩸 Huyết áp cao nên ăn gì?</button>
                    <button class="cb-suggestion-chip" onclick="useSuggestion(this)">🏃 Tập thể dục bao lâu mỗi ngày?</button>
                    <button class="cb-suggestion-chip" onclick="useSuggestion(this)">💊 Khi nào nên uống thuốc?</button>
                </div>
            </div>
        </div>

        <!-- Input area -->
        <div class="chatbot-input-area">
            <input id="cbInput"
                   type="text"
                   placeholder="Nhập câu hỏi sức khỏe của bạn..."
                   maxlength="500"
                   autocomplete="off" />
            <button class="cb-btn-send" id="cbSendBtn" onclick="sendChatbotMessage()" title="Gửi tin nhắn">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    // ── DOM ──
    const chatBox   = document.getElementById('chatBox');
    const cbInput   = document.getElementById('cbInput');
    const cbSendBtn = document.getElementById('cbSendBtn');
    const cbWelcome = document.getElementById('cbWelcome');

    // ── STATE ──
    let isSending = false;

    // ══════════════════════════════
    // 1. SEND MESSAGE
    // ══════════════════════════════

    window.sendChatbotMessage = async function () {
        const text = cbInput.value.trim();
        if (!text || isSending) return;

        // Hide welcome
        if (cbWelcome) cbWelcome.style.display = 'none';


        // Remove any existing feedback/contact widget that hasn't been interacted with
        removeUnrespondedFeedback();

        // Show user message
        appendUserMessage(text);
        cbInput.value = '';
        cbInput.focus();

        // Show typing indicator
        const typingEl = showTypingIndicator();

        // Disable input
        setInputState(false);

        try {
            const res = await fetch('/Chatbot/SendMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text })
            });

            const data = await res.json();

            // Remove typing indicator
            typingEl.remove();

            if (data.success) {
                appendAiMessage(data.reply);
                showFeedbackWidget();
            } else {
                appendAiMessage('⚠️ Xin lỗi, đã có lỗi xảy ra. Vui lòng thử lại sau.');
            }
        } catch (err) {
            typingEl.remove();
            appendAiMessage('⚠️ Không thể kết nối đến server. Vui lòng kiểm tra mạng và thử lại.');
            console.error('[Chatbot] Error:', err);
        }

        setInputState(true);
        cbInput.focus();
    };

    // Enter to send
    cbInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            window.sendChatbotMessage();
        }
    });

    // Suggestion chips
    window.useSuggestion = function (el) {
        cbInput.value = el.textContent.replace(/^[^\s]+\s/, ''); // Remove emoji prefix
        window.sendChatbotMessage();
    };

    // ══════════════════════════════
    // 2. FEEDBACK (hiện ngay sau AI trả lời)
    // ══════════════════════════════

    function removeUnrespondedFeedback() {
        const feedbacks = chatBox.querySelectorAll('.cb-feedback:not(.resolved), .cb-contact-doctor:not(.resolved)');
        feedbacks.forEach(el => el.remove());
    }

    // ══════════════════════════════
    // 3. FEEDBACK WIDGET
    // ══════════════════════════════

    function showFeedbackWidget() {
        const row = document.createElement('div');
        row.className = 'cb-feedback';
        row.innerHTML = `
            <div class="cb-msg-avatar" style="background: linear-gradient(135deg, #10b981, #06b6d4);">
                <i class="fas fa-robot" style="font-size: .75rem;"></i>
            </div>
            <div class="cb-feedback-card">
                <div class="cb-feedback-question">
                    <i class="fas fa-star"></i>
                    Thông tin trên có hữu ích cho bạn không?
                </div>
                <div class="cb-feedback-actions">
                    <button class="cb-feedback-btn like" onclick="handleFeedback(this, 'like')">
                        <i class="fas fa-thumbs-up"></i> Hữu ích
                    </button>
                    <button class="cb-feedback-btn dislike" onclick="handleFeedback(this, 'dislike')">
                        <i class="fas fa-thumbs-down"></i> Chưa hữu ích
                    </button>
                </div>
            </div>
        `;

        chatBox.appendChild(row);
        scrollToBottom();
    }

    window.handleFeedback = function (btn, type) {
        const feedbackRow = btn.closest('.cb-feedback');
        if (!feedbackRow) return;

        feedbackRow.classList.add('resolved');

        if (type === 'like') {
            // Replace with thank you
            const card = feedbackRow.querySelector('.cb-feedback-card');
            card.innerHTML = `
                <div class="cb-feedback-thanks">
                    <i class="fas fa-check-circle"></i>
                    Cảm ơn phản hồi của bạn! Chúc bạn sức khỏe tốt 💚
                </div>
            `;
            scrollToBottom();
        } else {
            // Replace with thank you + show contact doctor option
            const card = feedbackRow.querySelector('.cb-feedback-card');
            card.innerHTML = `
                <div class="cb-feedback-thanks" style="color: #f59e0b; background: rgba(245,158,11,.08);">
                    <i class="fas fa-exclamation-circle"></i>
                    Cảm ơn phản hồi. Chúng tôi sẽ cải thiện!
                </div>
            `;

            // Show contact doctor CTA
            showContactDoctorOption();
        }
    };

    // ══════════════════════════════
    // 4. CONTACT DOCTOR CTA
    // ══════════════════════════════

    function showContactDoctorOption() {
        const row = document.createElement('div');
        row.className = 'cb-contact-doctor';
        row.innerHTML = `
            <div class="cb-contact-card">
                <div class="cb-contact-text">
                    <i class="fas fa-user-md"></i>
                    Bạn muốn được tư vấn trực tiếp bởi bác sĩ chuyên khoa? Hệ thống sẽ kết nối bạn với bác sĩ đang trực để được hỗ trợ tốt hơn.
                </div>
                <div class="cb-contact-actions">
                    <button class="cb-btn-contact-doctor" onclick="goToTelemedicineChat()">
                        <i class="fas fa-comments"></i> Liên hệ bác sĩ ngay
                    </button>
                    <button class="cb-btn-skip" onclick="skipContactDoctor(this)">
                        Để sau
                    </button>
                </div>
            </div>
        `;

        chatBox.appendChild(row);
        scrollToBottom();
    }

    window.goToTelemedicineChat = function () {
        // Redirect to the existing Telemedicine Chat page
        window.location.href = '/Chat/Index';
    };

    window.skipContactDoctor = function (btn) {
        const contactRow = btn.closest('.cb-contact-doctor');
        if (contactRow) {
            contactRow.classList.add('resolved');
            const card = contactRow.querySelector('.cb-contact-card');
            card.innerHTML = `
                <div class="cb-feedback-thanks" style="color: var(--text-muted); background: rgba(148,163,184,.08);">
                    <i class="fas fa-check"></i>
                    Đã ghi nhận. Bạn có thể liên hệ bác sĩ bất cứ lúc nào qua mục <strong>Tin nhắn</strong>.
                </div>
            `;
            scrollToBottom();
        }
    };

    // ══════════════════════════════
    // 5. UI HELPERS
    // ══════════════════════════════

    function appendUserMessage(text) {
        const row = document.createElement('div');
        row.className = 'cb-msg-row user';
        row.innerHTML = `
            <div class="cb-msg-avatar">
                <i class="fas fa-user" style="font-size: .7rem;"></i>
            </div>
            <div class="cb-msg-bubble">
                ${escapeHtml(text)}
                <div class="cb-msg-time">${formatTime(new Date())}</div>
            </div>
        `;
        chatBox.appendChild(row);
        scrollToBottom();
    }

    function appendAiMessage(text) {
        const row = document.createElement('div');
        row.className = 'cb-msg-row ai';

        // Format markdown-like content from AI
        const formatted = formatAiText(text);

        row.innerHTML = `
            <div class="cb-msg-avatar">
                <i class="fas fa-robot" style="font-size: .7rem;"></i>
            </div>
            <div class="cb-msg-bubble">
                ${formatted}
                <div class="cb-msg-time">${formatTime(new Date())}</div>
            </div>
        `;
        chatBox.appendChild(row);
        scrollToBottom();
    }

    function showTypingIndicator() {
        const el = document.createElement('div');
        el.className = 'cb-typing';
        el.innerHTML = `
            <div class="cb-msg-avatar">
                <i class="fas fa-robot" style="font-size: .7rem; color: #fff;"></i>
            </div>
            <div class="cb-typing-dots">
                <span></span><span></span><span></span>
            </div>
        `;
        chatBox.appendChild(el);
        scrollToBottom();
        return el;
    }

    function setInputState(enabled) {
        isSending = !enabled;
        cbInput.disabled = !enabled;
        cbSendBtn.disabled = !enabled;
    }

    function scrollToBottom() {
        setTimeout(() => {
            chatBox.scrollTo({ top: chatBox.scrollHeight, behavior: 'smooth' });
        }, 50);
    }

    // ══════════════════════════════
    // 6. FORMAT UTILS
    // ══════════════════════════════

    function escapeHtml(str) {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }

    function formatTime(date) {
        return date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
    }

    function formatAiText(text) {
        // Basic markdown formatting for AI responses
        let html = escapeHtml(text);

        // Bold: **text**
        html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

        // Line breaks
        html = html.replace(/\n/g, '<br>');

        // Bullet points
        html = html.replace(/^- (.+)/gm, '• $1');

        return html;
    }

})();
</script>
}