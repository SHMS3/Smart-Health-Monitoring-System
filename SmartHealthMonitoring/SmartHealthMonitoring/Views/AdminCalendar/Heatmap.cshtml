@model SmartHealthMonitoring.ViewModels.Admin.AdminHeatmapViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Heatmap Giờ Cao Điểm";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var monthStart = new DateOnly(today.Year, today.Month, 1);
    int max = Math.Max(Model.MaxCount, 1);

    string CellStyle(int count)
    {
        if (count <= 0) return "background:#f8fafc;color:#cbd5e1;";
        double t = (double)count / max; // 0..1
        // Light sky → deep primary
        int r = (int)Math.Round(224 + (2 - 224) * t);     // e0 → 02
        int g = (int)Math.Round(242 + (132 - 242) * t);   // f2 → 84
        int b = (int)Math.Round(254 + (199 - 254) * t);   // fe → c7
        string fg = t > 0.55 ? "#ffffff" : "#0c4a6e";
        return $"background:rgb({r},{g},{b});color:{fg};";
    }
}

@section Styles {
<style>
    .hm-filter {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 16px 18px;
        margin-bottom: 20px;
    }
    .hm-kpi-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }
    @@media (max-width: 992px) {
        .hm-kpi-row { grid-template-columns: repeat(2, 1fr); }
    }
    .hm-kpi {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .hm-kpi-icon {
        width: 44px; height: 44px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .hm-kpi-icon.blue { background: #e0f2fe; color: #0284c7; }
    .hm-kpi-icon.hot { background: #fee2e2; color: #dc2626; }
    .hm-kpi-icon.amber { background: #fef3c7; color: #d97706; }
    .hm-kpi-icon.slate { background: #f1f5f9; color: #475569; }
    .hm-kpi-value {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.45rem;
        color: #0f172a;
        line-height: 1.1;
    }
    .hm-kpi-label { font-size: .78rem; color: #64748b; margin-top: 4px; font-weight: 500; }

    .hm-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,.02);
        overflow: hidden;
    }
    .hm-card-header {
        padding: 18px 22px 12px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 12px;
    }
    .hm-card-header h3 {
        font-family: 'Outfit', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }
    .hm-card-header p {
        color: #64748b;
        font-size: .85rem;
        margin: 6px 0 0;
    }

    .hm-scroll {
        overflow-x: auto;
        padding: 0 16px 20px;
    }
    .hm-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 4px;
        min-width: 640px;
    }
    .hm-table th {
        text-align: center;
        font-size: .75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .4px;
        padding: 8px 6px;
    }
    .hm-table th.hm-time {
        text-align: right;
        width: 72px;
        color: #94a3b8;
        font-weight: 600;
        text-transform: none;
        letter-spacing: 0;
    }
    .hm-cell {
        text-align: center;
        border-radius: 8px;
        padding: 10px 6px;
        font-size: .8rem;
        font-weight: 700;
        min-width: 56px;
        transition: transform .15s, box-shadow .15s;
        cursor: default;
        user-select: none;
    }
    .hm-cell.has-data:hover {
        transform: scale(1.06);
        box-shadow: 0 6px 14px rgba(2, 132, 199, .25);
        z-index: 1;
        position: relative;
    }
    .hm-cell.peak {
        outline: 2px solid #dc2626;
        outline-offset: 1px;
    }

    .hm-legend {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: .78rem;
        color: #64748b;
        flex-wrap: wrap;
    }
    .hm-legend-bar {
        display: flex;
        height: 12px;
        width: 140px;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }
    .hm-legend-bar span { flex: 1; }

    .empty-state {
        text-align: center;
        padding: 48px 20px;
        color: #94a3b8;
    }
</style>
}

<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
        <h1 class="page-title">Heatmap Giờ Cao Điểm</h1>
        <p class="text-muted mt-2 mb-0">
            Mật độ đặt lịch theo khung giờ × ngày trong tuần
            · <strong>@Model.FromDate.ToString("dd/MM/yyyy")</strong> – <strong>@Model.ToDate.ToString("dd/MM/yyyy")</strong>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="AdminCalendar" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="fas fa-calendar-alt me-1"></i> Lịch tuần
        </a>
        <a asp-controller="AdminCalendar" asp-action="NoShowReport" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="fas fa-user-slash me-1"></i> No-show
        </a>
    </div>
</div>

<form method="get" asp-action="Heatmap" class="hm-filter">
    <div class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-secondary mb-1">Từ ngày</label>
            <input type="date" name="from" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-secondary mb-1">Đến ngày</label>
            <input type="date" name="to" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-secondary mb-1">Độ phân giải</label>
            <select name="slotMinutes" class="form-select">
                @if (Model.SlotMinutes == 30)
                {
                    <option value="60">1 giờ</option>
                    <option value="30" selected>30 phút</option>
                }
                else
                {
                    <option value="60" selected>1 giờ</option>
                    <option value="30">30 phút</option>
                }
            </select>
        </div>
        <div class="col-md-6 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="fas fa-filter me-1"></i> Lọc
            </button>
            <a class="btn btn-outline-secondary rounded-pill px-3"
               asp-action="Heatmap"
               asp-route-from="@today.AddDays(-7).ToString("yyyy-MM-dd")"
               asp-route-to="@today.ToString("yyyy-MM-dd")"
               asp-route-slotMinutes="@Model.SlotMinutes">7 ngày</a>
            <a class="btn btn-outline-secondary rounded-pill px-3"
               asp-action="Heatmap"
               asp-route-from="@today.AddDays(-28).ToString("yyyy-MM-dd")"
               asp-route-to="@today.ToString("yyyy-MM-dd")"
               asp-route-slotMinutes="@Model.SlotMinutes">4 tuần</a>
            <a class="btn btn-outline-secondary rounded-pill px-3"
               asp-action="Heatmap"
               asp-route-from="@monthStart.ToString("yyyy-MM-dd")"
               asp-route-to="@today.ToString("yyyy-MM-dd")"
               asp-route-slotMinutes="@Model.SlotMinutes">Tháng này</a>
        </div>
    </div>
</form>

<div class="hm-kpi-row">
    <div class="hm-kpi">
        <div class="hm-kpi-icon blue"><i class="fas fa-calendar-check"></i></div>
        <div>
            <div class="hm-kpi-value">@Model.TotalBookings</div>
            <div class="hm-kpi-label">Tổng lượt đặt lịch</div>
        </div>
    </div>
    <div class="hm-kpi">
        <div class="hm-kpi-icon hot"><i class="fas fa-fire"></i></div>
        <div>
            <div class="hm-kpi-value">@(Model.PeakHourLabel ?? "—")</div>
            <div class="hm-kpi-label">Giờ cao điểm</div>
        </div>
    </div>
    <div class="hm-kpi">
        <div class="hm-kpi-icon amber"><i class="fas fa-calendar-day"></i></div>
        <div>
            <div class="hm-kpi-value">@(Model.PeakDayLabel ?? "—")</div>
            <div class="hm-kpi-label">Ngày cao điểm trong tuần</div>
        </div>
    </div>
    <div class="hm-kpi">
        <div class="hm-kpi-icon slate"><i class="fas fa-layer-group"></i></div>
        <div>
            <div class="hm-kpi-value">@Model.PeakCount</div>
            <div class="hm-kpi-label">Lượt đặt tại ô nóng nhất</div>
        </div>
    </div>
</div>

<div class="hm-card">
    <div class="hm-card-header">
        <div>
            <h3><i class="fas fa-th me-2 text-primary"></i>Bảng Heatmap</h3>
            <p>Màu càng đậm = càng nhiều lượt đặt. Ô viền đỏ = đỉnh cao nhất.</p>
        </div>
        <div class="hm-legend">
            <span>Ít</span>
            <div class="hm-legend-bar" aria-hidden="true">
                <span style="background:#f8fafc"></span>
                <span style="background:#bae6fd"></span>
                <span style="background:#38bdf8"></span>
                <span style="background:#0284c7"></span>
                <span style="background:#0369a1"></span>
            </div>
            <span>Nhiều</span>
            <span class="ms-2 text-muted">Max: <strong>@Model.MaxCount</strong></span>
        </div>
    </div>

    @if (Model.TotalBookings == 0)
    {
        <div class="empty-state">
            <i class="fas fa-th fa-2x mb-3 d-block opacity-50"></i>
            Không có dữ liệu đặt lịch trong khoảng đã chọn.
        </div>
    }
    else
    {
        <div class="hm-scroll">
            <table class="hm-table">
                <thead>
                    <tr>
                        <th class="hm-time">Giờ</th>
                        @foreach (var day in Model.DayLabels)
                        {
                            <th>@day</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int r = 0; r < Model.HourLabels.Count; r++)
                    {
                        <tr>
                            <th class="hm-time">@Model.HourLabels[r]</th>
                            @for (int c = 0; c < Model.DayLabels.Count; c++)
                            {
                                var count = Model.Counts[r][c];
                                var isPeak = count > 0 && count == Model.MaxCount;
                                var tip = $"{Model.DayLabels[c]} · {Model.HourLabels[r]} — {count} lượt đặt";
                                <td>
                                    <div class="hm-cell @(count > 0 ? "has-data" : "") @(isPeak ? "peak" : "")"
                                         style="@CellStyle(count)"
                                         title="@tip">
                                        @(count > 0 ? count.ToString() : "·")
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
