@model SmartHealthMonitoring.ViewModels.DailyVitalLogViewModel

@{
    ViewData["Title"] = "Cập nhật chỉ số #" + Model.Id;
}

<div class="dashboard-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link text-muted p-0 mb-2 d-inline-flex align-items-center text-decoration-none fw-medium transition-all">
                <i class="bi bi-arrow-left me-1"></i> Hủy & Quay lại chi tiết
            </a>
            <h3 class="fw-bold mb-0 text-dark">Chỉnh sửa hồ sơ #@Model.Id</h3>
        </div>
    </div>

    <div class="dashboard-card p-4 p-md-5 mx-auto" style="max-width: 800px;">
        <div class="alert bg-light-blue border text-primary-dark rounded-3 mb-4 d-flex align-items-center">
            <i class="bi bi-info-circle-fill me-2 fs-5"></i>
            <span>
                Bạn đang chỉnh sửa dữ liệu đo lúc
                <strong>@Model.LoggedAt.ToString("dd/MM/yyyy HH:mm")</strong>.
                Tính năng này sẽ khóa sau 24h.
            </span>
        </div>

        <form asp-action="Update" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="LoggedAt" />

            <h5 class="fw-bold text-primary-dark mb-4 border-bottom pb-3">
                <i class="bi bi-activity me-2"></i>Chỉ số đo đạc vật lý
            </h5>

            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <label asp-for="SystolicBp" class="form-label fw-semibold text-dark">Huyết áp tâm thu (Trên) <span class="text-danger">*</span></label>
                    <div class="input-group custom-input-group">
                        <input asp-for="SystolicBp" type="number" class="form-control custom-input" required />
                        <span class="input-group-text bg-light border-start-0 text-muted">mmHg</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="DiastolicBp" class="form-label fw-semibold text-dark">Huyết áp tâm trương (Dưới) <span class="text-danger">*</span></label>
                    <div class="input-group custom-input-group">
                        <input asp-for="DiastolicBp" type="number" class="form-control custom-input" required />
                        <span class="input-group-text bg-light border-start-0 text-muted">mmHg</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="HeartRate" class="form-label fw-semibold text-dark">Nhịp tim <span class="text-danger">*</span></label>
                    <div class="input-group custom-input-group">
                        <input asp-for="HeartRate" type="number" class="form-control custom-input" required />
                        <span class="input-group-text bg-light border-start-0 text-muted">bpm</span>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold text-primary-dark mb-4 border-bottom pb-3">
                <i class="bi bi-person-bounding-box me-2"></i>Triệu chứng lâm sàng
            </h5>

            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <label asp-for="ChestPainLevel" class="form-label fw-semibold text-dark">Mức độ đau ngực</label>
                    <select asp-for="ChestPainLevel" class="form-select custom-input">
                        <option value="0">Mức 0: Không đau ngực</option>
                        <option value="1">Mức 1: Đau ngực không điển hình</option>
                        <option value="2">Mức 2: Đau thắt ngực (nhẹ)</option>
                        <option value="3">Mức 3: Đau thắt ngực dữ dội</option>
                    </select>
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    <div class="custom-switch-wrapper p-3 border rounded-3 w-100 d-flex justify-content-between align-items-center bg-light-blue">
                        <label asp-for="HasExerciseAngina" class="form-check-label fw-semibold text-dark mb-0">Đau ngực khi vận động?</label>
                        <div class="form-check form-switch m-0">
                            <input asp-for="HasExerciseAngina" class="form-check-input custom-switch-input" type="checkbox" role="switch">
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 border-top pt-4">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn custom-btn-outline px-4 py-2 fw-medium">Hủy bỏ</a>
                <button type="submit" class="btn custom-btn-warning px-5 py-2 fw-medium">
                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    /* CSS y hệt trang Create, chỉ đổi màu nút Lưu thay đổi */
    .dashboard-container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .dashboard-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
        border: 1px solid #f1f5f9;
    }

    .text-primary-dark {
        color: #0284c7;
    }

    .bg-light-blue {
        background-color: #f8fafc;
    }

    .custom-btn-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.25);
        transition: all 0.3s ease;
    }

        .custom-btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(245, 158, 11, 0.35);
            color: #fff;
        }

    .custom-btn-outline {
        background: #fff;
        color: #64748b;
        border: 1.5px solid #cbd5e1;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .custom-btn-outline:hover {
            background: #f1f5f9;
            color: #334155;
        }

    .custom-input {
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.7rem 1rem;
        font-size: 0.95rem;
        color: #334155;
        transition: border-color 0.2s;
    }

        .custom-input:focus {
            border-color: #0ea5e9;
            box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.1);
            outline: none;
        }

    .custom-input-group .custom-input {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
        border-right: none;
    }

    .custom-input-group .input-group-text {
        border: 1.5px solid #e2e8f0;
        border-top-right-radius: 10px;
        border-bottom-right-radius: 10px;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .custom-input-group:focus-within .input-group-text {
        border-color: #0ea5e9;
    }

    .custom-switch-input {
        width: 3em !important;
        height: 1.5em !important;
        cursor: pointer;
    }

        .custom-switch-input:checked {
            background-color: #ef4444;
            border-color: #ef4444;
        }
</style>