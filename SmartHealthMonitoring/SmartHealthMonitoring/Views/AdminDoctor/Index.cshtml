@model SmartHealthMonitoring.Common.PagedResult<SmartHealthMonitoring.ViewModels.Admin.DoctorListViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Bác sĩ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Quản lý Bác sĩ</h3>
        <p class="text-muted small">Danh sách bác sĩ trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm px-4"><i class="fas fa-plus me-2"></i>Thêm bác sĩ</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle text-nowrap mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th class="ps-4">Họ và tên</th>
                        <th>Email</th>
                        <th>Chuyên khoa</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.Items)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">@doc.FullName</td>
                            <td class="text-muted">@doc.Email</td>
                            <td><span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill px-3">@doc.Specialty</span></td>
                            <td>
                                @if (doc.IsDeleted)
                                {
                                    <span class="badge bg-danger rounded-pill px-3">Đã khóa</span>
                                }
                                else
                                {

                                    <span class="badge bg-success rounded-pill px-3">Hoạt động</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <form asp-action="ToggleLock" asp-route-userId="@doc.UserId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(doc.IsDeleted ? "btn-outline-success" : "btn-outline-danger") rounded-pill fw-medium" onclick="return confirm('Xác nhận thay đổi trạng thái?');">
                                        <i class="fas @(doc.IsDeleted ? "fa-unlock" : "fa-lock") me-1"></i> @(doc.IsDeleted ? "Mở khóa" : "Khóa")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top-0 p-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">
                Hiển thị trang @Model.Page / @Model.TotalPages (Tổng số: @Model.TotalCount bác sĩ)
            </span>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link rounded-start-pill px-3" asp-action="Index" asp-route-page="@(Model.Page - 1)">Trước</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-end-pill px-3" asp-action="Index" asp-route-page="@(Model.Page + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>