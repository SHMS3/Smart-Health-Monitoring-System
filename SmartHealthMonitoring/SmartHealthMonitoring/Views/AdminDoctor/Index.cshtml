@model SmartHealthMonitoring.Common.PagedResult<SmartHealthMonitoring.ViewModels.Admin.DoctorListViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Bác sĩ";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Quản lý Bác sĩ</h1>
        <p class="text-muted mt-2 mb-0">Danh sách các chuyên gia y tế trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm px-4 fw-medium" style="background-color: var(--color-primary-dark); border: none;">
        <i class="fas fa-plus me-2"></i>Thêm Bác sĩ Mới
    </a>
</div>

<div class="admin-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="modern-table">
            <thead>
                <tr>
                    <th style="width: 50px;"></th>
                    <th>Họ và tên / Tên miền</th>
                    <th>Chuyên khoa</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Model.Items)
                {
                    <tr>
                        <td class="text-center">
                            <div class="avatar" style="width: 36px; height: 36px; font-size: 1rem; margin: 0 auto; background: rgba(14,165,233,0.1);">
                                @doc.FullName.Substring(0, 1).ToUpper()
                            </div>
                        </td>
                        <td>
                            <div class="fw-bold" style="color: #0f172a; font-size: 0.95rem;">@doc.FullName</div>
                            <div class="text-muted" style="font-size: 0.8rem;">@doc.Email</div>
                        </td>
                        <td>
                            <span class="modern-badge" style="background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0;">
                                <i class="fas fa-stethoscope me-1 text-primary"></i> @doc.Specialty
                            </span>
                        </td>
                        <td>
                            @if (doc.IsDeleted)
                            {
                                <span class="modern-badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                    <i class="fas fa-lock me-1"></i> Đã khóa
                                </span>
                                @if (!string.IsNullOrEmpty(doc.LockReason))
                                {
                                    <div class="text-danger mt-1 fw-medium" style="font-size: 0.75rem;">
                                        @doc.LockReason
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="modern-badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                    <i class="fas fa-check-circle me-1"></i> Hoạt động
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@doc.DoctorId" class="btn btn-sm btn-light rounded-pill text-primary fw-bold px-3 me-1 border shadow-sm">
                                <i class="fas fa-edit me-1"></i> Sửa
                            </a>
                            @if (doc.IsDeleted)
                            {
                                <form asp-action="ToggleLock" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@doc.UserId" />
                                    <button type="submit" class="btn btn-sm btn-success rounded-pill fw-bold px-3 shadow-sm" onclick="return confirm('Xác nhận mở khóa tài khoản bác sĩ này?');">
                                        <i class="fas fa-unlock me-1"></i> Mở
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill fw-bold px-3" data-bs-toggle="modal" data-bs-target="#lockModal-doc-@doc.UserId">
                                    <i class="fas fa-lock me-1"></i> Khóa
                                </button>
                            }
                        </td>
                    </tr>

                    <!-- Lock Modal -->
                    <div class="modal fade" id="lockModal-doc-@doc.UserId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow-lg">
                                <form asp-action="ToggleLock" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-header border-bottom-0 p-4 pb-0">
                                        <h5 class="modal-title fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <i class="fas fa-user-lock text-danger me-2"></i>Khóa tài khoản
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-4 pt-3">
                                        <p class="text-muted mb-3">Vui lòng nhập lý do khóa tài khoản của bác sĩ <strong>@doc.FullName</strong>. Bác sĩ sẽ không thể đăng nhập được nữa.</p>
                                        <input type="hidden" name="userId" value="@doc.UserId" />
                                        <div class="mb-0">
                                            <textarea name="lockReason" class="form-control rounded-3 border-secondary" rows="3" placeholder="Ví dụ: Nghỉ việc, Vi phạm quy chế bệnh viện..." required></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-top-0 p-4 pt-0">
                                        <button type="button" class="btn btn-light rounded-pill px-4 fw-medium" data-bs-dismiss="modal">Hủy</button>
                                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Xác nhận Khóa</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-4 border-top" style="background: #f8fafc;">
            <span class="text-muted fw-medium" style="font-size: 0.85rem;">Hiển thị trang @Model.Page / @Model.TotalPages</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 ms-1" asp-action="Index" asp-route-page="@(Model.Page - 1)">Trước</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 ms-1" asp-action="Index" asp-route-page="@(Model.Page + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>