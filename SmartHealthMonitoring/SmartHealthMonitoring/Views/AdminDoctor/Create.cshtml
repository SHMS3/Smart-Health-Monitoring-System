@model SmartHealthMonitoring.ViewModels.Admin.DoctorCreateViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cấp tài khoản Bác sĩ";
}

<style>
    .modern-form-label {
        font-weight: 600;
        color: #334155;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }
    
    .modern-input {
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 1rem;
        font-size: 0.95rem;
        transition: all 0.2s;
        background-color: #f8fafc;
    }
    
    .modern-input:focus {
        background-color: #fff;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
    }
    
    .required-star {
        color: var(--color-danger);
        margin-left: 3px;
    }
</style>

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-light rounded-pill px-3 shadow-sm border fw-medium text-secondary">
        <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card p-0 overflow-hidden">
            <div class="card-header bg-white border-bottom p-4">
                <h4 class="fw-bold mb-1" style="color: #0f172a; font-family: 'Outfit', sans-serif;">
                    <i class="fas fa-user-md text-primary me-2"></i>Cấp tài khoản Bác sĩ mới
                </h4>
                <div class="alert alert-info border-0 bg-info bg-opacity-10 d-flex align-items-center mt-3 mb-0 rounded-3">
                    <i class="fas fa-info-circle text-info fs-4 me-3"></i>
                    <p class="mb-0 text-dark small fw-medium">
                        Hệ thống sẽ tự động tạo một <strong>mật khẩu ngẫu nhiên an toàn</strong> và gửi thông tin đăng nhập đến địa chỉ Email của bác sĩ.
                    </p>
                </div>
            </div>
            
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Email" class="modern-form-label">Địa chỉ Email <span class="required-star">*</span></label>
                            <input asp-for="Email" type="email" class="form-control modern-input" placeholder="name@hospital.com" />
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Specialty" class="modern-form-label">Chuyên khoa khám <span class="required-star">*</span></label>
                            <input asp-for="Specialty" class="form-control modern-input" placeholder="Ví dụ: Tim mạch, Nội tiết..." value="Tim mạch" />
                            <span asp-validation-for="Specialty" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="PracticeLicense" class="modern-form-label">Giấy phép hành nghề</label>
                            <input asp-for="PracticeLicense" class="form-control modern-input" placeholder="Nhập số giấy phép hành nghề (nếu có)..." />
                            <span asp-validation-for="PracticeLicense" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>
                    </div>

                    <hr class="my-4 border-secondary opacity-25">

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-medium border">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow" style="background-color: var(--color-primary-dark); border: none;">
                            <i class="fas fa-check-circle me-2"></i> Xác nhận & Cấp tài khoản
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}