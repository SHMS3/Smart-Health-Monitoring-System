@model SmartHealthMonitoring.ViewModels.ClinicalExamFormViewModel
@{
    ViewData["Title"] = "Nhập Phiếu Khám Lâm Sàng";
}

@section Styles {
    <style>
        .lis-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 50px;
            background: rgba(245, 158, 11, 0.1);
            color: #d97706;
            font-size: 0.85rem;
            font-weight: 600;
            border: 1px solid rgba(245, 158, 11, 0.2);
            transition: all 0.3s ease;
        }

            .status-badge.success {
                background: rgba(16, 185, 129, 0.1);
                color: #059669;
                border-color: rgba(16, 185, 129, 0.2);
            }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: #f59e0b;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        .status-badge.success .pulse-dot {
            background-color: #10b981;
            animation: none;
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
        }

        @@keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4);
            }

            70% {
                box-shadow: 0 0 0 6px rgba(245, 158, 11, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0);
            }
        }

        .btn-lis-fetch {
            background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);
            border: none;
            color: white;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .btn-lis-fetch:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(14, 165, 233, 0.4);
                color: white;
            }

        .form-section {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 24px;
            height: 100%;
        }

        .section-title {
            font-size: 1rem;
            font-weight: 700;
            color: #334155;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
        }

        .bg-red-soft {
            background: #fee2e2;
            color: #ef4444;
        }

        .bg-blue-soft {
            background: #e0f2fe;
            color: #0ea5e9;
        }

        .bg-purple-soft {
            background: #f3e8ff;
            color: #8b5cf6;
        }

        .form-control:read-only, .form-select:disabled {
            background-color: #f1f5f9;
            border-color: #cbd5e1;
            color: #94a3b8;
            cursor: not-allowed;
        }

        .custom-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 6px;
        }
    </style>
}

<div class="container pt-5 mt-4 pb-5 lis-container">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">

        <div class="card-header bg-white border-bottom p-4 p-md-5 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
            <div>
                <div class="d-flex align-items-center gap-3 mb-2">
                    <h3 class="fw-bold text-dark mb-0">Phiếu Khám Cận Lâm Sàng</h3>
                    <div class="status-badge" id="lisStatusBadge">
                        <div class="pulse-dot"></div>
                        <span id="lisStatusText">Đang chờ dữ liệu LIS...</span>
                    </div>
                </div>
                <p class="text-muted mb-0">Dữ liệu được đồng bộ trực tiếp từ máy xét nghiệm thông qua Webhook.</p>
            </div>
            <button type="button" id="btnFetchWebhook" class="btn btn-lis-fetch btn-lg rounded-pill fw-bold px-4 py-2 flex-shrink-0">
                <i class="fas fa-satellite-dish me-2"></i> Kéo dữ liệu từ Máy Xét Nghiệm
            </button>
        </div>

        <div class="card-body p-4 p-md-5">
            <form id="clinicalForm" asp-action="Create" method="post" enctype="multipart/form-data">
                <input type="hidden" id="patientIdHidden" name="PatientId" value="@Model.PatientId" />
                <input type="hidden" id="ecgImageUrlHidden" asp-for="EcgImageUrl" />

                <div class="row g-4 mb-4">
                    <div class="col-lg-4">
                        <div class="form-section">
                            <div class="section-title">
                                <div class="section-icon bg-red-soft"><i class="fas fa-heartbeat"></i></div>
                                Huyết áp & Triệu chứng
                            </div>

                            <div class="mb-3">
                                <label asp-for="ChestPainType" class="custom-label">Loại đau ngực (Chest Pain Type)</label>
                                <select asp-for="ChestPainType" class="form-select shadow-sm auto-field" disabled>
                                    <option value="">-- Trống --</option>
                                    <option value="0">Typical Angina (TA)</option>
                                    <option value="1">Atypical Angina (ATA)</option>
                                    <option value="2">Non-Anginal Pain (NAP)</option>
                                    <option value="3">Asymptomatic (ASY)</option>
                                </select>
                                <span asp-validation-for="ChestPainType" class="text-danger small fw-medium mt-1 d-block"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ExerciseAngina" class="custom-label">Đau ngực gắng sức (Exercise Angina)</label>
                                <select asp-for="ExerciseAngina" class="form-select shadow-sm auto-field" disabled>
                                    <option value="">-- Trống --</option>
                                    <option value="0">Không (No)</option>
                                    <option value="1">Có (Yes)</option>
                                </select>
                                <span asp-validation-for="ExerciseAngina" class="text-danger small fw-medium mt-1 d-block"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RestingBP" class="custom-label">Huyết áp nghỉ (Resting BP - mmHg)</label>
                                <input asp-for="RestingBP" type="number" class="form-control shadow-sm auto-field" placeholder="Chờ đồng bộ..." readonly />
                                <span asp-validation-for="RestingBP" class="text-danger small fw-medium mt-1 d-block"></span>
                            </div>

                            <div class="mb-0">
                                <label asp-for="MaxHeartRate" class="custom-label">Nhịp tim tối đa (Max Heart Rate)</label>
                                <input asp-for="MaxHeartRate" type="number" class="form-control shadow-sm auto-field" placeholder="Chờ đồng bộ..." readonly />
                                <span asp-validation-for="MaxHeartRate" class="text-danger small fw-medium mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-section">
                            <div class="section-title">
                                <div class="section-icon bg-blue-soft"><i class="fas fa-tint"></i></div>
                                Phân tích Huyết học
                            </div>

                            <div class="mb-3">
                                <label asp-for="Cholesterol" class="custom-label">Cholesterol (mg/dl)</label>
                                <input asp-for="Cholesterol" type="number" class="form-control shadow-sm auto-field" placeholder="Chờ đồng bộ..." readonly />
                                <span asp-validation-for="Cholesterol" class="text-danger small fw-medium mt-1 d-block"></span>
                            </div>

                            <div class="mb-0">
                                <label asp-for="FastingBS" class="custom-label">Đường huyết đói > 120 mg/dl</label>
                                <select asp-for="FastingBS" class="form-select shadow-sm auto-field" disabled>
                                    <option value="">-- Trống --</option>
                                    <option value="0">Bình thường (False)</option>
                                    <option value="1">Cao (True)</option>
                                </select>
                                <span asp-validation-for="FastingBS" class="text-danger small fw-medium mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-section">
                            <div class="section-title">
                                <div class="section-icon bg-purple-soft"><i class="fas fa-wave-square"></i></div>
                                Điện tâm đồ & Mạch vành
                            </div>

                            <div class="mb-3">
                                <label asp-for="RestECG" class="custom-label">Điện tâm đồ nghỉ (Rest ECG)</label>
                                <select asp-for="RestECG" class="form-select shadow-sm auto-field" disabled>
                                    <option value="">-- Trống --</option>
                                    <option value="0">Normal</option>
                                    <option value="1">ST-T Abnormality</option>
                                    <option value="2">Left Ventricular Hypertrophy (LVH)</option>
                                </select>
                                <span asp-validation-for="RestECG" class="text-danger small fw-medium mt-1 d-block"></span>
                            </div>

                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label asp-for="STSlope" class="custom-label">Độ dốc ST</label>
                                    <select asp-for="STSlope" class="form-select shadow-sm auto-field" disabled>
                                        <option value="">-- Trống --</option>
                                        <option value="1">Upsloping</option>
                                        <option value="2">Flat</option>
                                        <option value="3">Downsloping</option>
                                    </select>
                                    <span asp-validation-for="STSlope" class="text-danger small fw-medium mt-1 d-block"></span>
                                </div>
                                <div class="col-6 mb-3">
                                    <label asp-for="OldPeak" class="custom-label">Oldpeak</label>
                                    <input asp-for="OldPeak" type="number" step="0.1" class="form-control shadow-sm auto-field" placeholder="..." readonly />
                                    <span asp-validation-for="OldPeak" class="text-danger small fw-medium mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-6 mb-0">
                                    <label asp-for="MajorVessels" class="custom-label">Mạch chính</label>
                                    <select asp-for="MajorVessels" class="form-select shadow-sm auto-field" disabled>
                                        <option value="">--</option>
                                        <option value="0">0</option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                    </select>
                                    <span asp-validation-for="MajorVessels" class="text-danger small fw-medium mt-1 d-block"></span>
                                </div>
                                <div class="col-6 mb-0">
                                    <label asp-for="ThalResult" class="custom-label">Khuyết tật Thal</label>
                                    <select asp-for="ThalResult" class="form-select shadow-sm auto-field" disabled>
                                        <option value="">--</option>
                                        <option value="1">Normal</option>
                                        <option value="2">Fixed Defect</option>
                                        <option value="3">Reversable</option>
                                    </select>
                                    <span asp-validation-for="ThalResult" class="text-danger small fw-medium mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="ecgPreviewContainer" class="row mb-4" style="display: none;">
                    <div class="col-12">
                        <div class="card card-body bg-light border border-secondary border-opacity-25 rounded-4 shadow-sm">
                            <h6 class="fw-bold text-dark mb-3">
                                <i class="fas fa-file-medical-alt text-primary me-2"></i>Biểu đồ Điện tâm đồ (ECG/EKG) thu nhận từ hệ thống LIS
                            </h6>
                            <img id="ecgPreviewImage" src="" alt="Biểu đồ ECG" class="img-fluid rounded border border-secondary border-opacity-25 shadow-sm" style="max-height: 400px; object-fit: contain; width: 100%; background: #fff;" />
                            <div class="text-end mt-2">
                                <a id="ecgPreviewLink" href="#" target="_blank" class="btn btn-sm btn-link text-decoration-none fw-bold">
                                    Mở ảnh trong tab mới <i class="fas fa-external-link-alt ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-5">
                    <div class="col-12">
                        <div class="form-section bg-white border rounded-4 p-4 shadow-sm">
                            <div class="section-title mb-3">
                                <div class="section-icon bg-info bg-opacity-10 text-info"><i class="fas fa-paperclip"></i></div>
                                Hình ảnh biến chứng & Tài liệu đính kèm (Bác sĩ upload thủ công)
                            </div>
                            <p class="text-muted small mb-3">Bác sĩ có thể upload hình ảnh biến chứng lâm sàng phát hiện được (biến chứng mắt, loét, hình ảnh chụp chiếu ngoài danh mục máy LIS) để lưu trữ vào hồ sơ gốc.</p>

                            <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">
                                <div class="flex-grow-1 w-100">
                                    <input type="file" asp-for="AttachmentFile" class="form-control rounded-3 shadow-sm auto-field" accept="image/*,application/pdf" style="padding: 0.6rem 1rem;" disabled />
                                </div>
                                <span class="text-muted small flex-shrink-0"><i class="fas fa-info-circle me-1"></i>Hỗ trợ: Ảnh (.jpg, .png) hoặc File PDF</span>
                            </div>
                            <span asp-validation-for="AttachmentFile" class="text-danger small fw-medium mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-4 border-0 shadow-sm mb-4">
                        <i class="fas fa-exclamation-triangle me-2"></i> Máy xét nghiệm đẩy về dữ liệu không hợp lệ. Vui lòng Bác sĩ kiểm tra lại các ô bị đánh dấu đỏ!
                        <div asp-validation-summary="ModelOnly" class="mt-2 mb-0 fw-medium"></div>
                    </div>
                }

                <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center bg-light p-4 rounded-4 border gap-4">

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="form-check form-switch mb-0 d-flex align-items-center" style="padding-left: 0;">
                            <input type="hidden" name="IsViewForPatient" value="false" />
                            <input class="form-check-input m-0 flex-shrink-0" type="checkbox" name="IsViewForPatient" id="IsViewForPatient" value="true" checked style="width: 3rem; height: 1.5rem; cursor: pointer;" />
                            <label class="form-check-label fw-semibold ms-2 text-nowrap" for="IsViewForPatient" style="font-size: 0.95rem;">
                                Cho phép bệnh nhân xem hồ sơ này
                            </label>
                        </div>
                        <span id="viewStatusBadge" class="badge bg-success px-3 py-2 rounded-pill text-nowrap" style="font-size: 0.8rem;">
                            <i class="fas fa-eye me-1"></i> Bệnh nhân có thể xem
                        </span>
                    </div>

                    <div class="d-flex flex-wrap align-items-center justify-content-xl-end gap-3">
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <i class="fas fa-info-circle text-primary flex-shrink-0"></i>
                            <span>Bác sĩ vui lòng rà soát lại dữ liệu trước khi lưu.</span>
                        </div>
                        <button type="submit" id="btnSubmitForm" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm fw-bold text-nowrap" disabled>
                            Xác nhận & Lưu Hồ Sơ <i class="fas fa-check-circle ms-2"></i>
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnFetch = document.getElementById('btnFetchWebhook');
            const btnSubmit = document.getElementById('btnSubmitForm');
            const patientId = document.getElementById('patientIdHidden').value;
            const form = document.getElementById('clinicalForm');
            const badge = document.getElementById('lisStatusBadge');
            const badgeText = document.getElementById('lisStatusText');

            const ecgPreviewContainer = document.getElementById('ecgPreviewContainer');
            const ecgPreviewImage = document.getElementById('ecgPreviewImage');
            const ecgPreviewLink = document.getElementById('ecgPreviewLink');
            const ecgImageUrlHidden = document.getElementById('ecgImageUrlHidden');

            // --- THÊM LOGIC: Tự động giữ nguyên form & ảnh nếu bị lỗi Validation ---
            const hasValidationErrors = @((!ViewData.ModelState.IsValid).ToString().ToLower());

            if (hasValidationErrors) {
                document.querySelectorAll('.auto-field').forEach(el => {
                    el.removeAttribute('readonly');
                    el.removeAttribute('disabled');
                });
                btnSubmit.removeAttribute('disabled');
                badge.classList.add('success');
                badgeText.textContent = 'Bác sĩ đang chỉnh sửa dữ liệu';
                btnFetch.innerHTML = '<i class="fas fa-edit me-2"></i> Chỉnh sửa thủ công';
                btnFetch.classList.replace('btn-lis-fetch', 'btn-warning');

                // Nếu trong Hidden input có sẵn URL (do lần Post trước gửi lên), hiển thị lại ảnh
                if (ecgImageUrlHidden.value) {
                    ecgPreviewImage.src = ecgImageUrlHidden.value;
                    ecgPreviewLink.href = ecgImageUrlHidden.value;
                    ecgPreviewContainer.style.display = 'block';
                }
            }

            // Kéo dữ liệu từ Webhook
            btnFetch.addEventListener('click', function () {
                const originalHtml = btnFetch.innerHTML;
                btnFetch.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang kết nối...';
                btnFetch.disabled = true;

                fetch(`/api/LabWebhook/CheckResult/${patientId}`)
                    .then(response => {
                        if (response.status === 404) throw new Error('404_NOT_FOUND');
                        if (!response.ok) throw new Error('SERVER_ERROR');
                        return response.json();
                    })
                    .then(data => {
                        // Autofill Form
                        document.getElementById('ChestPainType').value = data.chestPainType;
                        document.getElementById('RestingBP').value = data.restingBP;
                        document.getElementById('Cholesterol').value = data.cholesterol;
                        document.getElementById('FastingBS').value = data.fastingBS;
                        document.getElementById('RestECG').value = data.restECG;
                        document.getElementById('MaxHeartRate').value = data.maxHeartRate;
                        document.getElementById('ExerciseAngina').value = data.exerciseAngina;
                        document.getElementById('OldPeak').value = data.oldPeak;
                        document.getElementById('STSlope').value = data.stSlope;
                        document.getElementById('MajorVessels').value = data.majorVessels;
                        document.getElementById('ThalResult').value = data.thalResult;

                        // Gán link ảnh vào thẻ input ẩn và lập tức HIỂN THỊ PREVIEW
                        if (data.ecgImageUrl) {
                            ecgImageUrlHidden.value = data.ecgImageUrl;

                            // Gắn source vào thẻ img và a
                            ecgPreviewImage.src = data.ecgImageUrl;
                            ecgPreviewLink.href = data.ecgImageUrl;

                            // Hiện container chứa ảnh lên
                            ecgPreviewContainer.style.display = 'block';
                        }

                        // Unlock form fields (Bao gồm cả thẻ input file)
                        document.querySelectorAll('.auto-field').forEach(el => {
                            el.removeAttribute('readonly');
                            el.removeAttribute('disabled');
                        });

                        btnSubmit.removeAttribute('disabled');

                        // Update UI Status
                        btnFetch.innerHTML = '<i class="fas fa-check-double me-2"></i> Đã đồng bộ thành công';
                        btnFetch.classList.replace('btn-lis-fetch', 'btn-success');
                        badge.classList.add('success');
                        badgeText.textContent = 'Dữ liệu đã được đồng bộ';
                    })
                    .catch(error => {
                        if (error.message === '404_NOT_FOUND') {
                            alert("Chưa có kết quả từ máy xét nghiệm. Vui lòng gửi dữ liệu từ Postman trước khi bấm đồng bộ.");
                        } else {
                            alert("Có lỗi xảy ra khi kết nối đến hệ thống nội bộ LIS.");
                        }
                        btnFetch.innerHTML = originalHtml;
                        btnFetch.disabled = false;
                    });
            });

            // Toggle trạng thái con mắt
            const toggleView = document.getElementById('IsViewForPatient');
            const viewBadge  = document.getElementById('viewStatusBadge');

            function updateViewBadge() {
                if (toggleView.checked) {
                    viewBadge.className = 'badge bg-success px-3 py-2 rounded-pill';
                    viewBadge.innerHTML = '<i class="fas fa-eye me-1"></i> Bệnh nhân có thể xem';
                } else {
                    viewBadge.className = 'badge bg-secondary px-3 py-2 rounded-pill';
                    viewBadge.innerHTML = '<i class="fas fa-eye-slash me-1"></i> Bệnh nhân không thể xem';
                }
            }
            toggleView.addEventListener('change', updateViewBadge);

            // Mở khóa disable trước khi submit để C# nhận được data và chống Double Click
            form.addEventListener('submit', function() {
                // 1. Disable nút lưu để tránh click đúp
                btnSubmit.disabled = true;
                btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Đang xử lý...';

                // 2. Mở khóa các trường bị disable để gửi data
                document.querySelectorAll('.auto-field').forEach(el => {
                    el.removeAttribute('disabled');
                });
            });
        });
    </script>
}