@model SmartHealthMonitoring.ViewModels.PatientThresholdViewModel
@{
    ViewData["Title"] = "Cấu hình Ngưỡng - " + Model.PatientName;
}

@section Styles {
<style>
    .threshold-page {
        background: #f0f4f8;
        min-height: calc(100vh - 70px);
        padding-top: 100px;
        padding-bottom: 60px;
    }

    .patient-hero {
        background: linear-gradient(135deg, #1e40af 0%, #0ea5e9 100%);
        border-radius: 16px;
        padding: 28px 32px;
        color: white;
        position: relative;
        overflow: hidden;
        margin-bottom: 28px;
    }

    .patient-hero::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -60px;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: rgba(255,255,255,0.07);
    }

    .patient-hero::after {
        content: '';
        position: absolute;
        bottom: -40px;
        right: 80px;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }

    .section-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .section-header {
        padding: 20px 28px 18px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .section-body {
        padding: 24px 28px;
    }

    /* Threshold input group */
    .threshold-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .threshold-input-block {
        position: relative;
    }

    .threshold-input-block label {
        font-size: 0.82rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 8px;
        display: block;
    }

    .input-with-badge {
        position: relative;
    }

    .input-with-badge input {
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        padding: 10px 52px 10px 16px;
        font-size: 1rem;
        font-weight: 600;
        transition: border-color 0.2s;
        width: 100%;
    }

    .input-with-badge input:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(14,165,233,0.15);
    }

    .input-unit {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.75rem;
        font-weight: 600;
        color: #94a3b8;
        pointer-events: none;
    }

    .level-warning .threshold-input-block label { color: #d97706; }
    .level-warning input { border-color: #fcd34d !important; }
    .level-warning input:focus { box-shadow: 0 0 0 3px rgba(251,191,36,0.2) !important; }

    .level-danger .threshold-input-block label { color: #dc2626; }
    .level-danger input { border-color: #fca5a5 !important; }
    .level-danger input:focus { box-shadow: 0 0 0 3px rgba(239,68,68,0.2) !important; }

    .level-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        margin-bottom: 12px;
    }

    .level-label.warning { background: #fef3c7; color: #92400e; }
    .level-label.danger  { background: #fee2e2; color: #991b1b; }

    .metric-divider {
        border: 0;
        border-top: 2px dashed #f1f5f9;
        margin: 28px 0;
    }

    .helper-text {
        font-size: 0.78rem;
        color: #94a3b8;
        margin-top: 6px;
    }

    .config-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .btn-save-threshold {
        background: linear-gradient(135deg, #0ea5e9, #1e40af);
        border: none;
        color: white;
        padding: 14px 36px;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(14,165,233,0.35);
        transition: all 0.25s;
        width: 100%;
    }

    .btn-save-threshold:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(14,165,233,0.45);
        color: white;
    }

    .btn-save-threshold:active {
        transform: translateY(0);
    }

    .reference-table td, .reference-table th {
        padding: 8px 12px;
        font-size: 0.82rem;
    }

    .range-visual {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
        font-size: 0.78rem;
    }

    .range-bar {
        flex: 1;
        height: 6px;
        border-radius: 3px;
        background: linear-gradient(to right, #22c55e 0%, #22c55e 40%, #fbbf24 40%, #fbbf24 70%, #ef4444 70%);
    }

    @@media (max-width: 576px) {
        .threshold-row { grid-template-columns: 1fr; }
        .section-body { padding: 18px; }
    }
</style>
}

<div class="threshold-page">
    <div class="container" style="max-width: 860px;">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="DoctorDashboard" asp-action="Index" class="text-decoration-none text-muted">
                        Danh sách Bệnh nhân
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="ClinicalRecord" asp-action="Index" asp-route-id="@Model.PatientId"
                       class="text-decoration-none text-muted">
                        Hồ sơ @Model.PatientName
                    </a>
                </li>
                <li class="breadcrumb-item active fw-semibold text-primary" aria-current="page">Cấu hình Ngưỡng</li>
            </ol>
        </nav>

        <!-- Patient Hero -->
        <div class="patient-hero">
            <div class="d-flex align-items-center gap-4">
                <div class="bg-white bg-opacity-20 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width: 70px; height: 70px;">
                    <i class="fa-solid fa-user-doctor fs-2 text-white"></i>
                </div>
                <div class="flex-fill">
                    <h4 class="fw-bold mb-1">@Model.PatientName</h4>
                    <div class="d-flex flex-wrap gap-3" style="font-size: 0.9rem; opacity: 0.9;">
                        <span><i class="fa-solid fa-cake-candles me-1 opacity-75"></i> @Model.Age tuổi</span>
                        <span><i class="fa-solid fa-venus-mars me-1 opacity-75"></i> @Model.SexDisplay</span>
                        <span>
                            <i class="fa-solid fa-id-card me-1 opacity-75"></i>
                            Bệnh nhân #@Model.PatientId.ToString("D5")
                        </span>
                    </div>
                </div>
                <div>
                    @if (Model.IsConfigured)
                    {
                        <span class="config-status-badge bg-white bg-opacity-20 text-white">
                            <i class="fa-solid fa-circle-check"></i> Đã cấu hình
                        </span>
                    }
                    else
                    {
                        <span class="config-status-badge bg-white bg-opacity-20 text-white">
                            <i class="fa-solid fa-circle-exclamation"></i> Chưa cấu hình
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Audit Info Card -->
        @if (Model.IsConfigured)
        {
            <div class="section-card mb-4" style="border-left: 4px solid #0ea5e9;">
                <div class="section-body py-3">
                    <div class="row g-3 align-items-center">
                        <div class="col-auto">
                            <div class="section-icon" style="background: #eff6ff; color: #2563eb; width: 42px; height: 42px;">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                        </div>
                        <div class="col">
                            <div class="fw-bold text-dark mb-1" style="font-size: 0.9rem;">Thông tin cấu hình hiện tại</div>
                            <div class="d-flex flex-wrap gap-3" style="font-size: 0.82rem; color: #64748b;">
                                <span>
                                    <i class="fa-solid fa-hashtag me-1 text-primary opacity-75"></i>
                                    <strong class="text-dark">Threshold ID:</strong>
                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold ms-1">#@Model.ThresholdId</span>
                                </span>
                                <span>
                                    <i class="fa-solid fa-user-tie me-1 text-success opacity-75"></i>
                                    <strong class="text-dark">Bác sĩ:</strong>
                                    @if (!string.IsNullOrEmpty(Model.LastUpdatedByDoctor))
                                    {
                                        <span class="ms-1">
                                            BS. @Model.LastUpdatedByDoctor
                                            @if (Model.LastUpdatedByDoctorId.HasValue)
                                            {
                                                <span class="text-muted">(ID: #@Model.LastUpdatedByDoctorId)</span>
                                            }
                                            @if (!string.IsNullOrEmpty(Model.LastUpdatedByDoctorSpecialty))
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success ms-1">@Model.LastUpdatedByDoctorSpecialty</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted ms-1">Chưa rõ</span>
                                    }
                                </span>
                                <span>
                                    <i class="fa-solid fa-clock me-1 text-warning opacity-75"></i>
                                    <strong class="text-dark">Cập nhật:</strong>
                                    <span class="ms-1">@Model.LastUpdatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning border-0 rounded-3 shadow-sm mb-4" style="font-size: 0.88rem;">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong>Chưa có cấu hình riêng.</strong> Hệ thống đang dùng ngưỡng mặc định (WHO) cho bệnh nhân này.
                Hãy lưu cấu hình bên dưới để áp dụng ngưỡng phù hợp với tình trạng cụ thể.
            </div>
        }

        <!-- Validation errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger rounded-3 border-0 shadow-sm mb-4">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong>Vui lòng kiểm tra lại:</strong>
                <ul class="mb-0 mt-1">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@err.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="SettingPatientThreshold" method="post" id="thresholdForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="PatientName" />
            <input type="hidden" asp-for="Age" />
            <input type="hidden" asp-for="SexDisplay" />

            <!-- ===== HUYẾT ÁP TÂM THU ===== -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-icon" style="background: #fef2f2; color: #dc2626;">
                        <i class="fa-solid fa-gauge-high"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">Huyết áp Tâm Thu (Systolic BP)</h6>
                        <small class="text-muted">Áp lực khi tim co bóp, đo bằng mmHg</small>
                    </div>
                </div>
                <div class="section-body">
                    <div class="row g-4">
                        <div class="col-md-6 level-warning">
                            <div class="level-label warning">
                                <i class="fa-solid fa-triangle-exclamation"></i> Mức Cảnh báo
                            </div>
                            <div class="threshold-input-block">
                                <label asp-for="SystolicBpWarning">Từ giá trị này trở lên → Cảnh báo</label>
                                <div class="input-with-badge">
                                    <input asp-for="SystolicBpWarning" type="number" min="80" max="250"
                                           class="form-control" id="systolicWarning" />
                                    <span class="input-unit">mmHg</span>
                                </div>
                                <span asp-validation-for="SystolicBpWarning" class="text-danger small"></span>
                                <div class="helper-text">Khuyến nghị: 130 mmHg (Tăng huyết áp độ 1)</div>
                            </div>
                        </div>
                        <div class="col-md-6 level-danger">
                            <div class="level-label danger">
                                <i class="fa-solid fa-circle-exclamation"></i> Mức Nguy hiểm
                            </div>
                            <div class="threshold-input-block">
                                <label asp-for="SystolicBpDanger">Từ giá trị này trở lên → Nguy hiểm</label>
                                <div class="input-with-badge">
                                    <input asp-for="SystolicBpDanger" type="number" min="80" max="250"
                                           class="form-control" id="systolicDanger" />
                                    <span class="input-unit">mmHg</span>
                                </div>
                                <span asp-validation-for="SystolicBpDanger" class="text-danger small"></span>
                                <div class="helper-text">Khuyến nghị: 140 mmHg (Tăng huyết áp độ 2)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== HUYẾT ÁP TÂM TRƯƠNG ===== -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-icon" style="background: #fff7ed; color: #ea580c;">
                        <i class="fa-solid fa-gauge"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">Huyết áp Tâm Trương (Diastolic BP)</h6>
                        <small class="text-muted">Áp lực khi tim nghỉ giữa các nhịp, đo bằng mmHg</small>
                    </div>
                </div>
                <div class="section-body">
                    <div class="row g-4">
                        <div class="col-md-6 level-warning">
                            <div class="level-label warning">
                                <i class="fa-solid fa-triangle-exclamation"></i> Mức Cảnh báo
                            </div>
                            <div class="threshold-input-block">
                                <label asp-for="DiastolicBpWarning">Từ giá trị này trở lên → Cảnh báo</label>
                                <div class="input-with-badge">
                                    <input asp-for="DiastolicBpWarning" type="number" min="40" max="180"
                                           class="form-control" />
                                    <span class="input-unit">mmHg</span>
                                </div>
                                <span asp-validation-for="DiastolicBpWarning" class="text-danger small"></span>
                                <div class="helper-text">Khuyến nghị: 80 mmHg</div>
                            </div>
                        </div>
                        <div class="col-md-6 level-danger">
                            <div class="level-label danger">
                                <i class="fa-solid fa-circle-exclamation"></i> Mức Nguy hiểm
                            </div>
                            <div class="threshold-input-block">
                                <label asp-for="DiastolicBpDanger">Từ giá trị này trở lên → Nguy hiểm</label>
                                <div class="input-with-badge">
                                    <input asp-for="DiastolicBpDanger" type="number" min="40" max="180"
                                           class="form-control" />
                                    <span class="input-unit">mmHg</span>
                                </div>
                                <span asp-validation-for="DiastolicBpDanger" class="text-danger small"></span>
                                <div class="helper-text">Khuyến nghị: 90 mmHg</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== NHỊP TIM ===== -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-icon" style="background: #ecfdf5; color: #059669;">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">Nhịp Tim (Heart Rate)</h6>
                        <small class="text-muted">Cần cấu hình cả ngưỡng thấp (quá chậm) và ngưỡng cao (quá nhanh)</small>
                    </div>
                </div>
                <div class="section-body">

                    <!-- Nhịp tim THẤP -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                            <i class="fa-solid fa-arrow-down me-1"></i> Nhịp tim QUÁ THẤP
                        </span>
                        <small class="text-muted">— Bradycardia (nhịp chậm)</small>
                    </div>
                    <div class="row g-4 mb-2">
                        <div class="col-md-6 level-warning">
                            <div class="level-label warning">
                                <i class="fa-solid fa-triangle-exclamation"></i> Mức Cảnh báo
                            </div>
                            <div class="threshold-input-block">
                                <label asp-for="HeartRateWarningMin">Dưới giá trị này → Cảnh báo</label>
                                <div class="input-with-badge">
                                    <input asp-for="HeartRateWarningMin" type="number" min="20" max="100"
                                           class="form-control" />
                                    <span class="input-unit">bpm</span>
                                </div>
                                <span asp-validation-for="HeartRateWarningMin" class="text-danger small"></span>
                                <div class="helper-text">Khuyến nghị: 60 bpm</div>
                            </div>
                        </div>
                        <div class="col-md-6 level-danger">
                            <div class="level-label danger">
                                <i class="fa-solid fa-circle-exclamation"></i> Mức Nguy hiểm
                            </div>
                            <div class="threshold-input-block">
                                <label asp-for="HeartRateDangerMin">Dưới giá trị này → Nguy hiểm</label>
                                <div class="input-with-badge">
                                    <input asp-for="HeartRateDangerMin" type="number" min="20" max="100"
                                           class="form-control" />
                                    <span class="input-unit">bpm</span>
                                </div>
                                <span asp-validation-for="HeartRateDangerMin" class="text-danger small"></span>
                                <div class="helper-text">Khuyến nghị: 50 bpm</div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-light border rounded-3 py-2 px-3 mb-4" style="font-size: 0.82rem;">
                        <i class="fa-solid fa-circle-info text-info me-2"></i>
                        <strong>Lưu ý:</strong> Ngưỡng Nguy hiểm phải <strong>nhỏ hơn</strong> Ngưỡng Cảnh báo cho trường hợp nhịp tim thấp.
                    </div>

                    <hr class="metric-divider">

                    <!-- Nhịp tim CAO -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-danger px-3 py-2 rounded-pill">
                            <i class="fa-solid fa-arrow-up me-1"></i> Nhịp tim QUÁ CAO
                        </span>
                        <small class="text-muted">— Tachycardia (nhịp nhanh)</small>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6 level-warning">
                            <div class="level-label warning">
                                <i class="fa-solid fa-triangle-exclamation"></i> Mức Cảnh báo
                            </div>
                            <div class="threshold-input-block">
                                <label asp-for="HeartRateWarningMax">Trên giá trị này → Cảnh báo</label>
                                <div class="input-with-badge">
                                    <input asp-for="HeartRateWarningMax" type="number" min="80" max="250"
                                           class="form-control" />
                                    <span class="input-unit">bpm</span>
                                </div>
                                <span asp-validation-for="HeartRateWarningMax" class="text-danger small"></span>
                                <div class="helper-text">Khuyến nghị: 100 bpm</div>
                            </div>
                        </div>
                        <div class="col-md-6 level-danger">
                            <div class="level-label danger">
                                <i class="fa-solid fa-circle-exclamation"></i> Mức Nguy hiểm
                            </div>
                            <div class="threshold-input-block">
                                <label asp-for="HeartRateDangerMax">Trên giá trị này → Nguy hiểm</label>
                                <div class="input-with-badge">
                                    <input asp-for="HeartRateDangerMax" type="number" min="80" max="250"
                                           class="form-control" />
                                    <span class="input-unit">bpm</span>
                                </div>
                                <span asp-validation-for="HeartRateDangerMax" class="text-danger small"></span>
                                <div class="helper-text">Khuyến nghị: 120 bpm</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== THAM KHẢO ===== -->
            <div class="section-card">
                <div class="section-header">
                    <div class="section-icon" style="background: #f0fdf4; color: #16a34a;">
                        <i class="fa-solid fa-book-medical"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">Bảng tham khảo ngưỡng theo WHO</h6>
                        <small class="text-muted">Dùng làm cơ sở để bác sĩ điều chỉnh phù hợp bệnh nhân</small>
                    </div>
                </div>
                <div class="section-body">
                    <div class="table-responsive">
                        <table class="table table-sm reference-table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Chỉ số</th>
                                    <th class="text-success">Bình thường</th>
                                    <th class="text-warning">Cảnh báo</th>
                                    <th class="text-danger">Nguy hiểm</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>HA Tâm Thu</strong></td>
                                    <td class="text-success">< 130 mmHg</td>
                                    <td class="text-warning">130–139 mmHg</td>
                                    <td class="text-danger">≥ 140 mmHg</td>
                                </tr>
                                <tr>
                                    <td><strong>HA Tâm Trương</strong></td>
                                    <td class="text-success">< 80 mmHg</td>
                                    <td class="text-warning">80–89 mmHg</td>
                                    <td class="text-danger">≥ 90 mmHg</td>
                                </tr>
                                <tr>
                                    <td><strong>Nhịp tim</strong></td>
                                    <td class="text-success">60–100 bpm</td>
                                    <td class="text-warning">50–59 / 100–120 bpm</td>
                                    <td class="text-danger">< 50 / > 120 bpm</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3 p-3 rounded-3" style="background: #fffbeb; border: 1px solid #fde68a; font-size: 0.82rem;">
                        <i class="fa-solid fa-star text-warning me-2"></i>
                        <strong>Ghi chú lâm sàng:</strong> Đối với bệnh nhân cao tuổi (> 65 tuổi), vận động viên, hoặc có bệnh lý nền,
                        ngưỡng bình thường có thể khác biệt đáng kể. Bác sĩ cần điều chỉnh dựa trên tình trạng cụ thể.
                    </div>
                </div>
            </div>

            <!-- ===== ACTIONS ===== -->
            <div class="d-flex gap-3">
                <a asp-controller="ClinicalRecord" asp-action="Index" asp-route-id="@Model.PatientId"
                   class="btn btn-outline-secondary px-4 py-3 fw-semibold rounded-3 flex-shrink-0">
                    <i class="fa-solid fa-arrow-left me-2"></i> Hủy bỏ
                </a>
                <button type="submit" class="btn-save-threshold">
                    <i class="fa-solid fa-floppy-disk me-2"></i>
                    @(Model.IsConfigured ? "Cập nhật cấu hình ngưỡng" : "Lưu cấu hình ngưỡng")
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Real-time validation hint: Warning must be < Danger for BP
        function validateBpInputs(warningId, dangerId, label) {
            const warning = document.getElementById(warningId);
            const danger = document.getElementById(dangerId);
            if (!warning || !danger) return;

            function check() {
                if (parseInt(warning.value) >= parseInt(danger.value)) {
                    warning.style.borderColor = '#ef4444';
                    danger.style.borderColor = '#ef4444';
                } else {
                    warning.style.borderColor = '';
                    danger.style.borderColor = '';
                }
            }
            warning.addEventListener('input', check);
            danger.addEventListener('input', check);
        }

        validateBpInputs('SystolicBpWarning', 'SystolicBpDanger', 'Huyết áp TT');

        // Animate inputs on focus
        document.querySelectorAll('.input-with-badge input').forEach(input => {
            input.addEventListener('focus', () => {
                input.closest('.threshold-input-block')?.classList.add('focused');
            });
            input.addEventListener('blur', () => {
                input.closest('.threshold-input-block')?.classList.remove('focused');
            });
        });
    </script>
}
