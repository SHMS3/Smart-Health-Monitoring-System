@model SmartHealthMonitoring.ViewModels.Admin.PatientUiSettingsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Giao diện bệnh nhân";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Giao diện bệnh nhân</h1>
        <p class="text-muted mb-0">Cập nhật nội dung, hình ảnh và màu sắc đang hiển thị.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-primary">
        <i class="fas fa-arrow-up-right-from-square me-2"></i>Xem trang chủ
    </a>
</div>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<form asp-action="Save" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="HomeHeroImageUrl" type="hidden" />
    <input asp-for="HomeAboutImageUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Thương hiệu và điều hướng</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="BrandName" class="form-label">Tên thương hiệu</label>
                    <input asp-for="BrandName" class="form-control" />
                    <span asp-validation-for="BrandName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BrandSubtitle" class="form-label">Dòng mô tả ngắn</label>
                    <input asp-for="BrandSubtitle" class="form-control" />
                    <span asp-validation-for="BrandSubtitle" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="MetaDescription" class="form-label">Mô tả trang</label>
                    <textarea asp-for="MetaDescription" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="MetaDescription" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SearchPlaceholder" class="form-label">Gợi ý ô tìm kiếm</label>
                    <input asp-for="SearchPlaceholder" class="form-control" />
                    <span asp-validation-for="SearchPlaceholder" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LogoIcon" class="form-label">Biểu tượng logo</label>
                    <select asp-for="LogoIcon" asp-items="Model.LogoIconOptions" class="form-select"></select>
                    <span asp-validation-for="LogoIcon" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Hero trang chủ</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HomeHeroEyebrow" class="form-label">Nhãn nhỏ</label>
                    <input asp-for="HomeHeroEyebrow" class="form-control" />
                    <span asp-validation-for="HomeHeroEyebrow" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HomeHeroPriceTag" class="form-label">Nhãn gói</label>
                    <input asp-for="HomeHeroPriceTag" class="form-control" />
                    <span asp-validation-for="HomeHeroPriceTag" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HomeHeroTitle" class="form-label">Tiêu đề</label>
                    <input asp-for="HomeHeroTitle" class="form-control" />
                    <span asp-validation-for="HomeHeroTitle" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HomeHeroHighlight" class="form-label">Phần nhấn mạnh</label>
                    <input asp-for="HomeHeroHighlight" class="form-control" />
                    <span asp-validation-for="HomeHeroHighlight" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="HomeHeroPrice" class="form-label">Giá / ưu đãi</label>
                    <input asp-for="HomeHeroPrice" class="form-control" />
                    <span asp-validation-for="HomeHeroPrice" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="HomeHeroPriceSuffix" class="form-label">Hậu tố giá</label>
                    <input asp-for="HomeHeroPriceSuffix" class="form-control" />
                    <span asp-validation-for="HomeHeroPriceSuffix" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="HomeHeroNote" class="form-label">Ghi chú</label>
                    <input asp-for="HomeHeroNote" class="form-control" />
                    <span asp-validation-for="HomeHeroNote" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="HomeHeroImageFile" class="form-label">Ảnh hero</label>
                    <input asp-for="HomeHeroImageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
                    <span asp-validation-for="HomeHeroImageFile" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <img src="@Model.HomeHeroImageUrl" alt="Ảnh hero hiện tại" class="img-fluid rounded border" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Giới thiệu và lời kêu gọi</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HomeAboutTag" class="form-label">Nhãn giới thiệu</label>
                    <input asp-for="HomeAboutTag" class="form-control" />
                    <span asp-validation-for="HomeAboutTag" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HomeAboutTitle" class="form-label">Tiêu đề giới thiệu</label>
                    <input asp-for="HomeAboutTitle" class="form-control" />
                    <span asp-validation-for="HomeAboutTitle" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="HomeAboutDescription" class="form-label">Mô tả giới thiệu</label>
                    <textarea asp-for="HomeAboutDescription" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="HomeAboutDescription" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="HomeAboutImageFile" class="form-label">Ảnh giới thiệu</label>
                    <input asp-for="HomeAboutImageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
                    <span asp-validation-for="HomeAboutImageFile" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <img src="@Model.HomeAboutImageUrl" alt="Ảnh giới thiệu hiện tại" class="img-fluid rounded border" />
                </div>
                <div class="col-md-6">
                    <label asp-for="HomeCtaTitle" class="form-label">Tiêu đề CTA</label>
                    <input asp-for="HomeCtaTitle" class="form-control" />
                    <span asp-validation-for="HomeCtaTitle" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HomeCtaDescription" class="form-label">Mô tả CTA</label>
                    <textarea asp-for="HomeCtaDescription" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="HomeCtaDescription" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Màu sắc và tiện ích</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6 col-lg">
                    <label asp-for="PrimaryColor" class="form-label">Chủ đạo</label>
                    <input asp-for="PrimaryColor" type="color" class="form-control form-control-color w-100" />
                    <span asp-validation-for="PrimaryColor" class="text-danger"></span>
                </div>
                <div class="col-6 col-lg">
                    <label asp-for="PrimaryDarkColor" class="form-label">Chủ đạo đậm</label>
                    <input asp-for="PrimaryDarkColor" type="color" class="form-control form-control-color w-100" />
                    <span asp-validation-for="PrimaryDarkColor" class="text-danger"></span>
                </div>
                <div class="col-6 col-lg">
                    <label asp-for="NavigationColor" class="form-label">Điều hướng</label>
                    <input asp-for="NavigationColor" type="color" class="form-control form-control-color w-100" />
                    <span asp-validation-for="NavigationColor" class="text-danger"></span>
                </div>
                <div class="col-6 col-lg">
                    <label asp-for="AccentColor" class="form-label">Cảnh báo</label>
                    <input asp-for="AccentColor" type="color" class="form-control form-control-color w-100" />
                    <span asp-validation-for="AccentColor" class="text-danger"></span>
                </div>
                <div class="col-6 col-lg">
                    <label asp-for="BackgroundColor" class="form-label">Nền</label>
                    <input asp-for="BackgroundColor" type="color" class="form-control form-control-color w-100" />
                    <span asp-validation-for="BackgroundColor" class="text-danger"></span>
                </div>
                <div class="col-12 d-flex flex-wrap gap-4 pt-2">
                    <div class="form-check form-switch">
                        <input asp-for="ShowTopInfoBar" class="form-check-input" />
                        <label asp-for="ShowTopInfoBar" class="form-check-label">Thanh thông tin</label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="ShowAiChatbot" class="form-check-input" />
                        <label asp-for="ShowAiChatbot" class="form-check-label">AI chatbot</label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="ShowSupportHub" class="form-check-input" />
                        <label asp-for="ShowSupportHub" class="form-check-label">Trung tâm hỗ trợ</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Liên hệ và chân trang</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FooterSubtitle" class="form-label">Phụ đề chân trang</label>
                    <input asp-for="FooterSubtitle" class="form-control" />
                    <span asp-validation-for="FooterSubtitle" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="HotlineLabel" class="form-label">Nhãn hotline</label>
                    <input asp-for="HotlineLabel" class="form-control" />
                    <span asp-validation-for="HotlineLabel" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="HotlinePhone" class="form-label">Số hotline</label>
                    <input asp-for="HotlinePhone" class="form-control" />
                    <span asp-validation-for="HotlinePhone" class="text-danger"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="ContactEmail" class="form-label">Email</label>
                    <input asp-for="ContactEmail" class="form-control" />
                    <span asp-validation-for="ContactEmail" class="text-danger"></span>
                </div>
                <div class="col-md-7">
                    <label asp-for="Address" class="form-label">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="FooterDescription" class="form-label">Mô tả chân trang</label>
                    <textarea asp-for="FooterDescription" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="FooterDescription" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FooterLicenseText" class="form-label">Thông tin pháp lý</label>
                    <textarea asp-for="FooterLicenseText" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="FooterLicenseText" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FooterBottomText" class="form-label">Dòng cuối chân trang</label>
                    <textarea asp-for="FooterBottomText" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="FooterBottomText" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between gap-2 mb-4">
        <button type="submit"
                formaction="@Url.Action("Reset")"
                formnovalidate
                onclick="return confirm('Khôi phục toàn bộ cấu hình mặc định?')"
                class="btn btn-outline-danger">
            Khôi phục mặc định
        </button>
        <button type="submit" class="btn btn-primary px-4">
            <i class="fas fa-save me-2"></i>Lưu thay đổi
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
