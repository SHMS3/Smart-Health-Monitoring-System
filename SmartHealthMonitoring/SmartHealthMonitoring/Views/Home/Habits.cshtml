@model SmartHealthMonitoring.ViewModels.HabitViewModel
@{
    ViewData["Title"] = "Thói quen Sinh hoạt";
}

<div class="container-fluid px-4 py-4" style="min-height: 80vh; max-width: 1400px; margin: 0 auto;">
    <div style="background:white; border-radius:16px; padding:36px 40px; box-shadow:0 8px 30px rgba(26,115,200,0.06); border:1px solid #e0eaf4;">
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center mb-4" role="alert" style="border-radius:10px; font-weight:500;">
                <i class="fas fa-check-circle me-2 fa-lg"></i>
                <div>
                    @TempData["SuccessMessage"]
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert" style="border-radius:10px; font-weight:500;">
                <i class="fas fa-exclamation-circle me-2 fa-lg"></i>
                <div>
                    @TempData["ErrorMessage"]
                </div>
            </div>
        }

        <div class="d-flex align-items-center mb-2" style="gap:15px;">
            <div style="width: 50px; height: 50px; background: #eef6ff; color: #1a73c8; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                <i class="fas fa-heartbeat"></i>
            </div>
            <h2 style="font-size: 1.5rem; font-weight: 800; color: #1a2340; margin:0;">THÓI QUEN SINH HOẠT</h2>
        </div>
        
        <p style="color: #607080; font-size: 0.95rem; margin-bottom: 30px; margin-top:10px; border-bottom: 1px solid #e0eaf4; padding-bottom: 20px;">
            Đánh dấu các thói quen hiện tại của bạn. Trí tuệ nhân tạo (AI) sẽ sử dụng thông tin này để đưa ra lời khuyên <strong>cá nhân hóa</strong> chính xác nhất, giúp bạn cải thiện và bảo vệ sức khỏe tim mạch.
        </p>

        @{
            ViewBag.Source = "habits";
        }
        @await Html.PartialAsync("_HabitForm", Model)
    </div>
</div>
