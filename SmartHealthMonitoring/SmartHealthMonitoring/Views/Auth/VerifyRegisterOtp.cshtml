@model SmartHealthMonitoring.ViewModels.VerifyRegisterOtpViewModel
@{
    ViewData["Title"] = "Xác thực OTP Đăng ký";
    Layout = "~/Views/Shared/_EmbedLayout.cshtml";
}

<div class="container-fluid bg-light min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-8 col-lg-5 col-xl-4">
            <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-block bg-success bg-opacity-10 p-3 rounded-circle mb-3">
                            <i class="fas fa-check-circle text-success fs-2"></i>
                        </div>
                        <h2 class="fw-bold text-dark">Xác thực Đăng ký</h2>
                        <p class="text-muted mb-0">Mã xác thực 6 số đã được gửi đến email:</p>
                        <p class="fw-bold text-success">@Model.Email</p>
                    </div>

                    <form asp-action="VerifyRegisterOtp" method="post" id="otpForm">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger p-3 mb-4 rounded-3" style="font-size: 0.85rem;">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <strong>Lỗi:</strong>
                                <div asp-validation-summary="All" class="mt-1 mb-0"></div>
                            </div>
                        }
                        
                        <input type="hidden" asp-for="Email" id="hiddenEmail" />
                        
                        <div class="mb-4 text-center">
                            <label class="form-label fw-bold text-dark mb-3">Nhập mã xác thực</label>
                            <input type="text" asp-for="OtpCode" class="form-control form-control-lg text-center fw-bold fs-3 letter-spacing-lg" 
                                   maxlength="6" placeholder="------" style="letter-spacing: 10px; border-radius: 12px; border-color: #cbd5e1; background-color: #f8fafc;" />
                            <span asp-validation-for="OtpCode" class="text-danger small mt-2 d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-3 mb-4 fw-bold rounded-3 shadow-sm">
                            Xác thực và Tạo tài khoản
                        </button>

                        <div class="text-center p-3 bg-light rounded-3 border" style="border-style: dashed !important;">
                            <p class="text-muted small mb-2">Bạn chưa nhận được mã?</p>
                            <div class="d-flex align-items-center justify-content-center gap-2">
                                <span id="countdownText" class="text-secondary fw-semibold small">Gửi lại sau <span id="countdown" class="text-success">60</span>s</span>
                                <button type="button" id="btnResend" class="btn btn-sm btn-outline-success fw-bold d-none">
                                    <i class="fas fa-redo-alt me-1"></i> Gửi lại mã
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            let timeLeft = 60;
            const $countdown = $('#countdown');
            const $countdownText = $('#countdownText');
            const $btnResend = $('#btnResend');
            const userEmail = $('#hiddenEmail').val();

            function updateTimer() {
                if (timeLeft > 0) {
                    $countdown.text(timeLeft);
                    timeLeft--;
                    setTimeout(updateTimer, 1000);
                } else {
                    $countdownText.addClass('d-none');
                    $btnResend.removeClass('d-none');
                }
            }
            updateTimer();

            $btnResend.click(function () {
                const $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang gửi...');

                $.post('/Auth/ResendRegisterOtp', { 
                    email: userEmail,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
                })
                .done(function (res) {
                    if (res.success) {
                        alert(res.message);
                        timeLeft = 60;
                        $btn.addClass('d-none').prop('disabled', false).html('<i class="fas fa-redo-alt me-1"></i> Gửi lại mã');
                        $countdownText.removeClass('d-none');
                        updateTimer();
                    } else {
                        alert(res.message);
                        $btn.prop('disabled', false).html('<i class="fas fa-redo-alt me-1"></i> Gửi lại mã');
                    }
                })
                .fail(function () {
                    alert('Đã có lỗi xảy ra. Vui lòng thử lại sau.');
                    $btn.prop('disabled', false).html('<i class="fas fa-redo-alt me-1"></i> Gửi lại mã');
                });
            });
        });
    </script>
}
