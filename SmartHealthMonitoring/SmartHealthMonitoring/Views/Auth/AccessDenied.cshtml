@{
    ViewData["Title"] = "Truy cập bị từ chối";
}

@section Styles {
    <style>
        .denied-wrapper {
            margin-top: 70px;
            min-height: calc(100vh - 70px);
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #fef2f2 0%, #fff1f2 50%, #fef2f2 100%);
            padding: 40px 20px;
        }

        .denied-card {
            max-width: 520px;
            width: 100%;
            text-align: center;
            background: #fff;
            border-radius: 24px;
            padding: 56px 40px;
            box-shadow: 0 25px 60px rgba(0,0,0,.06), 0 0 0 1px rgba(0,0,0,.03);
        }

        .denied-icon {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            background: rgba(239,68,68,.1);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }

        .denied-icon i {
            font-size: 2rem;
            color: #ef4444;
        }

        .denied-card h1 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 10px;
        }

        .denied-card p {
            color: #64748b;
            font-size: .92rem;
            line-height: 1.7;
            margin-bottom: 32px;
        }

        .denied-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-back {
            padding: 12px 28px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0ea5e9, #6366f1);
            color: #fff;
            font-size: .9rem;
            font-weight: 700;
            border: none;
            box-shadow: 0 4px 14px rgba(14,165,233,.3);
            transition: all .3s;
            cursor: pointer;
        }

        .btn-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(14,165,233,.4);
            color: #fff;
        }

        .btn-home {
            padding: 12px 28px;
            border-radius: 12px;
            background: transparent;
            color: #475569;
            font-size: .9rem;
            font-weight: 600;
            border: 1.5px solid #e2e8f0;
            transition: all .2s;
        }

        .btn-home:hover {
            border-color: #0ea5e9;
            color: #0ea5e9;
            background: rgba(14,165,233,.04);
        }
    </style>
}

<div class="denied-wrapper">
    <div class="denied-card">
        <div class="denied-icon">
            <i class="fas fa-shield-alt"></i>
        </div>
        <h1>Truy cập bị từ chối</h1>
        <p>Bạn không có quyền truy cập trang này. Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là lỗi.</p>
        <div class="denied-actions">
            <a asp-controller="Home" asp-action="Index" class="btn-back">
                <i class="fas fa-home me-2"></i>Về trang chủ
            </a>
            <a asp-controller="Auth" asp-action="Login" class="btn-home">
                <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập lại
            </a>
        </div>
    </div>
</div>
