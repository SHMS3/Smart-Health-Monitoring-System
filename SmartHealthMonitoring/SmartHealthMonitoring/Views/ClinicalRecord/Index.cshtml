@model SmartHealthMonitoring.ViewModels.PatientRecordIndexViewModel
@{
    ViewData["Title"] = "Hồ sơ Y tế - " + Model.PatientName;
}

@section Styles {
    <style>
        .patient-card {
            background: linear-gradient(to right, #f8fafc, #eff6ff);
            border-left: 5px solid #0ea5e9;
        }

        .table-modern {
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        .table-modern thead th {
            border: none;
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            padding: 12px 20px;
        }

        .table-modern tbody tr {
            background: #ffffff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
            border-radius: 12px;
            transition: all 0.2s ease;
        }

        .table-modern tbody tr:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(14,165,233,0.1);
        }

        .table-modern tbody td {
            border: none;
            padding: 16px 20px;
            vertical-align: middle;
        }

        .table-modern tbody td:first-child {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
        }

        .table-modern tbody td:last-child {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
        }

        .badge-soft-primary { background: #e0f2fe; color: #0369a1; }
        .badge-soft-danger { background: #fee2e2; color: #b91c1c; }
        .badge-soft-warning { background: #fef3c7; color: #b45309; }

        /* Style riêng cho Tab */
        .nav-pills .nav-link { color: #64748b; transition: all 0.3s; }
        .nav-pills .nav-link.active { 
            background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%) !important; 
            box-shadow: 0 4px 10px rgba(14, 165, 233, 0.3);
        }

        .btn-add-record {
            background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);
            border: none;
            color: white;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
            transition: all 0.3s;
        }

        .btn-add-record:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(14, 165, 233, 0.4);
            color: white;
        }
        
        .modal-detail-group {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 16px;
            height: 100%;
        }
        
        .modal-detail-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #475569;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-eye-toggle {
            width: 32px;
            height: 32px;
            padding: 0;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            border: none;
        }

        .btn-eye-toggle.visible {
            background: #e0f2fe;
            color: #0369a1;
        }

        .btn-eye-toggle.visible:hover {
            background: #0369a1;
            color: white;
            transform: scale(1.1);
        }

        .btn-eye-toggle.hidden {
            background: #f1f5f9;
            color: #94a3b8;
        }

        .btn-eye-toggle.hidden:hover {
            background: #e2e8f0;
            color: #64748b;
            transform: scale(1.1);
        }

        .toggle-confirm-modal .modal-header {
            border-radius: 16px 16px 0 0;
        }
    </style>
}

<div class="container pt-5 mt-4 pb-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    @if (User.IsInRole("1"))
                    {
                        <li class="breadcrumb-item">
                            <a asp-controller="DoctorDashboard" asp-action="Index" class="text-decoration-none text-muted">Danh sách Bệnh nhân</a>
                        </li>
                    }
                </ol>
            </nav>
            <h2 class="h3 mb-0 fw-bold text-dark">Hồ sơ Bệnh án</h2>
        </div>
        <div>
            @if (User.IsInRole("1"))
            {
                <a asp-controller="ClinicalExam"
                   asp-action="Create"
                   asp-route-patientId="@Model.PatientId"
                   class="btn btn-add-record me-2">
                    <i class="fas fa-notes-medical me-1"></i> Thêm mới Hồ sơ
                </a>

                <a asp-controller="ClinicalExam"
                   asp-action="SettingPatientThreshold"
                   asp-route-patientId="@Model.PatientId"
                   class="btn btn-warning fw-bold text-dark shadow-sm">
                    <i class="fas fa-cog me-1"></i> Cấu hình ngưỡng
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4 patient-card">
        <div class="card-body p-4 d-flex align-items-center gap-4">
            <div class="bg-white rounded-circle d-flex justify-content-center align-items-center shadow-sm flex-shrink-0" style="width: 70px; height: 70px;">
                <i class="fas fa-user-injured text-primary" style="font-size: 1.8rem;"></i>
            </div>
            <div>
                <h4 class="mb-1 fw-bold text-dark">@Model.PatientName</h4>
                <div class="d-flex flex-wrap gap-3 text-muted mt-2">
                    <span class="bg-white px-3 py-1 rounded-pill border small fw-medium shadow-sm">
                        <i class="fas fa-id-card text-secondary me-1"></i> ID: #@Model.PatientId.ToString("D5")
                    </span>
                    <span class="bg-white px-3 py-1 rounded-pill border small fw-medium shadow-sm">
                        <i class="fas fa-calendar-alt text-primary me-1"></i> @Model.Age tuổi
                    </span>
                    <span class="bg-white px-3 py-1 rounded-pill border small fw-medium shadow-sm">
                        @if (Model.SexDisplay == "Nam")
                        {
                            <i class="fas fa-mars text-info me-1"></i>
                        }
                        else
                        {
                            <i class="fas fa-venus text-danger me-1"></i>
                        }
                        @Model.SexDisplay
                    </span>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-pills mb-4" id="recordTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 fw-bold" id="clinical-tab" data-bs-toggle="pill" data-bs-target="#clinical-content" type="button" role="tab">
                <i class="fas fa-stethoscope me-2"></i> Cận lâm sàng (Tại viện)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-bold ms-2" id="diary-tab" data-bs-toggle="pill" data-bs-target="#diary-content" type="button" role="tab">
                <i class="fas fa-home me-2"></i> Sổ tay theo dõi (Tại nhà)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="recordTabsContent">

        <div class="tab-pane fade show active" id="clinical-content" role="tabpanel" tabindex="0">
            <div class="card border-0 shadow-sm bg-transparent">
                <div class="table-responsive">
                    <table class="table table-modern align-middle mb-0 text-nowrap">
                        <thead>
                            <tr>
                                <th class="ps-4">Ngày khám</th>
                                <th>Huyết áp</th>
                                <th>Cholesterol</th>
                                <th>Nhịp tim tối đa</th>
                                <th>Triệu chứng đau ngực</th>
                                <th class="text-end pe-4">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Records.Items.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 bg-white rounded-4 shadow-sm border-0">
                                        <div class="text-muted mb-3 mt-3">
                                            <i class="fas fa-folder-open opacity-25" style="font-size: 3rem;"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark">Chưa có dữ liệu</h6>
                                        <p class="text-muted small mb-3">Bệnh nhân này chưa có hồ sơ khám bệnh nào được ghi nhận.</p>
                                    </td>
                                </tr>
                            }
                            
                            @foreach (var record in Model.Records.Items)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@record.VisitDate.ToString("dd/MM/yyyy")</div>
                                        <div class="text-muted small"><i class="far fa-clock me-1"></i> @record.VisitDate.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@record.RestingBP</span> <span class="text-muted small">mmHg</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@record.Cholesterol</span> <span class="text-muted small">mg/dl</span>
                                    </td>
                                    <td>
                                        @if(record.MaxHeartRate > 150)
                                        {
                                            <span class="badge badge-soft-danger px-2 py-1 rounded-3 border border-danger border-opacity-25"><i class="fas fa-heartbeat me-1"></i> @record.MaxHeartRate bpm</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-dark">@record.MaxHeartRate</span> <span class="text-muted small">bpm</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-soft-primary px-3 py-2 rounded-pill border border-primary border-opacity-25">
                                            @record.ChestPainTypeDisplay
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light text-primary fw-bold rounded-pill px-3 shadow-sm me-2" data-bs-toggle="modal" data-bs-target="#detailModal-@record.Id">
                                            <i class="fas fa-eye me-1"></i> Chi tiết
                                        </button>

                                        @if (User.IsInRole("1"))
                                        {
                                            <form asp-action="Delete" asp-route-id="@record.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn đánh dấu hồ sơ này là HỦY BỎ?');">
                                                <button type="submit" class="btn btn-sm btn-light text-danger rounded-circle shadow-sm" style="width: 32px; height: 32px; padding: 0;" title="Hủy hồ sơ">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }

                                        @if (User.IsInRole("1"))
                                        {
                                            <button type="button"
                                                    class="btn btn-eye-toggle @(record.IsViewForPatient ? "visible" : "hidden") shadow-sm me-2"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#toggleViewModal-@record.Id"
                                                    title="@(record.IsViewForPatient ? "Đang cho bệnh nhân xem - Click để ẩn" : "Đang ẩn với bệnh nhân - Click để cho phép xem")">
                                                <i class="fas @(record.IsViewForPatient ? "fa-eye" : "fa-eye-slash")"></i>
                                            </button>

                                            <form asp-action="Delete" asp-route-id="@record.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn đánh dấu hồ sơ này là HỦY BỎ?');">
                                                <button type="submit" class="btn btn-sm btn-light text-danger rounded-circle shadow-sm" style="width: 32px; height: 32px; padding: 0;" title="Hủy hồ sơ">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Records.TotalPages > 1)
                {
                    <div class="card-footer bg-white border-0 shadow-sm rounded-4 p-4 mt-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                        <span class="text-muted small">
                            Hiển thị trang <strong>@Model.Records.Page</strong> / @Model.Records.TotalPages (Tổng số: <strong>@Model.Records.TotalCount</strong> hồ sơ)
                        </span>
                        
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.Records.Page == 1 ? "disabled" : "")">
                                    <a class="page-link rounded-start-pill px-3" asp-action="Index" asp-route-id="@Model.PatientId" asp-route-page="@(Model.Records.Page - 1)">Trước</a>
                                </li>

                                @for (int i = 1; i <= Model.Records.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.Records.Page ? "active" : "")">
                                        <a class="page-link px-3" asp-action="Index" asp-route-id="@Model.PatientId" asp-route-page="@i">@i</a>
                                    </li>
                                }

                                <li class="page-item @(Model.Records.Page == Model.Records.TotalPages ? "disabled" : "")">
                                    <a class="page-link rounded-end-pill px-3" asp-action="Index" asp-route-id="@Model.PatientId" asp-route-page="@(Model.Records.Page + 1)">Sau</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="diary-content" role="tabpanel" tabindex="0">
            <div class="card border-0 shadow-sm rounded-4 bg-transparent">
                <div class="table-responsive">
                    <table class="table table-modern align-middle mb-0 text-nowrap">
                        <thead>
                            <tr>
                                <th class="ps-4">Thời gian ghi</th>
                                <th>Huyết áp (Thu/Trương)</th>
                                <th>Nhịp tim tĩnh</th>
                                <th>Triệu chứng tự báo</th>
                                <th class="text-end pe-4">Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.DailyLogs.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 bg-white rounded-4 shadow-sm border-0">
                                        <div class="text-muted mb-3 mt-3">
                                            <i class="fas fa-book-medical opacity-25" style="font-size: 3rem;"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark">Chưa có dữ liệu sổ tay</h6>
                                        <p class="text-muted small mb-3">Bệnh nhân chưa ghi nhận chỉ số nào tại nhà.</p>
                                    </td>
                                </tr>
                            }
                            
                            @foreach(var log in Model.DailyLogs)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@log.LoggedAt.ToString("dd/MM/yyyy")</div>
                                        <div class="text-muted small"><i class="far fa-clock me-1"></i> @log.LoggedAt.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <span class="text-danger fw-bold fs-6">@log.SystolicBp</span> 
                                        <span class="text-muted mx-1">/</span> 
                                        <span class="text-dark fw-bold">@log.DiastolicBp</span> 
                                        <span class="text-muted small">mmHg</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@log.HeartRate</span> <span class="text-muted small">bpm</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border border-secondary border-opacity-25 px-2 py-1">
                                            Mức độ đau: @log.ChestPainLevel
                                        </span>
                                        @if(log.HasExerciseAngina) 
                                        { 
                                            <span class="badge bg-warning text-dark ms-1 px-2 py-1 shadow-sm">
                                                <i class="fas fa-bolt text-danger me-1"></i>Đau khi vận động
                                            </span> 
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if(log.UpdateCount > 0)
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1" title="Bệnh nhân đã sửa lại kết quả này">
                                                <i class="fas fa-pen-alt me-1"></i> Đã sửa (@log.UpdateCount)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Bản ghi gốc</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@foreach (var record in Model.Records.Items)
{
    <div class="modal fade text-start" id="detailModal-@record.Id" tabindex="-1" aria-hidden="true" aria-labelledby="modalLabel-@record.Id">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                
                <div class="modal-header border-bottom bg-light rounded-top-4 p-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-1" id="modalLabel-@record.Id">Chi tiết Hồ sơ Xét nghiệm</h5>
                        <p class="text-muted small mb-0">
                            <i class="far fa-calendar-alt me-1"></i> Khám ngày: @record.VisitDate.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="modal-detail-group">
                                <div class="modal-detail-title text-danger"><i class="fas fa-heartbeat me-2"></i>Sinh hiệu & Triệu chứng</div>
                                <ul class="list-unstyled mb-0 small">
                                    <li class="mb-3 d-flex justify-content-between border-bottom pb-2">
                                        <span class="text-muted">Đau ngực:</span> <strong class="text-dark text-end">@record.ChestPainTypeDisplay</strong>
                                    </li>
                                    <li class="mb-3 d-flex justify-content-between border-bottom pb-2">
                                        <span class="text-muted">Huyết áp nghỉ:</span> <strong class="text-dark">@record.RestingBP mmHg</strong>
                                    </li>
                                    <li class="mb-3 d-flex justify-content-between border-bottom pb-2">
                                        <span class="text-muted">Nhịp tim MAX:</span> <strong class="text-danger">@record.MaxHeartRate bpm</strong>
                                    </li>
                                    <li class="d-flex justify-content-between">
                                        <span class="text-muted">Đau ngực gắng sức:</span> <strong class="text-dark">@(record.ExerciseAngina == 1 ? "Có (Yes)" : "Không")</strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="modal-detail-group">
                                <div class="modal-detail-title text-info"><i class="fas fa-tint me-2"></i>Huyết học</div>
                                <ul class="list-unstyled mb-0 small">
                                    <li class="mb-3 d-flex justify-content-between border-bottom pb-2">
                                        <span class="text-muted">Cholesterol:</span> <strong class="text-dark">@record.Cholesterol mg/dl</strong>
                                    </li>
                                    <li class="d-flex justify-content-between">
                                        <span class="text-muted">Đường huyết đói >120:</span> 
                                        <strong class="@(record.FastingBS == 1 ? "text-danger" : "text-success")">
                                            @(record.FastingBS == 1 ? "Cao" : "Bình thường")
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Cột 3: Điện tâm đồ & Mạch vành -->
                        <div class="col-md-4">
                            <div class="modal-detail-group">
                                <div class="modal-detail-title text-primary"><i class="fas fa-wave-square me-2"></i>Điện tâm đồ & Mạch</div>
                                <ul class="list-unstyled mb-3 small">
                                    <li class="mb-3 d-flex justify-content-between border-bottom pb-2">
                                        <span class="text-muted">ECG nghỉ:</span> 
                                        <strong class="text-dark text-end ms-2">@(record.RestECG == 0 ? "Normal" : record.RestECG == 1 ? "ST-T" : "LVH")</strong>
                                    </li>
                                    <li class="mb-3 d-flex justify-content-between border-bottom pb-2">
                                        <span class="text-muted">Độ dốc ST:</span> <strong class="text-dark text-end">@(record.STSlope == 1 ? "Upsloping" : record.STSlope == 2 ? "Flat" : "Downsloping")</strong>
                                    </li>
                                    <li class="mb-3 d-flex justify-content-between border-bottom pb-2">
                                        <span class="text-muted">OldPeak:</span> <strong class="text-dark">@record.OldPeak</strong>
                                    </li>
                                    <li class="mb-3 d-flex justify-content-between border-bottom pb-2">
                                        <span class="text-muted">Mạch vành (0-3):</span> <strong class="text-dark">@record.MajorVessels</strong>
                                    </li>
                                    <li class="d-flex justify-content-between">
                                        <span class="text-muted">Thal:</span> 
                                        <strong class="text-dark text-end ms-2">@(record.ThalResult == 1 ? "Normal" : record.ThalResult == 2 ? "Fixed Defect" : "Reversable")</strong>
                                    </li>
                                </ul>

                                @if (!string.IsNullOrEmpty(record.EcgImageUrl))
                                {
                                    <button class="btn btn-sm btn-outline-primary w-100 fw-bold mt-2" type="button" data-bs-toggle="collapse" data-bs-target="#ecgImage-@record.Id">
                                        <i class="fas fa-image me-2"></i> Xem biểu đồ ECG gốc
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(record.EcgImageUrl))
                    {
                        <div class="collapse mt-4" id="ecgImage-@record.Id">
                            <div class="card card-body bg-light border-0 rounded-4">
                                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-file-medical-alt text-primary me-2"></i>Biểu đồ Điện tâm đồ (ECG/EKG)</h6>
                                
                                <img src="@record.EcgImageUrl" alt="Biểu đồ ECG" class="img-fluid rounded border shadow-sm" style="max-height: 400px; object-fit: contain; width: 100%; background: #fff;" />
                                
                                <div class="text-end mt-2">
                                    <a href="@record.EcgImageUrl" target="_blank" class="btn btn-sm btn-link text-decoration-none">
                                        Mở ảnh phóng to <i class="fas fa-external-link-alt ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- KHU VỰC HIỂN THỊ TÀI LIỆU ĐÍNH KÈM / ẢNH BIẾN CHỨNG -->
                    @if (!string.IsNullOrEmpty(record.AttachmentUrl))
                    {
                        <div class="mt-4 pt-4 border-top">
                            <h6 class="fw-bold text-dark mb-3"><i class="fas fa-paperclip text-info me-2"></i>Tài liệu / Ảnh biến chứng lâm sàng đính kèm</h6>
                            @if (record.AttachmentUrl.Contains(".pdf"))
                            {
                                <a href="@record.AttachmentUrl" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-4 fw-bold shadow-sm">
                                    <i class="fas fa-file-pdf me-2"></i> Mở tệp hồ sơ đính kèm (PDF)
                                </a>
                            }
                            else
                            {
                                <div class="text-center bg-white p-3 rounded-4 border border-secondary border-opacity-25 shadow-sm">
                                    <img src="@record.AttachmentUrl" alt="Ảnh biến chứng lâm sàng" class="img-fluid rounded" style="max-height: 350px; object-fit: contain;" />
                                    <div class="mt-3 text-end">
                                        <a href="@record.AttachmentUrl" target="_blank" class="btn btn-sm btn-light text-primary fw-bold text-decoration-none rounded-pill px-3 shadow-sm">
                                            Mở ảnh gốc phóng to <i class="fas fa-external-link-alt ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                
                <div class="modal-footer border-top-0 pt-0 pb-4 pe-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4 fw-medium" data-bs-dismiss="modal">Đóng lại</button>
                </div>
            </div>
        </div>
    </div>

    @if (User.IsInRole("1"))
    {
        <div class="modal fade toggle-confirm-modal" id="toggleViewModal-@record.Id" tabindex="-1" aria-hidden="true" aria-labelledby="toggleModalLabel-@record.Id">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
                <div class="modal-content rounded-4 border-0 shadow-lg">

                    <div class="modal-header border-0 pb-0 p-4 @(record.IsViewForPatient ? "bg-warning-subtle" : "bg-success-subtle")">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center @(record.IsViewForPatient ? "bg-warning" : "bg-success") bg-opacity-10" style="width:48px;height:48px;">
                                <i class="fas @(record.IsViewForPatient ? "fa-eye-slash" : "fa-eye") @(record.IsViewForPatient ? "text-warning" : "text-success")" style="font-size:1.3rem;"></i>
                            </div>
                            <div>
                                <h5 class="modal-title fw-bold mb-0" id="toggleModalLabel-@record.Id">
                                    @(record.IsViewForPatient ? "Ẩn hồ sơ với bệnh nhân?" : "Cho phép bệnh nhân xem?")
                                </h5>
                                <p class="text-muted small mb-0 mt-1">Khám ngày @record.VisitDate.ToLocalTime().ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body px-4 pt-3 pb-2">
                        <div class="rounded-3 p-3 mb-0 @(record.IsViewForPatient ? "bg-warning bg-opacity-10 border border-warning border-opacity-25" : "bg-success bg-opacity-10 border border-success border-opacity-25")">
                            <div class="d-flex align-items-start gap-2">
                                <i class="fas fa-info-circle @(record.IsViewForPatient ? "text-warning" : "text-success") mt-1"></i>
                                <div class="small">
                                    @if (record.IsViewForPatient)
                                    {
                                        <p class="mb-1"><strong>Trạng thái hiện tại:</strong> Bệnh nhân <span class="text-success fw-bold">đang được xem</span> hồ sơ này.</p>
                                        <p class="mb-0 text-muted">Sau khi xác nhận, bệnh nhân sẽ <strong class="text-danger">không thể xem</strong> hồ sơ này nữa.</p>
                                    }
                                    else
                                    {
                                        <p class="mb-1"><strong>Trạng thái hiện tại:</strong> Hồ sơ này đang <span class="text-danger fw-bold">bị ẩn</span> với bệnh nhân.</p>
                                        <p class="mb-0 text-muted">Sau khi xác nhận, bệnh nhân sẽ <strong class="text-success">có thể xem</strong> hồ sơ này.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 px-4 pb-4 pt-3 gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4 fw-medium" data-bs-dismiss="modal">Hủy</button>
                        <form asp-action="ToggleViewForPatient" asp-route-id="@record.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn @(record.IsViewForPatient ? "btn-warning" : "btn-success") rounded-pill px-4 fw-bold">
                                <i class="fas @(record.IsViewForPatient ? "fa-eye-slash" : "fa-eye") me-2"></i>
                                @(record.IsViewForPatient ? "Xác nhận Ẩn" : "Xác nhận Cho xem")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}