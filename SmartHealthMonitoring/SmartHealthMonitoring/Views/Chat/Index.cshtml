@{
    ViewData["Title"] = "Tin nhắn";
    int currentUserId = ViewBag.CurrentUserId;
    byte currentUserRole = ViewBag.CurrentUserRole;
    string currentFullName = ViewBag.CurrentFullName;
    bool isDoctor = currentUserRole == 1;
    bool isEmbed = Context.Request.Query["embed"] == "true";
    if (isEmbed)
    {
        Layout = "_EmbedLayout";
    }
}

@section Styles {
<style>
    /* ══════════════════════════════════════════════
       TELEMEDICINE CHAT v2 — Queue-based UI
       ══════════════════════════════════════════════ */

    .chat-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px 32px;
        height: calc(100vh - 90px - 40px);
        display: flex;
        flex-direction: column;
    }

    .chat-header-bar {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
    }

    .chat-header-bar .icon-box {
        width: 44px; height: 44px;
        border-radius: 12px;
        background: var(--grad);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 14px rgba(14,165,233,.3);
        flex-shrink: 0;
    }

    .chat-header-bar .icon-box i { color: #fff; font-size: 18px; }

    .chat-header-bar h1 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.4rem; font-weight: 800;
        background: var(--grad);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text; margin: 0;
    }

    .chat-header-bar .subtitle { font-size: .8rem; color: var(--text-muted); margin-top: -2px; }

    /* ── MAIN CONTAINER ── */
    .chat-container {
        flex: 1; display: flex;
        background: #fff; border-radius: 16px;
        border: 1px solid var(--border); overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,.06);
        min-height: 0;
    }

    /* ── SIDEBAR (Doctor only) ── */
    .chat-sidebar {
        width: 340px;
        border-right: 1px solid var(--border);
        display: flex; flex-direction: column;
        background: var(--bg-soft); flex-shrink: 0;
    }

    .sidebar-tabs {
        display: flex; border-bottom: 1px solid var(--border);
    }

    .sidebar-tab {
        flex: 1; padding: 14px 8px; text-align: center;
        font-size: .82rem; font-weight: 600;
        color: var(--text-muted); cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: all .2s; background: none; border-top: none; border-left: none; border-right: none;
    }

    .sidebar-tab:hover { color: var(--primary); background: rgba(14,165,233,.04); }

    .sidebar-tab.active {
        color: var(--primary);
        border-bottom-color: var(--primary);
        background: rgba(14,165,233,.06);
    }

    .sidebar-tab .badge {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 20px; height: 20px; border-radius: 50%;
        font-size: .65rem; font-weight: 700;
        margin-left: 6px; padding: 0 5px;
    }

    .sidebar-tab .badge.waiting { background: #fef3c7; color: #d97706; }
    .sidebar-tab .badge.active-b { background: rgba(16,185,129,.15); color: #10b981; }

    .sidebar-content { flex: 1; overflow-y: auto; padding: 8px; }

    /* Session item */
    .session-item {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 14px; border-radius: 12px;
        cursor: pointer; transition: all .2s; margin-bottom: 2px;
    }

    .session-item:hover { background: rgba(14,165,233,.06); }
    .session-item.active { background: rgba(14,165,233,.1); border: 1px solid rgba(14,165,233,.2); }

    .session-avatar {
        width: 44px; height: 44px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: .85rem; color: #fff; flex-shrink: 0;
        background: linear-gradient(135deg, #10b981, #34d399);
    }

    .session-info { flex: 1; min-width: 0; }

    .session-name {
        font-size: .88rem; font-weight: 600; color: var(--text);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .session-preview {
        font-size: .78rem; color: var(--text-muted);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        margin-top: 2px;
    }

    .session-meta {
        display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0;
    }

    .session-time { font-size: .68rem; color: var(--text-muted); }

    .status-dot {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: .65rem; font-weight: 600; padding: 2px 8px;
        border-radius: 50px;
    }

    .status-dot.waiting { background: #fef3c7; color: #d97706; }
    .status-dot.active-s { background: rgba(16,185,129,.15); color: #10b981; }
    .status-dot.closed { background: rgba(148,163,184,.15); color: #94a3b8; }

    .btn-claim {
        padding: 6px 14px; border-radius: 8px;
        border: none; background: var(--grad);
        color: #fff; font-size: .78rem; font-weight: 600;
        cursor: pointer; transition: all .2s;
        box-shadow: 0 2px 8px rgba(14,165,233,.3);
    }

    .btn-claim:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(14,165,233,.4); }

    .sidebar-empty {
        text-align: center; padding: 40px 20px; color: var(--text-muted);
    }

    .sidebar-empty i { font-size: 2.5rem; margin-bottom: 12px; opacity: .3; display: block; }
    .sidebar-empty p { font-size: .85rem; }

    /* ── CHAT AREA ── */
    .chat-area { flex: 1; display: flex; flex-direction: column; min-width: 0; }

    .chat-area-header {
        padding: 16px 24px; border-bottom: 1px solid var(--border);
        display: flex; align-items: center; gap: 12px; background: #fff;
    }

    .chat-area-header .avatar {
        width: 40px; height: 40px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: .8rem; color: #fff; flex-shrink: 0;
    }

    .chat-area-header .chat-with-name { font-size: 1rem; font-weight: 600; color: var(--text); }
    .chat-area-header .chat-with-status { font-size: .75rem; color: var(--text-muted); }

    .btn-close-session {
        margin-left: auto; padding: 7px 16px;
        border-radius: 8px; border: 1.5px solid rgba(239,68,68,.4);
        background: rgba(239,68,68,.06); color: #ef4444;
        font-size: .78rem; font-weight: 600;
        cursor: pointer; transition: all .2s;
    }

    .btn-close-session:hover { background: #ef4444; color: #fff; border-color: #ef4444; }

    .connection-status {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: .72rem; font-weight: 500; padding: 3px 10px; border-radius: 50px;
    }

    .connection-status.connected { background: rgba(16,185,129,.1); color: #10b981; }
    .connection-status.disconnected { background: rgba(239,68,68,.1); color: #ef4444; }
    .connection-status.connecting { background: rgba(245,158,11,.1); color: #f59e0b; }

    .connection-status .dot {
        width: 6px; height: 6px; border-radius: 50%; background: currentColor;
    }

    .connection-status.connected .dot { animation: pd 1.5s infinite; }

    /* ── PLACEHOLDER ── */
    .chat-placeholder {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        color: var(--text-muted); gap: 16px;
    }

    .chat-placeholder .ph-icon {
        width: 80px; height: 80px; border-radius: 50%;
        background: linear-gradient(135deg, rgba(14,165,233,.1), rgba(99,102,241,.1));
        display: flex; align-items: center; justify-content: center;
    }

    .chat-placeholder .ph-icon i {
        font-size: 2rem; background: var(--grad);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .chat-placeholder h3 { font-size: 1.1rem; font-weight: 600; color: var(--text-sub); margin: 0; }
    .chat-placeholder p { font-size: .85rem; max-width: 300px; text-align: center; line-height: 1.5; }

    /* ── WAITING STATE (Patient) ── */
    .waiting-state {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; justify-content: center; gap: 20px;
        text-align: center; padding: 40px;
    }

    .waiting-spinner {
        width: 60px; height: 60px;
        border: 4px solid var(--border);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .waiting-state h3 { font-size: 1.1rem; font-weight: 600; color: var(--text-sub); margin: 0; }

    .waiting-state p { font-size: .85rem; color: var(--text-muted); max-width: 350px; line-height: 1.6; }

    .btn-start-chat {
        padding: 14px 32px; border-radius: 12px;
        border: none; background: var(--grad);
        color: #fff; font-size: 1rem; font-weight: 700;
        cursor: pointer; transition: all .3s;
        box-shadow: 0 4px 14px rgba(14,165,233,.3);
    }

    .btn-start-chat:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(14,165,233,.45); }

    .btn-new-session {
        padding: 10px 24px; border-radius: 10px;
        border: 1.5px solid rgba(14,165,233,.4);
        background: rgba(14,165,233,.06); color: var(--primary);
        font-size: .88rem; font-weight: 600;
        cursor: pointer; transition: all .2s;
    }

    .btn-new-session:hover { background: var(--primary); color: #fff; border-color: var(--primary); }

    /* ── MESSAGES ── */
    .chat-messages {
        flex: 1; overflow-y: auto; padding: 24px;
        display: flex; flex-direction: column; gap: 6px;
        background: linear-gradient(180deg, #f8fafc 0%, #fff 100%);
    }

    .chat-messages::-webkit-scrollbar { width: 4px; }
    .chat-messages::-webkit-scrollbar-thumb { background: rgba(14,165,233,.2); border-radius: 2px; }

    .date-divider { text-align: center; margin: 16px 0 12px; }

    .date-divider span {
        font-size: .72rem; color: var(--text-muted);
        background: #f1f5f9; padding: 4px 14px;
        border-radius: 50px; font-weight: 500;
    }

    .msg-row {
        display: flex; align-items: flex-end; gap: 8px;
        max-width: 70%; animation: msgIn .3s ease-out;
    }

    .msg-row.sent { align-self: flex-end; flex-direction: row-reverse; }
    .msg-row.received { align-self: flex-start; }

    .msg-bubble {
        padding: 10px 16px; border-radius: 16px;
        font-size: .88rem; line-height: 1.5;
        word-wrap: break-word; max-width: 100%;
    }

    .msg-row.sent .msg-bubble {
        background: linear-gradient(135deg, #0ea5e9, #6366f1);
        color: #fff; border-bottom-right-radius: 4px;
    }

    .msg-row.received .msg-bubble {
        background: #f1f5f9; color: var(--text);
        border-bottom-left-radius: 4px;
        border: 1px solid var(--border);
    }

    .msg-time { font-size: .65rem; margin-top: 4px; opacity: .7; }
    .msg-row.sent .msg-time { text-align: right; color: rgba(255,255,255,.7); }
    .msg-row.received .msg-time { text-align: left; color: var(--text-muted); }

    @@keyframes msgIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes pd { 0%,100% { opacity: 1; } 50% { opacity: .4; } }

    .msg-loading { text-align: center; padding: 40px; color: var(--text-muted); }

    .msg-loading .spinner {
        width: 28px; height: 28px;
        border: 3px solid var(--border); border-top-color: var(--primary);
        border-radius: 50%; animation: spin .8s linear infinite;
        margin: 0 auto 10px;
    }

    /* System message */
    .system-msg {
        text-align: center; padding: 8px 16px;
        font-size: .78rem; color: var(--text-muted);
        font-style: italic;
    }

    .system-msg .highlight { color: var(--primary); font-weight: 600; font-style: normal; }

    /* ── INPUT AREA ── */
    .chat-input-area {
        padding: 16px 24px; border-top: 1px solid var(--border);
        background: #fff; display: flex; align-items: center; gap: 12px;
    }

    .chat-input-area input {
        flex: 1; padding: 12px 18px;
        border: 1.5px solid var(--border); border-radius: 12px;
        font-size: .9rem; color: var(--text); outline: none;
        transition: border-color .2s, box-shadow .2s;
        background: var(--bg-soft);
    }

    .chat-input-area input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(14,165,233,.1);
        background: #fff;
    }

    .chat-input-area input::placeholder { color: var(--text-muted); }

    .btn-send {
        width: 46px; height: 46px; border-radius: 12px;
        border: none; background: var(--grad);
        color: #fff; font-size: 1rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all .2s;
        box-shadow: 0 4px 14px rgba(14,165,233,.3);
        flex-shrink: 0;
    }

    .btn-send:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(14,165,233,.4); }
    .btn-send:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }

    /* ── RESPONSIVE ── */
    @@media (max-width: 768px) {
        .chat-page { padding: 12px; }
        .chat-sidebar { width: 280px; }
        .msg-row { max-width: 85%; }
    }

    /* ══════════════════════════════════════════════
       PATIENT FLOATING CHAT WIDGET STYLES
       ══════════════════════════════════════════════ */
    @if (!isDoctor) {
        <text>
        .chat-page {
            position: relative;
            height: calc(100vh - 90px - 40px);
            background: radial-gradient(circle at 10% 20%, rgba(226,240,254,0.4) 0%, rgba(255,255,255,1) 90%);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            max-width: 100% !important;
            padding: 0 !important;
        }

        /* Nền cổng dịch vụ */
        .patient-portal-welcome {
            text-align: center;
            max-width: 600px;
            padding: 40px;
            animation: fadeIn 0.8s ease-out;
        }
        .patient-portal-welcome h2 {
            font-size: 2.2rem;
            font-weight: 800;
            background: var(--grad);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 16px;
        }
        .patient-portal-welcome p {
            font-size: 1rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 24px;
        }
        .patient-portal-welcome .features {
            display: flex;
            gap: 16px;
            justify-content: center;
            margin-top: 24px;
        }
        .patient-portal-welcome .feature-card {
            background: #fff;
            padding: 16px 20px;
            border-radius: 12px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 12px rgba(0,0,0,.03);
            flex: 1;
        }
        .patient-portal-welcome .feature-card i {
            font-size: 1.5rem;
            background: var(--grad);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
            display: inline-block;
        }
        .patient-portal-welcome .feature-card h4 {
            font-size: 0.85rem;
            font-weight: 700;
            margin: 0;
        }

        /* Floating Button Trigger */
        .patient-chat-widget-trigger {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: var(--grad);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 8px 32px rgba(14,165,233,.4);
            z-index: 99999;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .patient-chat-widget-trigger:hover {
            transform: scale(1.1) rotate(5deg);
            box-shadow: 0 12px 40px rgba(14,165,233,.6);
        }
        .patient-chat-widget-trigger:active {
            transform: scale(0.95);
        }
        .patient-chat-widget-trigger .pulse-ring {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 2px solid var(--primary);
            animation: ringPulse 2s infinite;
            opacity: 0;
            pointer-events: none;
        }

        /* Floating Chat Box */
        .chat-container.floating-widget {
            position: fixed;
            bottom: 110px;
            right: 30px;
            width: 400px;
            height: 580px;
            z-index: 99998;
            border-radius: 20px;
            box-shadow: 0 16px 48px rgba(15, 23, 42, 0.15);
            border: 1px solid rgba(226, 232, 240, 0.8);
            background: #fff;
            display: none;
            flex-direction: column;
            overflow: hidden;
            transform: translateY(20px) scale(0.95);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.15);
        }
        .chat-container.floating-widget.active {
            display: flex !important;
            transform: translateY(0) scale(1);
            opacity: 1;
            pointer-events: auto;
        }

        .chat-area-header {
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            background: #fff;
            padding: 14px 20px;
        }
        
        .chat-messages {
            padding: 16px;
        }

        /* Ẩn header mặc định cho bệnh nhân */
        .chat-header-bar {
            display: none !important;
        }

        @@keyframes ringPulse {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.4); opacity: 0; }
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 576px) {
            .chat-container.floating-widget {
                bottom: 0 !important;
                right: 0 !important;
                width: 100vw !important;
                height: 100vh !important;
                border-radius: 0 !important;
            }
            .chat-area-header {
                border-radius: 0 !important;
            }
        }
        </text>
    }

    @if (isEmbed) {
        <text>
        /* Override styles when embedded in iframe */
        .chat-page {
            height: 100vh !important;
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
            background: #fff !important;
        }
        .chat-header-bar {
            display: none !important;
        }
        .chat-container {
            width: 100% !important;
            height: 100vh !important;
            border-radius: 0 !important;
            border: none !important;
            box-shadow: none !important;
            position: static !important;
            display: flex !important;
            transform: none !important;
            opacity: 1 !important;
        }
        /* Hide portal welcome and triggers inside iframe */
        .patient-portal-welcome,
        .patient-chat-widget-trigger,
        .widget-top-bar {
            display: none !important;
        }
        /* Show states as block and flex inside the static container */
        #stateContainer {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        </text>
    }
</style>
}

<div class="chat-page">
    <div class="chat-header-bar">
        <div class="icon-box"><i class="fas fa-comments"></i></div>
        <div>
            <h1>Tin nhắn</h1>
            <div class="subtitle">
                @if (isDoctor)
                {
                    <text>Tiếp nhận & trả lời bệnh nhân</text>
                }
                else
                {
                    <text>Chat trực tuyến với bác sĩ</text>
                }
            </div>
        </div>
    </div>

    @if (!isDoctor && !isEmbed)
    {
        <!-- PATIENT PORTAL WELCOME PAGE -->
        <div class="patient-portal-welcome">
            <div style="display: inline-flex; width: 64px; height: 64px; border-radius: 16px; background: linear-gradient(135deg, rgba(14,165,233,.1), rgba(99,102,241,.1)); align-items: center; justify-content: center; margin-bottom: 20px;">
                <i class="fas fa-stethoscope" style="font-size: 2rem; background: var(--grad); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i>
            </div>
            <h2>Tư vấn sức khỏe trực tuyến</h2>
            <p>Chào mừng bạn đến với cổng Telemedicine của HeartCare. Hãy kết nối trực tuyến và nhận tư vấn sức khỏe tức thì từ đội ngũ bác sĩ chuyên khoa hàng đầu của chúng tôi.</p>
            <div class="features">
                <div class="feature-card">
                    <i class="fas fa-user-md"></i>
                    <h4>Bác sĩ Chuyên khoa</h4>
                </div>
                <div class="feature-card">
                    <i class="fas fa-bolt"></i>
                    <h4>Hỗ trợ 24/7</h4>
                </div>
                <div class="feature-card">
                    <i class="fas fa-shield-alt"></i>
                    <h4>An toàn & Bảo mật</h4>
                </div>
            </div>
            <button class="btn-start-chat" style="margin-top: 32px;" onclick="toggleChatWidget()">
                <i class="fas fa-comments"></i> Trò chuyện ngay
            </button>
        </div>

        <!-- Floating Button Trigger -->
        <div class="patient-chat-widget-trigger" id="chatWidgetTrigger" onclick="toggleChatWidget()">
            <i class="fas fa-comment-dots"></i>
            <span class="pulse-ring"></span>
        </div>
    }

    <div class="chat-container @(isDoctor || isEmbed ? "" : "floating-widget")">
        @if (!isDoctor)
        {
            <!-- WIDGET HEADER FOR PATIENT -->
            <div class="widget-top-bar" style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid var(--border); background: var(--bg-soft);">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-comment-medical" style="color: var(--primary); font-size: 1.1rem;"></i>
                    <span style="font-weight: 700; font-size: 0.9rem; color: var(--text);">Tư vấn bác sĩ trực tuyến</span>
                </div>
                <button onclick="toggleChatWidget()" style="background: none; border: none; font-size: 1.1rem; color: var(--text-muted); cursor: pointer; padding: 4px;">
                    <i class="fas fa-chevron-down"></i>
                </button>
            </div>
        }
        @if (isDoctor)
        {
            <!-- ═══ DOCTOR SIDEBAR ═══ -->
            <div class="chat-sidebar">
                <div class="sidebar-tabs">
                    <button class="sidebar-tab active" id="tabQueue" onclick="switchTab('queue')">
                        <i class="fas fa-clock"></i> Hàng đợi <span class="badge waiting" id="queueCount">0</span>
                    </button>
                    <button class="sidebar-tab" id="tabActive" onclick="switchTab('active')">
                        <i class="fas fa-comment-dots"></i> Đang xử lý <span class="badge active-b" id="activeCount">0</span>
                    </button>
                </div>
                <div class="sidebar-content" id="sidebarContent">
                    <div class="sidebar-empty">
                        <i class="fas fa-inbox"></i>
                        <p>Đang tải...</p>
                    </div>
                </div>
            </div>
        }

        <!-- ═══ CHAT AREA ═══ -->
        <div class="chat-area">
            <div class="chat-area-header" id="chatAreaHeader" style="display:none;">
                <div class="avatar" id="chatAvatar" style="background:linear-gradient(135deg,#10b981,#34d399);"></div>
                <div>
                    <div class="chat-with-name" id="chatWithName"></div>
                    <div class="chat-with-status" id="chatWithStatus"></div>
                </div>
                <button class="btn-close-session" id="btnCloseSession" style="display:none;" onclick="closeSession()">
                    <i class="fas fa-times-circle"></i> Kết thúc phiên
                </button>
                <div class="connection-status connecting" id="connectionStatus">
                    <span class="dot"></span>
                    <span id="connLabel">Đang kết nối...</span>
                </div>
            </div>

            <!-- Placeholder / States -->
            <div id="stateContainer">
                @if (!isDoctor)
                {
                    <!-- PATIENT: Initial state -->
                    <div class="chat-placeholder" id="patientInitial">
                        <div class="ph-icon"><i class="fas fa-paper-plane"></i></div>
                        <h3>Chào @currentFullName!</h3>
                        <p>Bấm nút bên dưới để bắt đầu trò chuyện với bác sĩ. Bạn sẽ được xếp vào hàng đợi.</p>
                        <button class="btn-start-chat" id="btnStartChat" onclick="startPatientChat()">
                            <i class="fas fa-comment-medical"></i> Bắt đầu trò chuyện
                        </button>
                        <div class="connection-status connecting" id="connStatusInit">
                            <span class="dot"></span>
                            <span id="connLabelInit">Đang kết nối...</span>
                        </div>
                    </div>

                    <!-- PATIENT: Waiting state -->
                    <div class="waiting-state" id="patientWaiting" style="display:none;">
                        <div class="waiting-spinner"></div>
                        <h3>Đang chờ bác sĩ tiếp nhận...</h3>
                        <p>Yêu cầu của bạn đã được gửi. Bác sĩ sẽ tiếp nhận và trả lời trong thời gian sớm nhất. Bạn có thể gửi tin nhắn mô tả triệu chứng trước.</p>
                    </div>

                    <!-- PATIENT: Session closed -->
                    <div class="chat-placeholder" id="patientClosed" style="display:none;">
                        <div class="ph-icon"><i class="fas fa-check-circle" style="color:#10b981;-webkit-text-fill-color:#10b981;"></i></div>
                        <h3>Phiên chat đã kết thúc</h3>
                        <p>Cảm ơn bạn đã sử dụng dịch vụ tư vấn trực tuyến.</p>
                        <button class="btn-new-session" onclick="startNewSession()">
                            <i class="fas fa-plus"></i> Tạo phiên chat mới
                        </button>
                    </div>
                }
                else
                {
                    <!-- DOCTOR: Placeholder -->
                    <div class="chat-placeholder" id="doctorPlaceholder">
                        <div class="ph-icon"><i class="fas fa-stethoscope"></i></div>
                        <h3>Chào BS. @currentFullName!</h3>
                        <p>Chọn một bệnh nhân từ hàng đợi bên trái hoặc phiên đang xử lý để bắt đầu tư vấn.</p>
                    </div>
                }
            </div>

            <!-- Messages area -->
            <div class="chat-messages" id="chatMessages" style="display:none;"></div>

            <!-- Input area -->
            <div class="chat-input-area" id="chatInputArea" style="display:none;">
                <input type="text" id="messageInput" placeholder="Nhập tin nhắn..." maxlength="2000" autocomplete="off" />
                <button class="btn-send" id="btnSend" disabled title="Gửi tin nhắn">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/@@microsoft/signalr@@8.0.0/dist/browser/signalr.min.js"></script>

    <script>
    (function () {
        'use strict';

        const CURRENT_USER_ID = @currentUserId;
        const IS_DOCTOR = @(isDoctor ? "true" : "false");

        // ── DOM ──
        const chatMessages    = document.getElementById('chatMessages');
        const chatInputArea   = document.getElementById('chatInputArea');
        const chatAreaHeader  = document.getElementById('chatAreaHeader');
        const chatAvatar      = document.getElementById('chatAvatar');
        const chatWithName    = document.getElementById('chatWithName');
        const chatWithStatus  = document.getElementById('chatWithStatus');
        const messageInput    = document.getElementById('messageInput');
        const btnSend         = document.getElementById('btnSend');
        const btnCloseSession = document.getElementById('btnCloseSession');
        const stateContainer  = document.getElementById('stateContainer');
        const connStatus      = document.getElementById('connectionStatus');
        const connLabel       = document.getElementById('connLabel');

        let currentSessionId = null;
        let currentSessionStatus = null; // 0=Waiting, 1=Active, 2=Closed

        // ══════════════════════════════
        // 1. SIGNALR CONNECTION
        // ══════════════════════════════
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .configureLogging(signalR.LogLevel.Warning)
            .build();

        function updateConnUI(state) {
            if (connStatus) {
                connStatus.className = 'connection-status ' + state;
                connLabel.textContent = state === 'connected' ? 'Đã kết nối' : state === 'disconnected' ? 'Mất kết nối' : 'Đang kết nối...';
            }
            // Also update init status for patient
            const initStatus = document.getElementById('connStatusInit');
            const initLabel = document.getElementById('connLabelInit');
            if (initStatus) {
                initStatus.className = 'connection-status ' + state;
                if (initLabel) initLabel.textContent = state === 'connected' ? 'Đã kết nối' : state === 'disconnected' ? 'Mất kết nối' : 'Đang kết nối...';
            }
        }

        connection.onreconnecting(() => updateConnUI('connecting'));
        connection.onreconnected(() => updateConnUI('connected'));
        connection.onclose(() => updateConnUI('disconnected'));

        // ── Event: Receive message ──
        connection.on("ReceiveMessage", function (msg) {
            if (msg.sessionId === currentSessionId) {
                appendMessage(msg);
                scrollToBottom();
            }
            // Notify parent layout of new message from other person
            if (msg.senderId !== CURRENT_USER_ID) {
                if (window.parent && typeof window.parent.notifyNewMessage === 'function') {
                    window.parent.notifyNewMessage();
                }
            }
            // Doctor: update sidebar preview
            if (IS_DOCTOR) loadDoctorData();
        });

        // ── Event: Session claimed (bác sĩ đã nhận) ──
        connection.on("SessionClaimed", function (data) {
            if (!IS_DOCTOR && data.sessionId === currentSessionId) {
                // Bệnh nhân: phiên đã được bác sĩ nhận!
                currentSessionStatus = 1;
                showActiveChat(data.patientName, data.doctorName, data.sessionId);
                appendSystemMessage(`Bác sĩ <span class="highlight">${escapeHtml(data.doctorName)}</span> đã tiếp nhận phiên chat.`);
                
                // Notify parent layout of session claim
                if (window.parent && typeof window.parent.notifyNewMessage === 'function') {
                    window.parent.notifyNewMessage();
                }
            }
            if (IS_DOCTOR) loadDoctorData();
        });

        // ── Event: Session closed ──
        connection.on("SessionClosed", function (data) {
            if (data.sessionId === currentSessionId) {
                currentSessionStatus = 2;
                if (!IS_DOCTOR) {
                    showPatientState('closed');
                } else {
                    appendSystemMessage('Phiên chat đã kết thúc.');
                    btnCloseSession.style.display = 'none';
                    messageInput.disabled = true;
                    btnSend.disabled = true;
                }
            }
            if (IS_DOCTOR) loadDoctorData();
        });

        // ── Event: Queue updated ──
        connection.on("QueueUpdated", function () {
            if (IS_DOCTOR) loadDoctorData();
        });

        async function startConnection() {
            try {
                await connection.start();
                updateConnUI('connected');
                // Auto-load on connect
                if (IS_DOCTOR) {
                    loadDoctorData();
                } else {
                    checkPatientSession();
                }
            } catch (err) {
                console.error('[Chat] SignalR error:', err);
                updateConnUI('disconnected');
                setTimeout(startConnection, 5000);
            }
        }
        startConnection();

        window.toggleChatWidget = function () {
            const widget = document.querySelector('.chat-container');
            if (widget) {
                widget.classList.toggle('active');
                if (widget.classList.contains('active')) {
                    setTimeout(() => {
                        const input = document.getElementById('messageInput');
                        if (input) input.focus();
                    }, 300);
                }
            }
        };

        // ══════════════════════════════
        // 2. PATIENT LOGIC
        // ══════════════════════════════

        // Check existing session
        async function checkPatientSession() {
            if (IS_DOCTOR) return;
            try {
                const res = await fetch('/Chat/MySession');
                const s = await res.json();
                currentSessionId = s.sessionId;
                currentSessionStatus = s.status;

                if (s.status === 0) {
                    // Waiting
                    showPatientState('waiting');
                    showChatInput(true); // Cho phép gửi tin nhắn mô tả triệu chứng
                    await loadHistory(s.sessionId);
                } else if (s.status === 1) {
                    // Active
                    showActiveChat(s.patientName, s.doctorName, s.sessionId);
                    await loadHistory(s.sessionId);
                }
                // Nếu cả 2 đều không (chưa có session), giữ initial state
            } catch (err) {
                console.error('[Chat] Check session error:', err);
            }
        }

        // Start chat (patient clicks button)
        window.startPatientChat = async function () {
            const btn = document.getElementById('btnStartChat');
            if (!btn) return;

            try {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang tạo...';

                const res = await fetch('/Chat/MySession');
                if (!res.ok) {
                    throw new Error(`HTTP error! status: ${res.status}`);
                }
                const s = await res.json();
                currentSessionId = s.sessionId;
                currentSessionStatus = s.status;

                if (s.status === 0) {
                    showPatientState('waiting');
                    showChatInput(true);
                } else if (s.status === 1) {
                    showActiveChat(s.patientName, s.doctorName, s.sessionId);
                    await loadHistory(s.sessionId);
                } else if (s.status === 2) {
                    showPatientState('closed');
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-comment-medical"></i> Bắt đầu trò chuyện';
                }
            } catch (err) {
                console.error('[Chat] Start chat error:', err);
                alert('Có lỗi xảy ra khi bắt đầu trò chuyện. Vui lòng thử lại sau.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-comment-medical"></i> Bắt đầu trò chuyện';
            }
        };

        window.startNewSession = async function () {
            // Reset UI to initial and create new
            currentSessionId = null;
            currentSessionStatus = null;
            showPatientState('initial');

            // Call MySession which creates new if none active
            await window.startPatientChat();
        };

        function showPatientState(state) {
            const initial = document.getElementById('patientInitial');
            const waiting = document.getElementById('patientWaiting');
            const closed = document.getElementById('patientClosed');

            if (initial) initial.style.display = 'none';
            if (waiting) waiting.style.display = 'none';
            if (closed) closed.style.display = 'none';
            stateContainer.style.display = '';
            chatMessages.style.display = 'none';
            chatAreaHeader.style.display = 'none';

            if (state === 'initial' && initial) {
                initial.style.display = 'flex';
                chatInputArea.style.display = 'none';
            } else if (state === 'waiting' && waiting) {
                waiting.style.display = 'flex';
                chatMessages.style.display = 'flex';
                stateContainer.style.display = ''; // FIX: Keep stateContainer visible so patientWaiting can be displayed!
            } else if (state === 'closed' && closed) {
                closed.style.display = 'flex';
                chatInputArea.style.display = 'none';
                chatMessages.style.display = 'none';
                chatAreaHeader.style.display = 'none';
            }
        }

        function showActiveChat(patientName, doctorName, sessionId) {
            stateContainer.style.display = 'none';
            chatMessages.style.display = 'flex';
            chatAreaHeader.style.display = 'flex';
            showChatInput(true);

            if (IS_DOCTOR) {
                chatAvatar.textContent = getInitials(patientName || '');
                chatAvatar.style.background = 'linear-gradient(135deg, #10b981, #34d399)';
                chatWithName.textContent = patientName || 'Bệnh nhân';
                chatWithStatus.textContent = 'Bệnh nhân';
                btnCloseSession.style.display = 'none'; // Hide close button for doctor
            } else {
                chatAvatar.textContent = getInitials(doctorName || '');
                chatAvatar.style.background = 'linear-gradient(135deg, #6366f1, #8b5cf6)';
                chatWithName.textContent = doctorName || 'Bác sĩ';
                chatWithStatus.textContent = 'Bác sĩ';
                btnCloseSession.style.display = ''; // Show close button for patient
            }
        }

        function showChatInput(show) {
            chatInputArea.style.display = show ? 'flex' : 'none';
            btnSend.disabled = false;
            messageInput.disabled = false;
        }

        // ══════════════════════════════
        // 3. DOCTOR LOGIC
        // ══════════════════════════════

        let currentTab = 'queue';
        let waitingData = [];
        let activeData = [];

        window.switchTab = function (tab) {
            currentTab = tab;
            document.getElementById('tabQueue').classList.toggle('active', tab === 'queue');
            document.getElementById('tabActive').classList.toggle('active', tab === 'active');
            renderDoctorSidebar();
        };

        async function loadDoctorData() {
            try {
                const [wRes, aRes] = await Promise.all([
                    fetch('/Chat/WaitingQueue'),
                    fetch('/Chat/DoctorSessions')
                ]);
                waitingData = await wRes.json();
                activeData = await aRes.json();

                document.getElementById('queueCount').textContent = waitingData.length;
                document.getElementById('activeCount').textContent = activeData.filter(s => s.status === 1).length;
                renderDoctorSidebar();
            } catch (err) {
                console.error('[Chat] Load doctor data error:', err);
            }
        }

        function renderDoctorSidebar() {
            const content = document.getElementById('sidebarContent');
            const items = currentTab === 'queue' ? waitingData : activeData;

            if (items.length === 0) {
                const msg = currentTab === 'queue'
                    ? 'Không có bệnh nhân nào đang chờ'
                    : 'Chưa có phiên xử lý nào';
                content.innerHTML = `<div class="sidebar-empty"><i class="fas fa-inbox"></i><p>${msg}</p></div>`;
                return;
            }

            content.innerHTML = items.map(s => {
                const initials = getInitials(s.patientName);
                const isActive = s.sessionId === currentSessionId;
                const preview = s.lastMessage ? truncate(s.lastMessage, 28) : 'Chưa có tin nhắn';
                const timeStr = s.lastMessageTime ? formatShortTime(s.lastMessageTime) : formatShortTime(s.createdAt);

                let statusHtml = '';
                if (s.status === 0) statusHtml = '<span class="status-dot waiting">⏳ Đang chờ</span>';
                else if (s.status === 1) statusHtml = '<span class="status-dot active-s">● Đang chat</span>';
                else statusHtml = '<span class="status-dot closed">✓ Đã xong</span>';

                let actionHtml = '';
                if (currentTab === 'queue') {
                    actionHtml = `<button class="btn-claim" onclick="event.stopPropagation(); claimSession(${s.sessionId})">Tiếp nhận</button>`;
                }

                return `
                    <div class="session-item ${isActive ? 'active' : ''}" onclick="selectSession(${s.sessionId}, '${escapeAttr(s.patientName)}', ${s.status})" data-session-id="${s.sessionId}">
                        <div class="session-avatar">${initials}</div>
                        <div class="session-info">
                            <div class="session-name">${escapeHtml(s.patientName)}</div>
                            <div class="session-preview">${escapeHtml(preview)}</div>
                        </div>
                        <div class="session-meta">
                            <span class="session-time">${timeStr}</span>
                            ${statusHtml}
                            ${actionHtml}
                        </div>
                    </div>`;
            }).join('');
        }

        window.claimSession = async function (sessionId) {
            try {
                await connection.invoke("ClaimSession", sessionId);
            } catch (err) {
                console.error('[Chat] Claim error:', err);
                alert('Không thể tiếp nhận: ' + (err.message || 'Phiên đã được nhận bởi bác sĩ khác.'));
            }
        };

        window.selectSession = async function (sessionId, patientName, status) {
            currentSessionId = sessionId;
            currentSessionStatus = status;

            // Highlight sidebar
            document.querySelectorAll('.session-item').forEach(el => {
                el.classList.toggle('active', parseInt(el.dataset.sessionId) === sessionId);
            });

            const docPlaceholder = document.getElementById('doctorPlaceholder');
            if (docPlaceholder) docPlaceholder.style.display = 'none';
            stateContainer.style.display = 'none';

            if (status >= 1) { // Active or Closed
                showActiveChat(patientName, null, sessionId);
                await loadHistory(sessionId);

                if (status === 2) {
                    btnCloseSession.style.display = 'none';
                    messageInput.disabled = true;
                    btnSend.disabled = true;
                    appendSystemMessage('Phiên chat đã kết thúc.');
                }
            } else {
                // Waiting — doctor viewing before claim
                chatAreaHeader.style.display = 'flex';
                chatAvatar.textContent = getInitials(patientName);
                chatWithName.textContent = patientName;
                chatWithStatus.textContent = 'Đang chờ tiếp nhận';
                btnCloseSession.style.display = 'none';
                chatMessages.style.display = 'flex';
                chatInputArea.style.display = 'none';
                await loadHistory(sessionId);
            }
        };

        window.closeSession = async function () {
            if (!currentSessionId) return;
            if (!confirm('Bạn có chắc muốn kết thúc phiên chat này?')) return;

            try {
                await connection.invoke("CloseSession", currentSessionId);
            } catch (err) {
                console.error('[Chat] Close error:', err);
                alert('Lỗi khi kết thúc phiên: ' + err.message);
            }
        };

        // ══════════════════════════════
        // 4. HISTORY & MESSAGING
        // ══════════════════════════════

        async function loadHistory(sessionId) {
            chatMessages.innerHTML = '<div class="msg-loading"><div class="spinner"></div><div>Đang tải...</div></div>';

            try {
                const res = await fetch(`/Chat/History?sessionId=${sessionId}`);
                if (!res.ok) throw new Error('Failed');
                const messages = await res.json();
                chatMessages.innerHTML = '';

                if (messages.length === 0) {
                    chatMessages.innerHTML = '<div class="system-msg">Chưa có tin nhắn. Hãy gửi lời chào!</div>';
                    scrollToBottom(false);
                    return;
                }

                let lastDate = '';
                messages.forEach(msg => {
                    const msgDate = formatDate(msg.sentAt);
                    if (msgDate !== lastDate) { appendDateDivider(msgDate); lastDate = msgDate; }
                    appendMessage(msg);
                });
                scrollToBottom(false);
            } catch (err) {
                console.error('[Chat] Load history error:', err);
                chatMessages.innerHTML = '<div class="msg-loading"><i class="fas fa-exclamation-triangle" style="font-size:1.5rem;color:var(--danger);margin-bottom:10px;"></i><div>Không thể tải lịch sử</div></div>';
            }
        }

        async function sendMessage() {
            const text = messageInput.value.trim();
            if (!text || !currentSessionId) return;

            messageInput.value = '';
            messageInput.focus();

            try {
                await connection.invoke("SendMessage", currentSessionId, text);
            } catch (err) {
                console.error('[Chat] Send error:', err);
                const errDiv = document.createElement('div');
                errDiv.className = 'system-msg';
                errDiv.style.color = 'var(--danger)';
                errDiv.textContent = 'Gửi tin nhắn thất bại. Vui lòng thử lại.';
                chatMessages.appendChild(errDiv);
                scrollToBottom();
            }
        }

        btnSend.addEventListener('click', sendMessage);
        messageInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
        });

        // ══════════════════════════════
        // 5. UI HELPERS
        // ══════════════════════════════

        function appendMessage(msg) {
            const isSent = msg.senderId === CURRENT_USER_ID;
            const row = document.createElement('div');
            row.className = `msg-row ${isSent ? 'sent' : 'received'}`;

            const bubble = document.createElement('div');
            bubble.className = 'msg-bubble';
            bubble.textContent = msg.messageContent;

            const time = document.createElement('div');
            time.className = 'msg-time';
            time.textContent = formatTime(msg.sentAt);

            bubble.appendChild(time);
            row.appendChild(bubble);
            chatMessages.appendChild(row);
        }

        function appendSystemMessage(html) {
            const div = document.createElement('div');
            div.className = 'system-msg';
            div.innerHTML = html;
            chatMessages.appendChild(div);
            scrollToBottom();
        }

        function appendDateDivider(dateStr) {
            const div = document.createElement('div');
            div.className = 'date-divider';
            div.innerHTML = `<span>${dateStr}</span>`;
            chatMessages.appendChild(div);
        }

        function scrollToBottom(smooth = true) {
            setTimeout(() => {
                chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: smooth ? 'smooth' : 'auto' });
            }, 50);
        }

        // ══════════════════════════════
        // 6. FORMAT UTILS
        // ══════════════════════════════

        function getInitials(name) {
            if (!name) return '?';
            const p = name.trim().split(' ');
            return p.length >= 2 ? (p[0][0] + p[p.length - 1][0]).toUpperCase() : name.substring(0, 2).toUpperCase();
        }

        function truncate(str, len) { return str.length > len ? str.substring(0, len) + '...' : str; }
        function escapeHtml(str) { const d = document.createElement('div'); d.textContent = str; return d.innerHTML; }
        function escapeAttr(str) { return str.replace(/'/g, "\\'").replace(/"/g, '&quot;'); }

        function formatTime(iso) {
            return new Date(iso).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        }

        function formatShortTime(iso) {
            const d = new Date(iso), now = new Date(), diff = now - d;
            if (diff < 86400000 && d.getDate() === now.getDate())
                return d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
            if (diff < 172800000) return 'Hôm qua';
            return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' });
        }

        function formatDate(iso) {
            const d = new Date(iso), now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const msgDay = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            const diff = today - msgDay;
            if (diff === 0) return 'Hôm nay';
            if (diff === 86400000) return 'Hôm qua';
            return d.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
        }

    })();
    </script>
}
