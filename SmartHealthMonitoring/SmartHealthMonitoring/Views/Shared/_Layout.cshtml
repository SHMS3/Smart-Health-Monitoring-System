                    <span class="pulse-ring"></span>
                    <span class="main-hub-badge" id="shHubBadge" style="display: none;">0</span>
                </button>
            </div>
        }

        <!-- The actual popups (embedded iframe for Doctor chat) -->
        <div class="global-chat-box @(layoutIsDoctor ? "doctor-mode" : "")" id="globalChatBox">
            <div class="global-chat-header">
                <div class="global-chat-header-title">
                    <i class="fas fa-comment-medical"></i>
                    <span>@(layoutIsDoctor ? "Hàng đợi & Tư vấn bệnh nhân" : "Tư vấn bác sĩ trực tuyến")</span>
                </div>
                <button class="global-chat-close-btn" onclick="toggleGlobalChat()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <iframe class="global-chat-iframe" id="globalChatIframe" data-src="/Chat/Index?embed=true"></iframe>
        </div>

        <script src="https://unpkg.com/@@microsoft/signalr@@8.0.0/dist/browser/signalr.min.js"></script>
        <script>
            const isDoctorUser = @(layoutIsDoctor ? "true" : "false");
            const currentLoggedInUserId = @(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");

            async function updateGlobalChatBadgeUI() {
                const chatBox = document.getElementById('globalChatBox');
                const badge = document.getElementById('globalChatBadge');
                if (!badge) return;

                // Hide badge if chatBox is open
                if (chatBox && chatBox.classList.contains('active')) {
                    badge.style.display = 'none';
                    return;
                }

                try {
                    const res = await fetch('/Chat/UnreadCount');
                    if (res.ok) {
                        const data = await res.json();
                        const count = data.count;
                        badge.textContent = count;
                        badge.style.display = count > 0 ? 'flex' : 'none';

                        // Also update the main hub badge for patient
                        const hubBadge = document.getElementById('shHubBadge');
                        if (hubBadge) {
                            hubBadge.textContent = count;
                            hubBadge.style.display = count > 0 ? 'flex' : 'none';
                        }
                    }
                } catch (err) {
                    console.error('[Global Chat] Fetch unread count error:', err);
                }
            }

            // Expose callback for nested iframe to trigger badge updates
            window.notifyNewMessage = function() {
                updateGlobalChatBadgeUI();
            };

            function toggleGlobalChat() {
                const chatBox = document.getElementById('globalChatBox');
                const iframe = document.getElementById('globalChatIframe');
                if (chatBox && iframe) {
                    const isActive = chatBox.classList.toggle('active');
                    const badge = document.getElementById('globalChatBadge');
                    if (isActive) {
                        if (badge) badge.style.display = 'none';

                        // Lazy load the iframe source if not loaded
                        if (!iframe.src || iframe.src === 'about:blank' || iframe.getAttribute('src') === null) {
                            iframe.src = iframe.getAttribute('data-src');
                        }
                    } else {
                        updateGlobalChatBadgeUI();
                    }
                }
            }

            // Toggle Hub Menu
            window.toggleHubMenu = function() {
                const menu = document.getElementById('shHubMenu');
                const btn = document.getElementById('shHubBtn');
                const icon = document.getElementById('shHubIcon');

                if (menu && btn) {
                    const isActive = menu.classList.toggle('active');
                    btn.classList.toggle('active');

                    if (isActive) {
                        if (icon) {
                            icon.className = 'fas fa-times';
                        }
                    } else {
                        if (icon) {
                            icon.className = 'fas fa-headset';
                        }
                    }
                }
            };

            // Handle Hub Item click
            window.handleHubAction = function(type) {
                // Close menu
                window.toggleHubMenu();

                if (type === 'ai') {
                    // Open AI Chatbot Popup
                    const popup = document.getElementById('chatbotPopup');
                    if (popup) {
                        popup.style.display = 'flex';
                    }
                } else if (type === 'doctor') {
                    // Open Doctor Chat box
                    toggleGlobalChat();
                }
            };

            (function() {
                // Connect to SignalR hub to monitor updates globally in real-time
                const globalConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/chatHub")
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                    .configureLogging(signalR.LogLevel.Warning)
                    .build();

                // Real-time unread messages & state updates
                globalConnection.on("ReceiveMessage", function(msg) {
                    if (msg.senderId !== currentLoggedInUserId) {
                        updateGlobalChatBadgeUI();
                    }
                });

                globalConnection.on("SessionClaimed", function(data) {
                    updateGlobalChatBadgeUI();
                });

                globalConnection.on("SessionClosed", function(data) {
                    updateGlobalChatBadgeUI();
                });

                @if (layoutIsDoctor)
                {
                    <text>
                    globalConnection.on("QueueUpdated", updateGlobalChatBadgeUI);
                    </text>
                }

                globalConnection.start().then(() => {
                    updateGlobalChatBadgeUI();
                }).catch(err => console.error('[Global Chat] SignalR start error:', err));
            })();
        </script>
    }

    <div id="chatbotPopup" class="chatbot-popup">
        <div class="chatbot-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <div class="bg-white rounded-circle d-flex align-items-center justify-content-center" style="width:30px;height:30px;color:var(--cl-blue);">
                    <i class="fas fa-robot"></i>
                </div>
                <span>Trợ lý Tim mạch AI</span>
            </div>
            <button id="closeChatbot" class="btn text-white fs-4 p-0 shadow-none border-0" style="line-height:1;">&times;</button>
        </div>

        <div id="chatMessages" class="chat-messages d-flex flex-column">
            <div id="popupWelcome" class="popup-welcome">
                <p class="popup-welcome-title">Xin chào! 👋</p>
                <p class="popup-welcome-sub">Bạn muốn hỏi gì về tim mạch?</p>
                <div class="popup-suggestions">
                    <button class="popup-suggestion-btn" onclick="sendPopupSuggestion(this)">
                        <i class="fas fa-chart-line"></i>
                        Xu hướng sức khỏe trong 30 ngày qua
                    </button>
                    <button class="popup-suggestion-btn" onclick="sendPopupSuggestion(this)">
                        <i class="fas fa-heartbeat"></i>
                        Chỉ số của tôi hôm nay có đáng lo ngại không?
                    </button>
                </div>
            </div>
            <div class="d-flex justify-content-start mb-2">
                <div class="chat-bubble ai-bubble">Xin chào 👋 Tôi là trợ lý AI chuyên về <strong>tim mạch</strong>. Tôi có thể giúp gì cho bạn hôm nay?</div>
            </div>
        </div>

        <div class="chat-input-area">
            <div class="chat-input-wrapper">
                <input type="text" id="chatInput" placeholder="Hỏi về tim mạch..." autocomplete="off" />
                <button id="sendMessage" class="chat-send-btn"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
    </div>

</body>
</html>