<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SmartHealth - Hệ thống quản lý hồ sơ bệnh án và theo dõi sức khỏe thông minh, cảnh báo bệnh sớm bằng AI." />
    <title>@ViewData["Title"] - SmartHealth</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary: #0ea5e9;
            --primary-dark: #0284c7;
            --secondary: #6366f1;
            --grad: linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
            --bg-body: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: #1e293b;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            padding-top: 76px; /* Khoảng trống cho fixed navbar */
        }

        /* ── NAVBAR GLASSMORPHISM ── */
        .navbar-glass {
            background: rgba(255, 255, 255, 0.85) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

            .navbar-glass.scrolled {
                box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
                background: rgba(255, 255, 255, 0.95) !important;
            }

        /* Logo */
        .brand-icon {
            width: 40px;
            height: 40px;
            background: var(--grad);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
        }

        .brand-text {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            background: var(--grad);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1.1;
        }

        /* Nav Links */
        .nav-link {
            font-weight: 500;
            color: #64748b;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
            margin: 0 4px;
        }

            .nav-link:hover, .nav-link.active {
                color: var(--primary);
                background: rgba(14, 165, 233, 0.08);
            }

        /* Buttons */
        .btn-gradient {
            background: var(--grad);
            color: white;
            border: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .btn-gradient:hover {
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(14, 165, 233, 0.4);
            }

        .btn-outline-custom {
            color: var(--primary);
            border: 2px solid rgba(14, 165, 233, 0.2);
            transition: all 0.2s;
        }

            .btn-outline-custom:hover {
                background: var(--primary);
                color: white;
                border-color: var(--primary);
            }

        /* ── FOOTER MODERN ── */
        .footer-modern {
            background-color: #0f172a;
            color: #94a3b8;
            margin-top: auto;
            position: relative;
            overflow: hidden;
        }

            .footer-modern a {
                color: #94a3b8;
                text-decoration: none;
                transition: color 0.2s;
            }

                .footer-modern a:hover {
                    color: var(--primary);
                }

        .social-btn {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.05);
            color: white;
            transition: all 0.2s;
        }

            .social-btn:hover {
                background: var(--primary);
                transform: translateY(-3px);
            }

        /* ── CHATBOT UI ── */
        .chatbot-popup {
            position: fixed;
            bottom: 90px;
            right: 25px;
            width: 360px;
            height: 500px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
            display: none;
            flex-direction: column;
            z-index: 99999;
            overflow: hidden;
            animation: slideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @@keyframes slideUp {
            from

        {
            opacity: 0;
            transform: translateY(30px) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        }

        .chatbot-header {
            background: var(--grad);
            padding: 16px 20px;
            color: white;
            font-weight: 600;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background-color: #f8fafc;
        }

        .chat-bubble {
            max-width: 85%;
            padding: 12px 16px;
            font-size: 0.95rem;
            line-height: 1.4;
            word-wrap: break-word;
        }

        .ai-bubble {
            background: white;
            color: #334155;
            border-radius: 16px 16px 16px 4px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
            align-self: flex-start;
        }

        .user-bubble {
            background: var(--grad);
            color: white;
            border-radius: 16px 16px 4px 16px;
            align-self: flex-end;
            box-shadow: 0 4px 12px rgba(14,165,233,0.2);
        }

        .chat-input-area {
            padding: 15px;
            background: white;
            border-top: 1px solid #f1f5f9;
        }

        .chat-input-wrapper {
            background: #f1f5f9;
            border-radius: 50px;
            padding: 4px 4px 4px 16px;
            display: flex;
            align-items: center;
        }

            .chat-input-wrapper input {
                border: none;
                background: transparent;
                flex: 1;
                outline: none;
                color: #1e293b;
            }

        .chat-send-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.2s;
        }

            .chat-send-btn:hover {
                background: var(--primary-dark);
            }

        .ai-floating-btn {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--grad);
            color: white;
            border: none;
            font-size: 24px;
            box-shadow: 0 8px 24px rgba(14, 165, 233, 0.4);
            cursor: pointer;
            z-index: 999999;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

            .ai-floating-btn:hover {
                transform: scale(1.1);
            }
    </style>

    <style>
        /* ══════════════════════════════════════════════
           GLOBAL FLOATING CHAT WIDGET STYLES (Doctor Chat)
           ══════════════════════════════════════════════ */
        .global-chat-widget-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 16px;
            z-index: 9999;
            height: 64px;
            overflow: visible;
        }
        .global-widget-item {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .global-chat-trigger {
            position: relative;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--grad);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 8px 32px rgba(14,165,233,.4);
            z-index: 10;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .global-chat-trigger:hover {
            transform: scale(1.1) rotate(5deg);
            box-shadow: 0 12px 40px rgba(14,165,233,.6);
        }
        .global-chat-trigger:active {
            transform: scale(0.95);
        }
        .global-chat-trigger .pulse-ring {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 2px solid var(--primary);
            animation: ringPulse 2s infinite;
            opacity: 0;
            pointer-events: none;
        }
        .global-call-trigger {
            position: relative;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #f1faf5;
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(16,185,129,.15);
            z-index: 5;
            opacity: 0;
            transform: translateX(76px) scale(0.5);
            pointer-events: none;
            transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            text-decoration: none;
        }
        .global-chat-widget-container:hover .global-call-trigger {
            opacity: 1;
            transform: translateX(0) scale(1);
            pointer-events: auto;
        }
        .global-call-trigger:hover {
            background: #10b981;
            color: #fff;
            transform: scale(1.1);
            box-shadow: 0 8px 24px rgba(16,185,129,.35);
        }
        .global-chat-tooltip, .global-call-tooltip {
            position: absolute;
            bottom: 74px;
            background: #1e293b;
            color: #fff;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 500;
            white-space: nowrap;
            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.2);
            opacity: 0;
            pointer-events: none;
            transform: translateY(10px) scale(0.9);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 100;
        }
        .global-chat-tooltip::after, .global-call-tooltip::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 50%;
            transform: translateX(-50%) rotate(45deg);
            width: 12px;
            height: 12px;
            background: #1e293b;
        }
        .global-widget-item:hover .global-chat-tooltip {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        .global-widget-item:hover .global-call-tooltip {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        /* Doctor badge */
        .chat-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: var(--danger, #ef4444);
            color: #fff;
            font-size: 0.72rem;
            font-weight: 700;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
            box-shadow: 0 2px 8px rgba(239,68,68,.4);
            animation: pulseBadge 2s infinite;
            z-index: 12;
        }
        @@keyframes pulseBadge {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }
        .global-chat-box {
            position: fixed;
            bottom: 96px;
            right: 24px;
            width: 400px;
            height: 600px;
            z-index: 9998;
            border-radius: 16px;
            box-shadow: 0 12px 40px rgba(15, 23, 42, 0.15);
            border: 1px solid rgba(226,232,240,1);
            background: #fff;
            display: none;
            flex-direction: column;
            overflow: hidden;
            transform: translateY(20px) scale(0.95);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.15);
        }
        .global-chat-box.active {
            display: flex;
            transform: translateY(0) scale(1);
            opacity: 1;
        }
        .global-chat-box.doctor-mode {
            width: 850px;
            max-width: 90vw;
            height: 700px;
            max-height: 85vh;
        }
        .global-chat-header {
            background: #f8fafc;
            padding: 12px 16px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .global-chat-header-title {
            font-weight: 700;
            font-size: 0.9rem;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .global-chat-header-title i {
            color: var(--primary);
        }
        .global-chat-close-btn {
            background: none;
            border: none;
            font-size: 1rem;
            color: #94a3b8;
            cursor: pointer;
            padding: 4px;
            transition: color 0.2s;
        }
        .global-chat-close-btn:hover {
            color: #ef4444;
        }
        .global-chat-iframe {
            width: 100%;
            height: calc(100% - 45px);
            border: none;
        }
        @@keyframes ringPulse {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.4); opacity: 0; }
        }
        @@media (max-width: 576px) {
            .global-chat-box {
                bottom: 0 !important;
                right: 0 !important;
                width: 100vw !important;
                height: 100vh !important;
                border-radius: 0 !important;
            }
            .global-chat-box.doctor-mode {
                width: 100vw !important;
                max-width: 100vw !important;
                height: 100vh !important;
                max-height: 100vh !important;
                border-radius: 0 !important;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand-lg fixed-top navbar-glass py-2" id="mainNav">
        <div class="container-fluid container-xl">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <div class="brand-icon"><i class="fas fa-heartbeat"></i></div>
                <div class="d-flex flex-column justify-content-center">
                    <span class="brand-text fs-5">SmartHealth</span>
                    <small class="text-muted text-uppercase" style="font-size: 0.6rem; letter-spacing: 1px; margin-top: -4px;">Monitoring System</small>
                </div>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <i class="fas fa-bars text-dark fs-4"></i>
            </button>

            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                    @{
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                        bool isDoctor = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("1");
                    }

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" ? "active fw-semibold" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>

                    @if (isDoctor)
                    {
                        <li class="nav-item"><a class="nav-link @(currentController == "DoctorDashboard" ? "active fw-semibold" : "")" asp-controller="DoctorDashboard" asp-action="Index">Bệnh nhân</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "WarningAlert" ? "active fw-semibold" : "")" asp-controller="WarningAlert" asp-action="Dashboard">Cảnh báo AI</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "EmailNotification" ? "active fw-semibold" : "")" asp-controller="EmailNotification" asp-action="Index">Lịch sử Email</a></li>
                    }
                    else
                    {
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("0"))
                        {
                            <li class="nav-item"><a class="nav-link @(currentController == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active fw-semibold" : "")" asp-controller="Patient" asp-action="Index">Sổ tay hằng ngày</a></li>
                            <li class="nav-item"><a class="nav-link @(currentController == "ClinicalRecord" ? "active fw-semibold" : "")" asp-controller="ClinicalRecord" asp-action="MyRecords">Hồ sơ bệnh án</a></li>
                            <li class="nav-item"><a class="nav-link @(currentController == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "DoctorAlert" ? "active fw-semibold" : "")" asp-controller="Patient" asp-action="DoctorAlert">Cảnh báo</a></li>
                            <li class="nav-item"><a class="nav-link @(currentController == "Chatbot" ? "active fw-semibold" : "")" asp-controller="Chatbot" asp-action="History">Lịch sử Chat</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Sổ tay hằng ngày</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Hồ sơ bệnh án</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Cảnh báo</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Lịch sử Chat</a></li>
                        }
                    }
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active fw-semibold" : "")" asp-controller="Home" asp-action="Contact">Liên hệ</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var fullName = User.FindFirst("FullName")?.Value ?? "";
                        var lastName = fullName.Split(' ').LastOrDefault() ?? "";

                        <a asp-controller="Home" asp-action="Profile" class="d-flex align-items-center gap-2 text-decoration-none">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex justify-content-center align-items-center" style="width: 38px; height: 38px;">
                                <i class="fas fa-user"></i>
                            </div>
                            <span class="text-nowrap fw-semibold text-dark">@lastName</span>
                        </a>

                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-light rounded-pill px-3 fw-medium border shadow-sm">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-light rounded-pill px-4 fw-medium border shadow-sm">Đăng nhập</a>
                        <a asp-controller="Auth" asp-action="Register" class="btn btn-gradient rounded-pill px-4 fw-medium shadow-sm">Đăng ký</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer-modern pt-5 pb-3">
        <div class="container container-xl">
            <div class="row gy-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <a class="d-flex align-items-center gap-2 mb-3 text-white text-decoration-none" href="/">
                        <div class="brand-icon shadow-none"><i class="fas fa-heartbeat"></i></div>
                        <span class="brand-text text-white fs-4">SmartHealth</span>
                    </a>
                    <p class="small text-muted pe-lg-4 mb-4">
                        Hệ thống quản lý hồ sơ bệnh án và theo dõi sức khỏe thông minh. Phát hiện sớm nguy cơ bệnh tật nhờ AI tiên tiến.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="social-btn"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-btn"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-btn"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white text-uppercase letter-spacing-1 mb-3 fs-7 fw-bold">Dịch vụ</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="#">Hồ sơ bệnh án</a></li>
                        <li><a href="#">Theo dõi sức khỏe</a></li>
                        <li><a href="#">Cảnh báo bệnh sớm</a></li>
                        <li><a href="#">Phân tích AI</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white text-uppercase letter-spacing-1 mb-3 fs-7 fw-bold">Liên hệ</h6>
                    <ul class="list-unstyled d-flex flex-column gap-3 small">
                        <li class="d-flex gap-3 align-items-start">
                            <i class="fas fa-map-marker-alt text-primary mt-1"></i>
                            <span>Đại học FPT,<br>HOLA Nơi Tình Yêu Bắt Đầu</span>
                        </li>
                        <li class="d-flex gap-3 align-items-center">
                            <i class="fas fa-phone-alt text-primary"></i>
                            <span>1900 1234 — Hotline 24/7</span>
                        </li>
                        <li class="d-flex gap-3 align-items-center">
                            <i class="fas fa-envelope text-primary"></i>
                            <span>contact@smarthealth.vn</span>
                        </li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="bg-dark bg-opacity-50 p-3 rounded-4 border border-secondary border-opacity-25">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="spinner-grow text-success spinner-grow-sm" role="status"></div>
                            <span class="text-white fw-medium small">Hệ thống đang hoạt động</span>
                        </div>
                        <p class="text-muted small mb-0" style="font-size: 0.75rem;">AI Server & Database ổn định. Cập nhật 1 phút trước.</p>
                    </div>
                </div>
            </div>

            <hr class="border-secondary border-opacity-50 my-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small">
                <p class="mb-2 mb-md-0">© 2026 SmartHealth Monitoring System. Bảo lưu mọi quyền.</p>
                <div class="d-flex gap-3">
                    <a href="#">Điều khoản sử dụng</a>
                    <a href="#">Chính sách bảo mật</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Hiệu ứng Glass Navbar khi cuộn chuột
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('mainNav');
            if (window.scrollY > 20) {
                nav.classList.add('scrolled', 'py-1');
                nav.classList.remove('py-2');
            } else {
                nav.classList.remove('scrolled', 'py-1');
                nav.classList.add('py-2');
            }
        });

        // Logic Mở/Đóng AI Chatbot (Gemini)
        document.addEventListener("DOMContentLoaded", function () {
            const openBtn = document.getElementById("openChatbot");
            const closeBtn = document.getElementById("closeChatbot");
            const popup = document.getElementById("chatbotPopup");

            if (openBtn && popup) {
                openBtn.addEventListener("click", () => {
                    popup.style.display = "flex";
                });
            }

            if (closeBtn && popup) {
                closeBtn.addEventListener("click", () => {
                    popup.style.display = "none";
                });
            }
        });

        // Logic Chat API
        document.addEventListener("DOMContentLoaded", function () {
            const sendBtn = document.getElementById("sendMessage");
            const input = document.getElementById("chatInput");
            const messages = document.getElementById("chatMessages");

            if (!sendBtn || !input || !messages) return;

            async function sendMessage() {
                const text = input.value.trim();
                if (!text) return;

                // In câu hỏi User
                messages.innerHTML += `
                    <div class="d-flex justify-content-end mb-3">
                        <div class="chat-bubble user-bubble">${text}</div>
                    </div>`;
                input.value = "";
                scrollToBottom();

                // Hiện "Đang gõ..."
                const typingId = "typing-" + Date.now();
                messages.innerHTML += `
                    <div id="${typingId}" class="d-flex justify-content-start mb-3">
                        <div class="chat-bubble ai-bubble text-muted">
                            <i class="fas fa-circle-notch fa-spin me-2"></i>Đang suy nghĩ...
                        </div>
                    </div>`;
                scrollToBottom();

                try {
                    const response = await fetch('/Chatbot/SendMessage', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Message: text })
                    });

                    const data = await response.json();
                    document.getElementById(typingId).remove();

                    if (data.success) {
                        messages.innerHTML += `
                            <div class="d-flex justify-content-start mb-3">
                                <div class="chat-bubble ai-bubble">${data.reply.replace(/\n/g, '<br>')}</div>
                            </div>`;
                    } else {
                        messages.innerHTML += `<div class="text-center text-danger small mb-3">Lỗi: ${data.error}</div>`;
                    }
                } catch (err) {
                    document.getElementById(typingId).remove();
                    messages.innerHTML += `<div class="text-center text-danger small mb-3">Mất kết nối tới máy chủ.</div>`;
                }

                scrollToBottom();
            }

            function scrollToBottom() {
                messages.scrollTop = messages.scrollHeight;
            }

            sendBtn.addEventListener("click", sendMessage);
            input.addEventListener("keypress", function (e) {
                if (e.key === "Enter") sendMessage();
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("0"))
    {
        <button id="openChatbot" class="ai-floating-btn shadow-lg">
            <i class="fas fa-robot"></i>
        </button>
    }

    <div id="chatbotPopup" class="chatbot-popup">
        <div class="chatbot-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="fas fa-robot"></i>
                </div>
                <span>Trợ lý sức khỏe</span>
            </div>
            <button id="closeChatbot" class="btn text-white fs-4 p-0 shadow-none border-0" style="line-height: 1;">&times;</button>
        </div>

        <div id="chatMessages" class="chat-messages d-flex flex-column">
            <div class="d-flex justify-content-start mb-3">
                <div class="chat-bubble ai-bubble">Xin chào 👋 Tôi là AI từ SmartHealth. Tôi có thể hỗ trợ gì cho sức khỏe của bạn hôm nay?</div>
            </div>
        </div>

        <div class="chat-input-area">
            <div class="chat-input-wrapper border shadow-sm">
                <input type="text" id="chatInput" placeholder="Hỏi tôi bất cứ điều gì..." autocomplete="off" />
                <button id="sendMessage" class="chat-send-btn">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</body>
</html>