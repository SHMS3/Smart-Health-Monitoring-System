<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SmartHealth Tim mạch - Hệ thống theo dõi sức khỏe tim mạch thông minh, cảnh báo sớm bằng AI." />
    <title>@ViewData["Title"] - SmartHealth Tim Mạch</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --cl-blue:      #1a73c8;
            --cl-blue-dark: #135fa5;
            --cl-blue-nav:  #1565c0;
            --cl-red:       #e53935;
            --cl-orange:    #f57c00;
            --cl-bg:        #f4f7fb;
            --cl-text:      #1a2340;
            --cl-muted:     #607080;

            /* Telemedicine & Chat custom properties */
            --primary:      #0ea5e9;
            --primary-dark: #0284c7;
            --secondary:    #6366f1;
            --accent:       #10b981;
            --warn:         #f59e0b;
            --danger:       #ef4444;
            --grad:         linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
            --border:       #e2e8f0;
            --text-sub:     #475569;
            --text-muted:   #94a3b8;
            --bg-soft:      #f8fafc;
        }

        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--cl-bg);
            color: var(--cl-text);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            padding-top: 0;
        }

        /* ── TOP INFO BAR ── */
        .top-infobar {
            background: #f0f4f8;
            border-bottom: 1px solid #dde3ea;
            padding: 6px 0;
            font-size: 0.8rem;
            color: var(--cl-muted);
        }
        .top-infobar a { color: var(--cl-muted); text-decoration: none; }
        .top-infobar a:hover { color: var(--cl-blue); }
        .top-infobar .divider { margin: 0 12px; opacity: 0.4; }

        /* ── HEADER LOGO BAR ── */
        .header-main {
            background: #fff;
            border-bottom: 1px solid #e0e8f0;
            padding: 14px 0;
        }
        .brand-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }
        .brand-logo-icon {
            width: 52px; height: 52px;
            background: linear-gradient(135deg, var(--cl-red), var(--cl-blue));
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1.4rem;
            box-shadow: 0 4px 14px rgba(229,57,53,.3);
            flex-shrink: 0;
        }
        .brand-text-wrap { line-height: 1.1; }
        .brand-name {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1.1rem;
            color: var(--cl-blue);
            display: block;
        }
        .brand-sub {
            font-size: 0.7rem;
            color: var(--cl-red);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .header-search {
            flex: 1; max-width: 420px; margin: 0 32px;
            display: flex;
            border: 1.5px solid #d0dce8;
            border-radius: 6px;
            overflow: hidden;
            background: #f8fafc;
        }
        .header-search input {
            flex: 1; border: none; outline: none;
            padding: 9px 16px; font-size: 0.88rem;
            background: transparent; color: var(--cl-text);
        }
        .header-search input::placeholder { color: #9ab; }
        .header-search button {
            background: var(--cl-blue); border: none;
            color: white; padding: 0 18px; cursor: pointer;
            font-size: 0.9rem; transition: background .2s;
        }
        .header-search button:hover { background: var(--cl-blue-dark); }

        .header-contact { display: flex; align-items: center; gap: 20px; }
        .hotline-wrap { display: flex; align-items: center; gap: 10px; }
        .hotline-icon {
            width: 38px; height: 38px; border-radius: 50%;
            background: var(--cl-red); color: white;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem;
        }
        .hotline-number { font-weight: 700; font-size: 1.05rem; color: var(--cl-red); }
        .hotline-label { font-size: 0.72rem; color: var(--cl-muted); }

        .header-auth { display: flex; gap: 8px; align-items: center; }
        .btn-register {
            background: var(--cl-blue); color: white;
            border: none; border-radius: 5px;
            padding: 8px 20px; font-weight: 600; font-size: 0.85rem;
            cursor: pointer; transition: background .2s; text-decoration: none;
            white-space: nowrap;
        }
        .btn-register:hover { background: var(--cl-blue-dark); color: white; }
        .btn-login {
            background: white; color: var(--cl-blue);
            border: 1.5px solid var(--cl-blue);
            border-radius: 5px;
            padding: 8px 20px; font-weight: 600; font-size: 0.85rem;
            cursor: pointer; transition: all .2s; text-decoration: none;
            white-space: nowrap;
        }
        .btn-login:hover { background: var(--cl-blue); color: white; }

        /* ── NAVIGATION ── */
        .main-nav {
            background: var(--cl-blue-nav);
            position: sticky; top: 0; z-index: 1000;
            box-shadow: 0 2px 12px rgba(21,101,192,.3);
        }
        .nav-list {
            display: flex; align-items: center;
            list-style: none; margin: 0; padding: 0; gap: 0;
        }
        .nav-item { position: relative; }
        .nav-link-cl {
            display: flex; align-items: center; gap: 6px;
            color: rgba(255,255,255,.92) !important;
            padding: 14px 18px;
            font-size: 0.88rem; font-weight: 500;
            text-decoration: none;
            transition: background .2s, color .2s;
            white-space: nowrap;
        }
        .nav-link-cl:hover, .nav-link-cl.active {
            background: rgba(255,255,255,.15);
            color: #fff !important;
        }
        .nav-link-cl i { font-size: 0.8rem; }
        .nav-home-icon { font-size: 1.1rem !important; }

        /* User avatar in nav */
        .nav-user-wrap {
            display: flex; align-items: center; gap: 8px;
            padding: 8px 18px;
        }
        .nav-user-avatar {
            width: 32px; height: 32px; border-radius: 50%;
            background: rgba(255,255,255,.25);
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 0.85rem;
        }
        .nav-user-name { color: rgba(255,255,255,.95); font-size: 0.85rem; font-weight: 500; }

        /* ── MAIN CONTENT ── */
        main.flex-grow-1 { background: var(--cl-bg); }

        /* ── FOOTER ── */
        .footer-cl {
            background: var(--cl-blue-nav);
            color: rgba(255,255,255,.85);
            padding: 40px 0 0;
        }
        .footer-logo-name {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800; font-size: 1.05rem; color: #fff;
        }
        .footer-logo-sub { font-size: 0.72rem; color: rgba(255,255,255,.6); }
        .footer-desc { font-size: 0.82rem; color: rgba(255,255,255,.7); line-height: 1.7; margin-top: 10px; }
        .footer-social a {
            width: 32px; height: 32px;
            border-radius: 6px;
            background: rgba(255,255,255,.12);
            color: white; display: inline-flex;
            align-items: center; justify-content: center;
            margin-right: 6px; text-decoration: none;
            transition: background .2s;
        }
        .footer-social a:hover { background: rgba(255,255,255,.3); }
        .footer-col-title {
            font-size: 0.78rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 1px;
            color: rgba(255,255,255,.95); margin-bottom: 14px;
            border-bottom: 2px solid rgba(255,255,255,.15); padding-bottom: 8px;
        }
        .footer-schedule-row {
            display: flex; justify-content: space-between;
            padding: 6px 0; font-size: 0.82rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }
        .footer-schedule-row:last-child { border: none; }
        .footer-schedule-row .day { color: rgba(255,255,255,.7); }
        .footer-schedule-row .time { font-weight: 600; color: #fff; }
        .footer-contact-item {
            display: flex; gap: 10px; align-items: flex-start;
            margin-bottom: 10px; font-size: 0.82rem;
        }
        .footer-contact-item i { color: rgba(255,255,255,.5); margin-top: 2px; width: 14px; text-align: center; }
        .footer-contact-item span { color: rgba(255,255,255,.8); line-height: 1.5; }
        .footer-bottom {
            background: rgba(0,0,0,.15);
            padding: 14px 0;
            text-align: center;
            font-size: 0.78rem;
            color: rgba(255,255,255,.5);
            margin-top: 32px;
        }

        /* ── CHATBOT POPUP (giữ nguyên) ── */
        .chatbot-popup {
            position: fixed; bottom: 90px; right: 25px;
            width: 360px; height: 520px;
            background: white; border-radius: 18px;
            box-shadow: 0 15px 50px rgba(0,0,0,.18);
            display: none; flex-direction: column;
            z-index: 99999; overflow: hidden;
            animation: slideUp .3s cubic-bezier(.175,.885,.32,1.275);
        }
        @@keyframes slideUp {
            from { opacity:0; transform:translateY(30px) scale(.95); }
            to   { opacity:1; transform:translateY(0) scale(1); }
        }
        .chatbot-header {
            background: linear-gradient(135deg, var(--cl-blue), #1a56db);
            padding: 16px 20px; color: white; font-weight: 600;
        }
        .chat-messages {
            flex: 1; overflow-y: auto; padding: 16px;
            background: #f8fafc;
        }
        .chat-messages::-webkit-scrollbar { width: 4px; }
        .chat-messages::-webkit-scrollbar-thumb { background: #c8d4e0; border-radius: 4px; }
        .chat-bubble {
            max-width: 85%; padding: 10px 14px;
            font-size: 0.88rem; line-height: 1.5; word-wrap: break-word;
        }
        .ai-bubble {
            background: white; color: #334155;
            border-radius: 14px 14px 14px 4px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 2px 6px rgba(0,0,0,.04);
        }
        .user-bubble {
            background: linear-gradient(135deg, var(--cl-blue), #1a56db);
            color: white; border-radius: 14px 14px 4px 14px;
            box-shadow: 0 4px 12px rgba(26,115,200,.25);
        }
        .chat-input-area { padding: 12px 14px; background: white; border-top: 1px solid #f1f5f9; }
        .chat-input-wrapper {
            background: #f1f5f9; border-radius: 40px;
            padding: 4px 4px 4px 16px;
            display: flex; align-items: center;
        }
        .chat-input-wrapper input {
            border: none; background: transparent;
            flex: 1; outline: none; color: var(--cl-text); font-size: 0.88rem;
        }
        .chat-send-btn {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--cl-blue); color: white;
            border: none; display: flex; align-items: center;
            justify-content: center; cursor: pointer; transition: .2s;
        }
        .chat-send-btn:hover { background: var(--cl-blue-dark); }

        /* Popup welcome */
        .popup-welcome {
            display: flex; flex-direction: column; align-items: center;
            padding: 16px 14px 12px; gap: 5px;
            border-bottom: 1px solid #f1f5f9;
        }
        .popup-welcome-title { font-size: 0.88rem; font-weight: 600; color: var(--cl-text); margin: 0; }
        .popup-welcome-sub   { font-size: 0.76rem; color: #8a9bb0; margin: 0 0 6px; }
        .popup-suggestions   { display: flex; flex-direction: column; gap: 6px; width: 100%; }
        .popup-suggestion-btn {
            background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 9px;
            padding: 8px 12px; font-size: 0.78rem; color: var(--cl-blue); font-weight: 500;
            cursor: pointer; text-align: left; display: flex; align-items: center; gap: 7px;
            transition: all .2s; line-height: 1.4;
        }
        .popup-suggestion-btn:hover { background: #eff6ff; border-color: var(--cl-blue); transform: translateX(2px); }
        .popup-suggestion-btn i { font-size: 0.8rem; flex-shrink: 0; color: var(--cl-orange); }

        /* AI Floating button */
        .ai-floating-btn {
            position: fixed; bottom: 25px; right: 25px;
            width: 58px; height: 58px; border-radius: 50%;
            background: linear-gradient(135deg, var(--cl-blue), #1a56db);
            color: white; border: none; font-size: 22px;
            box-shadow: 0 8px 24px rgba(26,115,200,.4);
            cursor: pointer; z-index: 999999;
            transition: transform .3s cubic-bezier(.175,.885,.32,1.275);
        }
        .ai-floating-btn:hover { transform: scale(1.1); }

        /* Global doctor chat widget */
        .global-chat-widget-container {
            position: fixed; bottom: 24px; right: 24px;
            display: flex; align-items: center; justify-content: flex-end; gap: 16px;
            z-index: 9999; height: 64px; overflow: visible;
        }
        .global-widget-item { position: relative; display: flex; align-items: center; justify-content: center; }
        .global-chat-trigger {
            position: relative; width: 60px; height: 60px; border-radius: 50%;
            background: linear-gradient(135deg, var(--cl-blue), #1a56db);
            color: #fff; display: flex; align-items: center; justify-content: center;
            font-size: 24px; cursor: pointer;
            box-shadow: 0 8px 32px rgba(26,115,200,.4); z-index: 10;
            transition: all .3s cubic-bezier(.175,.885,.32,1.275);
        }
        .global-chat-trigger:hover { transform: scale(1.1) rotate(5deg); }
        .global-chat-trigger .pulse-ring {
            position: absolute; width: 100%; height: 100%;
            border-radius: 50%; border: 2px solid var(--cl-blue);
            animation: ringPulse 2s infinite; opacity: 0; pointer-events: none;
        }
        @@keyframes ringPulse { 0% { transform:scale(1);opacity:.8; } 100% { transform:scale(1.4);opacity:0; } }
        .global-call-trigger {
            position: relative; width: 60px; height: 60px; border-radius: 50%;
            background: #f1faf5; color: #10b981;
            border: 1px solid rgba(16,185,129,.2);
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; cursor: pointer;
            box-shadow: 0 6px 20px rgba(16,185,129,.15); z-index: 5;
            opacity: 0; transform: translateX(76px) scale(.5); pointer-events: none;
            transition: all .35s cubic-bezier(.175,.885,.32,1.275); text-decoration: none;
        }
        .global-chat-widget-container:hover .global-call-trigger {
            opacity: 1; transform: translateX(0) scale(1); pointer-events: auto;
        }
        .global-call-trigger:hover { background: #10b981; color: #fff; transform: scale(1.1); }
        .global-chat-tooltip, .global-call-tooltip {
            position: absolute; bottom: 74px;
            background: #1e293b; color: #fff; padding: 8px 16px;
            border-radius: 8px; font-size: .82rem; font-weight: 500;
            white-space: nowrap; box-shadow: 0 6px 20px rgba(15,23,42,.2);
            opacity: 0; pointer-events: none;
            transform: translateY(10px) scale(.9);
            transition: all .3s cubic-bezier(.175,.885,.32,1.275); z-index: 100;
        }
        .global-chat-tooltip::after, .global-call-tooltip::after {
            content: ''; position: absolute; bottom: -6px; left: 50%;
            transform: translateX(-50%) rotate(45deg);
            width: 12px; height: 12px; background: #1e293b;
        }
        .global-widget-item:hover .global-chat-tooltip,
        .global-widget-item:hover .global-call-tooltip {
            opacity: 1; transform: translateY(0) scale(1);
        }
        .chat-badge {
            position: absolute; top: -5px; right: -5px;
            background: #ef4444; color: #fff; font-size: .72rem; font-weight: 700;
            width: 22px; height: 22px; border-radius: 50%;
            display: none; align-items: center; justify-content: center;
            border: 2px solid #fff; box-shadow: 0 2px 8px rgba(239,68,68,.4);
            animation: pulseBadge 2s infinite; z-index: 12;
        }
        @@keyframes pulseBadge { 0%,100% { transform:scale(1); } 50% { transform:scale(1.15); } }
        .global-chat-box {
            position: fixed; bottom: 96px; right: 24px;
            width: 400px; height: 600px; z-index: 9998;
            border-radius: 16px; box-shadow: 0 12px 40px rgba(15,23,42,.15);
            border: 1px solid rgba(226,232,240,1); background: #fff;
            display: none; flex-direction: column; overflow: hidden;
            transform: translateY(20px) scale(.95); opacity: 0;
            transition: all .3s cubic-bezier(.175,.885,.32,1.15);
        }
        .global-chat-box.active { display: flex; transform: translateY(0) scale(1); opacity: 1; }
        .global-chat-box.doctor-mode { width: 850px; max-width: 90vw; height: 700px; max-height: 85vh; }
        .global-chat-header {
            background: #f8fafc; padding: 12px 16px;
            border-bottom: 1px solid #e2e8f0;
            display: flex; align-items: center; justify-content: space-between;
        }
        .global-chat-header-title { font-weight: 700; font-size: .9rem; color: #1e293b; display: flex; align-items: center; gap: 8px; }
        .global-chat-header-title i { color: var(--cl-blue); }
        .global-chat-close-btn { background: none; border: none; font-size: 1rem; color: #94a3b8; cursor: pointer; padding: 4px; transition: color .2s; }
        .global-chat-close-btn:hover { color: #ef4444; }
        .global-chat-iframe { width: 100%; height: calc(100% - 45px); border: none; }
        @@media(max-width:576px) {
            .global-chat-box { bottom:0!important;right:0!important;width:100vw!important;height:100vh!important;border-radius:0!important; }
            .global-chat-box.doctor-mode { width:100vw!important;max-width:100vw!important;height:100vh!important;max-height:100vh!important;border-radius:0!important; }
        }
        @@media(max-width:992px) {
            .header-search { display: none; }
            .header-main .container-xl { flex-wrap: wrap; gap: 10px; }
        }

        /* Unified Support Hub */
        .sh-hub-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
        }
        .sh-hub-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--cl-blue), #1a56db);
            color: white;
            border: none;
            font-size: 24px;
            cursor: pointer;
            position: relative;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 8px 32px rgba(26, 115, 200, 0.4);
        }
        .sh-hub-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 12px 40px rgba(26, 115, 200, 0.6);
        }
        .sh-hub-btn:active {
            transform: scale(0.95);
        }
        .sh-hub-btn i {
            transition: transform 0.3s ease;
        }
        .sh-hub-btn.active i {
            transform: rotate(90deg);
        }
        .sh-hub-menu {
            position: absolute;
            bottom: 76px;
            right: 0;
            width: 320px;
            background: white;
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15);
            padding: 16px;
            display: none;
            flex-direction: column;
            gap: 12px;
            transform: translateY(15px);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.15);
            pointer-events: none;
        }
        .sh-hub-menu.active {
            display: flex;
            transform: translateY(0);
            opacity: 1;
            pointer-events: auto;
        }
        .sh-hub-header {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            font-weight: 700;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 10px;
        }
        .sh-hub-items {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .sh-hub-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border: 1px solid transparent;
            border-radius: 14px;
            background: #f8fafc;
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: left;
            width: 100%;
        }
        .sh-hub-item:hover {
            background: #f1f5f9;
            border-color: rgba(26, 115, 200, 0.15);
            transform: translateX(-2px);
        }
        .sh-hub-item-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }
        .sh-hub-item-icon.ai {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
        }
        .sh-hub-item-icon.doctor {
            background: rgba(99, 102, 241, 0.1);
            color: #6366f1;
        }
        .sh-hub-item-icon.hotline {
            background: rgba(245, 158, 11, 0.1);
            color: #f59e0b;
        }
        .sh-hub-item-info {
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        .sh-hub-item-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: #1e293b;
        }
        .sh-hub-item-desc {
            font-size: 0.72rem;
            color: #64748b;
            margin-top: 1px;
        }
        .main-hub-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #ef4444;
            color: white;
            font-size: 0.72rem;
            font-weight: 700;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
            box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
            animation: pulseBadge 2s infinite;
            z-index: 12;
        }

        /* ── AI CHATBOT FEEDBACK WIDGET ── */
        .cb-feedback-row {
            display: flex; justify-content: flex-start;
            animation: cbFadeIn .35s ease-out;
        }
        .cb-feedback-card {
            background: linear-gradient(135deg, rgba(14,165,233,.06), rgba(99,102,241,.06));
            border: 1.5px solid rgba(14,165,233,.18);
            border-radius: 14px; padding: 12px 16px;
            display: flex; flex-direction: column; gap: 8px;
            max-width: 92%;
        }
        .cb-feedback-question {
            font-size: .82rem; font-weight: 600; color: #334155;
            display: flex; align-items: center; gap: 6px;
        }
        .cb-feedback-question i { color: var(--cl-blue); }
        .cb-feedback-actions { display: flex; gap: 6px; }
        .cb-fb-btn {
            display: flex; align-items: center; gap: 5px;
            padding: 6px 14px; border-radius: 8px;
            border: 1.5px solid #e2e8f0; background: #fff;
            font-size: .78rem; font-weight: 600; cursor: pointer;
            transition: all .2s;
        }
        .cb-fb-btn i { font-size: .9rem; }
        .cb-fb-btn.like { color: #10b981; }
        .cb-fb-btn.like:hover { background: rgba(16,185,129,.1); border-color: #10b981; }
        .cb-fb-btn.dislike { color: #ef4444; }
        .cb-fb-btn.dislike:hover { background: rgba(239,68,68,.08); border-color: #ef4444; }
        .cb-fb-thanks {
            display: flex; align-items: center; gap: 6px;
            font-size: .78rem; font-weight: 600;
            padding: 6px 12px; border-radius: 8px;
        }
        .cb-fb-thanks.positive { color: #10b981; background: rgba(16,185,129,.08); }
        .cb-fb-thanks.negative { color: #f59e0b; background: rgba(245,158,11,.08); }
        .cb-contact-row {
            display: flex; justify-content: flex-start;
            animation: cbFadeIn .35s ease-out;
        }
        .cb-contact-card {
            background: linear-gradient(135deg, rgba(99,102,241,.06), rgba(14,165,233,.06));
            border: 1.5px solid rgba(99,102,241,.18);
            border-radius: 14px; padding: 12px 16px;
            display: flex; flex-direction: column; gap: 10px;
            max-width: 92%;
        }
        .cb-contact-text {
            font-size: .8rem; color: #475569; line-height: 1.5;
        }
        .cb-contact-text i { color: #6366f1; margin-right: 4px; }
        .cb-contact-actions { display: flex; gap: 8px; align-items: center; }
        .cb-btn-doctor {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 8px 16px; border-radius: 8px; border: none;
            background: linear-gradient(135deg, var(--cl-blue), #1a56db); color: #fff;
            font-size: .78rem; font-weight: 700; cursor: pointer;
            transition: all .2s;
            box-shadow: 0 3px 10px rgba(26,115,200,.3);
        }
        .cb-btn-doctor:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(26,115,200,.4); }
        .cb-btn-later {
            padding: 6px 12px; border-radius: 8px;
            border: 1.5px solid #e2e8f0; background: #fff;
            color: #94a3b8; font-size: .76rem; font-weight: 600;
            cursor: pointer; transition: all .2s;
        }
        .cb-btn-later:hover { border-color: #94a3b8; color: #475569; }
        @@keyframes cbFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
