<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="description" content="SmartHealth - Hệ thống quản lý hồ sơ bệnh án và theo dõi sức khỏe thông minh, cảnh báo bệnh sớm bằng AI." />
	<title>@ViewData["Title"] - SmartHealth</title>

	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

	<style>
		:root {
			--primary: #0ea5e9;
			--primary-dark: #0284c7;
			--secondary: #6366f1;
			--accent: #10b981;
			--warn: #f59e0b;
			--danger: #ef4444;
			--grad: linear-gradient(135deg,#0ea5e9 0%,#6366f1 100%);
			--bg: #ffffff;
			--bg-soft: #f8fafc;
			--border: #e2e8f0;
			--text: #0f172a;
			--text-sub: #475569;
			--text-muted: #94a3b8;
		}

		*, *::before, *::after {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
		}

		/* ĐÃ THÊM FLEXBOX VÀO BODY ĐỂ ÉP FOOTER XUỐNG ĐÁY */
		body {
			font-family: 'Inter',sans-serif;
			background: var(--bg);
			color: var(--text);
			overflow-x: hidden;
			display: flex;
			flex-direction: column;
			min-height: 100vh;
		}

		a {
			text-decoration: none;
			color: inherit;
		}

		::-webkit-scrollbar {
			width: 5px;
		}

		::-webkit-scrollbar-track {
			background: #f1f5f9;
		}

		::-webkit-scrollbar-thumb {
			background: var(--grad);
			border-radius: 3px;
		}

		/* ── NAVBAR ── */
		.navbar-main {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			z-index: 1000;
			background: rgba(255,255,255,0.92);
			backdrop-filter: blur(16px);
			-webkit-backdrop-filter: blur(16px);
			border-bottom: 1px solid var(--border);
			padding: 0;
			transition: box-shadow .3s;
		}

			.navbar-main.elevated {
				box-shadow: 0 4px 24px rgba(14,165,233,.12);
			}

		.nav-inner {
			max-width: 1280px;
			margin: 0 auto;
			padding: 0 32px;
			height: 70px;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.nav-logo {
			display: flex;
			align-items: center;
			gap: 10px;
			flex: 1; /* Chiếm 1 phần không gian để cân bằng với bên phải */
		}

		.nav-logo-icon {
			width: 40px;
			height: 40px;
			border-radius: 11px;
			background: var(--grad);
			display: flex;
			align-items: center;
			justify-content: center;
			box-shadow: 0 4px 14px rgba(14,165,233,.35);
			flex-shrink: 0;
		}

			.nav-logo-icon i {
				color: #fff;
				font-size: 17px;
			}

		.nav-logo-name {
			font-family: 'Plus Jakarta Sans',sans-serif;
			font-weight: 800;
			font-size: 1.15rem;
			background: var(--grad);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			background-clip: text;
		}

		.nav-logo-tag {
			display: block;
			font-size: .6rem;
			color: var(--text-muted);
			letter-spacing: 1px;
			text-transform: uppercase;
			margin-top: -3px;
			-webkit-text-fill-color: var(--text-muted);
		}

		/* Các link điều hướng */
		.nav-links {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 24px; /* Tăng khoảng cách giữa các link để dễ nhìn hơn */
			list-style: none;
			margin-bottom: 0; /* ÉP BUỘC: Xóa margin mặc định của <ul> trong Bootstrap để không bị lệch dọc */
		}

			.nav-links a {
				font-size: .875rem;
				font-weight: 500;
				color: var(--text-sub);
				padding: 7px 15px;
				border-radius: 8px;
				transition: all .2s;
				position: relative;
				/* Thêm thuộc tính này để chữ không bị bẻ dòng nếu màn hình thu nhỏ */
				white-space: nowrap;
			}

				.nav-links a:hover {
					color: var(--primary);
					background: rgba(14,165,233,.07);
				}

		/* Khu vực nút bấm */
		.nav-actions {
			display: flex;
			align-items: center;
			justify-content: flex-end; /* Đẩy các nút về sát lề phải */
			gap: 12px; /* Tăng khoảng cách giữa nút Đăng nhập và Đăng ký */
			flex: 1; /* Chiếm 1 phần không gian để ép cụm .nav-links vào đúng vị trí center */
		}

		.btn-ghost {
			font-size: .875rem;
			font-weight: 500;
			color: var(--text-sub);
			padding: 7px 18px;
			border: 1px solid var(--border);
			border-radius: 8px;
			background: transparent;
			transition: all .2s;
		}

			.btn-ghost:hover {
				color: var(--primary);
				border-color: var(--primary);
				background: rgba(14,165,233,.06);
			}

		.btn-outline-primary-nav {
			font-size: .875rem;
			font-weight: 600;
			color: var(--primary);
			padding: 7px 18px;
			border: 1.5px solid rgba(14,165,233,.5);
			border-radius: 8px;
			background: rgba(14,165,233,.06);
			transition: all .2s;
		}

			.btn-outline-primary-nav:hover {
				background: var(--primary);
				color: #fff;
				border-color: var(--primary);
			}

		.btn-appointment {
			font-size: .875rem;
			font-weight: 700;
			color: #fff;
			padding: 9px 22px;
			border-radius: 50px;
			background: var(--grad);
			border: none;
			box-shadow: 0 4px 14px rgba(14,165,233,.3);
			transition: all .3s;
			cursor: pointer;
		}

			.btn-appointment:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(14,165,233,.45);
				color: #fff;
			}

		/* ── PAGE ── */
		/* ĐÃ THÊM flex: 1 ĐỂ NỘI DUNG TỰ ĐỘNG GIÃN RA ĐẨY FOOTER XUỐNG DƯỚI */
		.page-main {
			background: #fff;
			flex: 1;
			padding-top: 90px; /* THÊM DÒNG NÀY ĐỂ ĐẨY NỘI DUNG XUỐNG */
		}

		/* ── FOOTER ĐÃ ĐƯỢC THU GỌN ── */
		footer {
			background: #0f172a;
			color: #cbd5e1;
			padding: 40px 0 0;
			position: relative;
			overflow: hidden;
		}

			footer::before {
				content: '';
				position: absolute;
				top: -180px;
				left: 50%;
				transform: translateX(-50%);
				width: 900px;
				height: 400px;
				background: radial-gradient(ellipse,rgba(14,165,233,.08) 0%,transparent 70%);
				pointer-events: none;
			}

		.foot-inner {
			max-width: 1280px;
			margin: 0 auto;
			padding: 0 32px;
		}

		.foot-grid {
			display: grid;
			grid-template-columns: 2fr 1fr 1fr 1fr;
			gap: 24px;
			padding-bottom: 30px;
		}

		.foot-brand p {
			font-size: .85rem;
			line-height: 1.6;
			color: #64748b;
			max-width: 270px;
			margin-top: 10px;
		}

		.foot-socials {
			display: flex;
			gap: 10px;
			margin-top: 12px;
		}

		.soc-btn {
			width: 32px;
			height: 32px;
			border-radius: 8px;
			border: 1px solid rgba(148,163,184,.15);
			display: flex;
			align-items: center;
			justify-content: center;
			color: #64748b;
			font-size: .8rem;
			transition: all .2s;
		}

			.soc-btn:hover {
				border-color: var(--primary);
				color: var(--primary);
				background: rgba(14,165,233,.08);
				transform: translateY(-2px);
			}

		.foot-col h5 {
			font-size: .72rem;
			font-weight: 700;
			letter-spacing: 1.5px;
			text-transform: uppercase;
			color: #475569;
			margin-bottom: 12px;
		}

		.foot-col ul {
			list-style: none;
		}

			.foot-col ul li {
				margin-bottom: 6px;
			}

				.foot-col ul li a {
					font-size: .84rem;
					color: #64748b;
					transition: color .2s;
				}

					.foot-col ul li a:hover {
						color: var(--primary);
					}

		.foot-contact-item {
			display: flex;
			align-items: flex-start;
			gap: 10px;
			margin-bottom: 8px;
		}

			.foot-contact-item .ic {
				width: 26px;
				height: 26px;
				border-radius: 6px;
				background: rgba(14,165,233,.1);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--primary);
				font-size: .7rem;
				flex-shrink: 0;
			}

			.foot-contact-item span {
				font-size: .82rem;
				color: #64748b;
				line-height: 1.5;
			}

		.foot-status {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			margin-top: 8px;
			background: rgba(16,185,129,.1);
			border: 1px solid rgba(16,185,129,.2);
			border-radius: 50px;
			padding: 4px 10px;
			font-size: .7rem;
			color: #10b981;
			font-weight: 500;
		}

		.pdot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: #10b981;
			animation: pd 1.5s infinite;
		}

		.foot-bottom {
			border-top: 1px solid rgba(148,163,184,.1);
			padding: 16px 0;
			display: flex;
			align-items: center;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 12px;
		}

			.foot-bottom p, .foot-bottom a {
				font-size: .78rem;
				color: #475569;
			}

				.foot-bottom a:hover {
					color: var(--primary);
				}

		.foot-bottom-links {
			display: flex;
			gap: 20px;
		}

		/* ══════════════════════════════════════════════
		   GLOBAL FLOATING CHAT WIDGET STYLES
		   ══════════════════════════════════════════════ */
		.global-chat-widget-container {
			position: fixed;
			bottom: 24px;
			right: 24px;
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: 16px;
			z-index: 9999;
			height: 64px;
			overflow: visible;
		}
		.global-widget-item {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.global-chat-trigger {
			position: relative;
			width: 60px;
			height: 60px;
			border-radius: 50%;
			background: var(--grad);
			color: #fff;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 24px;
			cursor: pointer;
			box-shadow: 0 8px 32px rgba(14,165,233,.4);
			z-index: 10;
			transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		}
		.global-chat-trigger:hover {
			transform: scale(1.1) rotate(5deg);
			box-shadow: 0 12px 40px rgba(14,165,233,.6);
		}
		.global-chat-trigger:active {
			transform: scale(0.95);
		}
		.global-chat-trigger .pulse-ring {
			position: absolute;
			width: 100%;
			height: 100%;
			border-radius: 50%;
			border: 2px solid var(--primary);
			animation: ringPulse 2s infinite;
			opacity: 0;
			pointer-events: none;
		}
		.global-call-trigger {
			position: relative;
			width: 60px;
			height: 60px;
			border-radius: 50%;
			background: #f1faf5;
			color: #10b981;
			border: 1px solid rgba(16, 185, 129, 0.2);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 20px;
			cursor: pointer;
			box-shadow: 0 6px 20px rgba(16,185,129,.15);
			z-index: 5;
			opacity: 0;
			transform: translateX(76px) scale(0.5);
			pointer-events: none;
			transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			text-decoration: none;
		}
		.global-chat-widget-container:hover .global-call-trigger {
			opacity: 1;
			transform: translateX(0) scale(1);
			pointer-events: auto;
		}
		.global-call-trigger:hover {
			background: #10b981;
			color: #fff;
			transform: scale(1.1);
			box-shadow: 0 8px 24px rgba(16,185,129,.35);
		}
		.global-chat-tooltip, .global-call-tooltip {
			position: absolute;
			bottom: 74px;
			background: #1e293b;
			color: #fff;
			padding: 8px 16px;
			border-radius: 8px;
			font-size: 0.82rem;
			font-weight: 500;
			white-space: nowrap;
			box-shadow: 0 6px 20px rgba(15, 23, 42, 0.2);
			opacity: 0;
			pointer-events: none;
			transform: translateY(10px) scale(0.9);
			transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			z-index: 100;
		}
		.global-chat-tooltip::after, .global-call-tooltip::after {
			content: '';
			position: absolute;
			bottom: -6px;
			left: 50%;
			transform: translateX(-50%) rotate(45deg);
			width: 12px;
			height: 12px;
			background: #1e293b;
		}
		.global-widget-item:hover .global-chat-tooltip {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
		.global-widget-item:hover .global-call-tooltip {
			opacity: 1;
			transform: translateY(0) scale(1);
		}

		/* Doctor badge */
		.chat-badge {
			position: absolute;
			top: -5px;
			right: -5px;
			background: var(--danger);
			color: #fff;
			font-size: 0.72rem;
			font-weight: 700;
			width: 22px;
			height: 22px;
			border-radius: 50%;
			display: none;
			align-items: center;
			justify-content: center;
			border: 2px solid #fff;
			box-shadow: 0 2px 8px rgba(239,68,68,.4);
			animation: pulseBadge 2s infinite;
			z-index: 12;
		}

		@@keyframes pulseBadge {
			0% { transform: scale(1); }
			50% { transform: scale(1.15); }
			100% { transform: scale(1); }
		}
		.global-chat-box {
			position: fixed;
			bottom: 96px;
			right: 24px;
			width: 400px;
			height: 600px;
			z-index: 9998;
			border-radius: 16px;
			box-shadow: 0 12px 40px rgba(15, 23, 42, 0.15);
			border: 1px solid var(--border);
			background: #fff;
			display: none;
			flex-direction: column;
			overflow: hidden;
			transform: translateY(20px) scale(0.95);
			opacity: 0;
			transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.15);
		}
		.global-chat-box.active {
			display: flex;
			transform: translateY(0) scale(1);
			opacity: 1;
		}
		.global-chat-box.doctor-mode {
			width: 850px;
			max-width: 90vw;
			height: 700px;
			max-height: 85vh;
		}
		.global-chat-header {
			background: var(--bg-soft);
			padding: 12px 16px;
			border-bottom: 1px solid var(--border);
			display: flex;
			align-items: center;
			justify-content: space-between;
		}
		.global-chat-header-title {
			font-weight: 700;
			font-size: 0.9rem;
			color: var(--text);
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.global-chat-header-title i {
			color: var(--primary);
		}
		.global-chat-close-btn {
			background: none;
			border: none;
			font-size: 1rem;
			color: var(--text-muted);
			cursor: pointer;
			padding: 4px;
			transition: color 0.2s;
		}
		.global-chat-close-btn:hover {
			color: var(--danger);
		}
		.global-chat-iframe {
			width: 100%;
			height: calc(100% - 45px);
			border: none;
		}

		@@keyframes ringPulse {
			0% { transform: scale(1); opacity: 0.8; }
			100% { transform: scale(1.4); opacity: 0; }
		}

		/* RESPONSIVE NAVBAR MEDIA QUERIES */
		@@media (max-width: 1200px) {
			.nav-inner {
				padding: 0 16px;
			}
			.nav-links {
				gap: 12px;
			}
			.nav-links a {
				padding: 6px 10px;
				font-size: 0.825rem;
			}
			.nav-logo-name {
				font-size: 1.05rem;
			}
			.btn-ghost, .btn-outline-primary-nav {
				padding: 6px 12px;
				font-size: 0.8rem;
			}
		}

		@@media (max-width: 992px) {
			.nav-links {
				gap: 8px;
			}
			.nav-links a {
				padding: 5px 8px;
				font-size: 0.8rem;
			}
			.nav-logo-tag {
				display: none;
			}
			.nav-actions {
				gap: 8px;
			}
		}

		@@media (max-width: 768px) {
			.nav-inner {
				flex-direction: column;
				height: auto;
				padding: 10px 16px;
				gap: 10px;
			}
			.nav-logo {
				flex: none;
				width: 100%;
				justify-content: center;
			}
			.nav-links {
				width: 100%;
				justify-content: center;
				overflow-x: auto;
				padding-bottom: 4px;
				white-space: nowrap;
				-webkit-overflow-scrolling: touch;
			}
			.nav-actions {
				flex: none;
				width: 100%;
				justify-content: center;
				margin-top: 5px;
			}
			.page-main {
				padding-top: 150px;
			}
		}

		@@media (max-width: 576px) {
			.global-chat-box {
				bottom: 0 !important;
				right: 0 !important;
				width: 100vw !important;
				height: 100vh !important;
				border-radius: 0 !important;
			}
			.global-chat-box.doctor-mode {
				width: 100vw !important;
				max-width: 100vw !important;
				height: 100vh !important;
				max-height: 100vh !important;
				border-radius: 0 !important;
			}
		}
	</style>

	@await RenderSectionAsync("Styles", required: false)
</head>

<body>

	<nav class="navbar-main" id="mainNav">
		<div class="nav-inner">

			<a href="/" class="nav-logo">
				<div class="nav-logo-icon"><i class="fas fa-heartbeat"></i></div>
				<div>
					<span class="nav-logo-name">SmartHealth</span>
					<span class="nav-logo-tag">Monitoring System</span>
				</div>
			</a>

			<ul class="nav-links">
				@{
					var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
					bool isDoctor = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("1");
				}

				<li>
					<a asp-controller="Home" asp-action="Index"
					   style="@(currentController == "Home" ? "color: var(--primary); font-weight: 600; background: rgba(14,165,233,.07);" : "")">
						Trang chủ
					</a>
				</li>
				@if (isDoctor)
				{
					<li>
						<a asp-controller="DoctorDashboard" asp-action="Index"
						   style="@(currentController == "DoctorDashboard" ? "color: var(--primary); font-weight: 600; background: rgba(14,165,233,.07);" : "")">
							Bệnh nhân
						</a>
					</li>
					<li>
						<a asp-controller="WarningAlert" asp-action="Dashboard"
						   style="@(currentController == "WarningAlert" ? "color: var(--primary); font-weight: 600; background: rgba(14,165,233,.07);" : "")">
							Cảnh báo AI
						</a>
					</li>
					<li>
						<a asp-controller="EmailNotification" asp-action="Index"
						   style="@(currentController == "EmailNotification" ? "color: var(--primary); font-weight: 600; background: rgba(14,165,233,.07);" : "")">
							Lịch sử Email
						</a>
					</li>

				}
				else
				{
					@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("0"))
					{
						<li>
							<a asp-controller="Patient" asp-action="Index">Sổ tay hằng ngày</a>
