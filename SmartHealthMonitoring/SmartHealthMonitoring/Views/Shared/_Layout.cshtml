    <script>
        // Logic AI Chatbot popup
        document.addEventListener("DOMContentLoaded", function () {
            const openBtn = document.getElementById("openChatbot");
            const closeBtn = document.getElementById("closeChatbot");
            const popup   = document.getElementById("chatbotPopup");
            if (openBtn && popup) openBtn.addEventListener("click", () => popup.style.display = "flex");
            if (closeBtn && popup) closeBtn.addEventListener("click", () => popup.style.display = "none");
        });

        document.addEventListener("DOMContentLoaded", function () {
            const sendBtn  = document.getElementById("sendMessage");
            const input    = document.getElementById("chatInput");
            const messages = document.getElementById("chatMessages");
            if (!sendBtn || !input || !messages) return;

            // Xóa feedback cũ chưa tương tác
            function removeOldFeedback() {
                messages.querySelectorAll('.cb-feedback-row:not(.resolved), .cb-contact-row:not(.resolved)').forEach(el => el.remove());
            }

            // Hiện feedback like/dislike
            function showFeedback() {
                const row = document.createElement('div');
                row.className = 'cb-feedback-row mb-3';
                row.innerHTML = `
                    <div class="cb-feedback-card">
                        <div class="cb-feedback-question">
                            <i class="fas fa-star"></i> Thông tin trên có hữu ích cho bạn không?
                        </div>
                        <div class="cb-feedback-actions">
                            <button class="cb-fb-btn like" onclick="window._cbFeedback(this,'like')">
                                <i class="fas fa-thumbs-up"></i> Hữu ích
                            </button>
                            <button class="cb-fb-btn dislike" onclick="window._cbFeedback(this,'dislike')">
                                <i class="fas fa-thumbs-down"></i> Chưa hữu ích
                            </button>
                        </div>
                    </div>`;
                messages.appendChild(row);
                scrollToBottom();
            }

            // Xử lý feedback
            window._cbFeedback = function (btn, type) {
                const row = btn.closest('.cb-feedback-row');
                if (!row) return;
                row.classList.add('resolved');
                const card = row.querySelector('.cb-feedback-card');

                if (type === 'like') {
                    card.innerHTML = '<div class="cb-fb-thanks positive"><i class="fas fa-check-circle"></i> Cảm ơn phản hồi của bạn! 💚</div>';
                } else {
                    card.innerHTML = '<div class="cb-fb-thanks negative"><i class="fas fa-exclamation-circle"></i> Cảm ơn phản hồi. Chúng tôi sẽ cải thiện!</div>';
                    showContactDoctor();
                }
                scrollToBottom();
            };

            // Hiện lựa chọn liên hệ bác sĩ
            function showContactDoctor() {
                const row = document.createElement('div');
                row.className = 'cb-contact-row mb-3';
                row.innerHTML = `
                    <div class="cb-contact-card">
                        <div class="cb-contact-text">
                            <i class="fas fa-user-md"></i>
                            Bạn muốn được tư vấn trực tiếp bởi bác sĩ chuyên khoa?
                        </div>
                        <div class="cb-contact-actions">
                            <button class="cb-btn-doctor" onclick="window.location.href='/Chat/Index'">
                                <i class="fas fa-comments"></i> Liên hệ bác sĩ ngay
                            </button>
                            <button class="cb-btn-later" onclick="window._cbSkipDoctor(this)">Để sau</button>
                        </div>
                    </div>`;
                messages.appendChild(row);
                scrollToBottom();
            }

            window._cbSkipDoctor = function (btn) {
                const row = btn.closest('.cb-contact-row');
                if (!row) return;
                row.classList.add('resolved');
                row.querySelector('.cb-contact-card').innerHTML = '<div class="cb-fb-thanks" style="color:#94a3b8;background:rgba(148,163,184,.08)"><i class="fas fa-check"></i> Đã ghi nhận. Bạn có thể liên hệ bác sĩ qua mục <b>Tin nhắn</b>.</div>';
                scrollToBottom();
            };

            async function sendMessage() {
                const text = input.value.trim();
                if (!text) return;
                
                // Xóa feedback cũ chưa tương tác
                removeOldFeedback();

                hideWelcome();
                messages.innerHTML += `<div class="d-flex justify-content-end mb-2"><div class="chat-bubble user-bubble">${text}</div></div>`;
                input.value = "";
                scrollToBottom();

                const typingId = "typing-" + Date.now();
                messages.innerHTML += `<div id="${typingId}" class="d-flex justify-content-start mb-2"><div class="chat-bubble ai-bubble text-muted"><i class="fas fa-circle-notch fa-spin me-1"></i>Đang suy nghĩ...</div></div>`;
                scrollToBottom();

                try {
                    const res  = await fetch('/Chatbot/SendMessage', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Message: text })
                    });
                    const data = await res.json();
                    document.getElementById(typingId).remove();
                    if (data.success) {
                        messages.innerHTML += `<div class="d-flex justify-content-start mb-2"><div class="chat-bubble ai-bubble">${data.reply.replace(/\n/g,'<br>')}</div></div>`;
                        // Hiện feedback ngay sau câu trả lời AI
                        showFeedback();
                    } else {
                        messages.innerHTML += `<div class="text-center text-danger small mb-2">Lỗi: ${data.error}</div>`;
                    }
                } catch {
                    document.getElementById(typingId)?.remove();
                    messages.innerHTML += `<div class="text-center text-danger small mb-2">Mất kết nối máy chủ.</div>`;
                }
                scrollToBottom();
            }

            function scrollToBottom() { messages.scrollTop = messages.scrollHeight; }
            function hideWelcome() {
                const w = document.getElementById('popupWelcome');
                if (w) w.style.display = 'none';
            }

            sendBtn.addEventListener("click", sendMessage);
            input.addEventListener("keypress", e => { if (e.key === "Enter") sendMessage(); });

            window._popupSendMessage  = sendMessage;
            window._popupHideWelcome  = hideWelcome;
        });

        function sendPopupSuggestion(btn) {
            const text  = btn.innerText.trim();
            const input = document.getElementById('chatInput');
            if (input && window._popupSendMessage) {
                input.value = text;
                window._popupHideWelcome?.();
                window._popupSendMessage();
            }
        }
    </script>

