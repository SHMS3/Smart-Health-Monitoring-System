<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin SmartHealth</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            display: flex;
            min-height: 100vh;
            background-color: #f1f5f9;
            margin: 0;
        }

        .sidebar {
            width: 280px;
            background: #0f172a;
            color: #fff;
            display: flex;
            flex-direction: column;
            transition: all 0.3s;
        }

        .sidebar-header {
            padding: 24px;
            text-align: center;
            border-bottom: 1px solid #1e293b;
        }

        .nav-link {
            color: #94a3b8;
            padding: 14px 24px;
            font-weight: 500;
            border-left: 4px solid transparent;
            transition: 0.2s;
        }

            .nav-link:hover, .nav-link.active {
                background: #1e293b;
                color: #fff;
                border-left-color: #0ea5e9;
            }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        .topbar {
            background: #fff;
            padding: 16px 32px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }

        .page-content {
            padding: 32px;
            flex: 1;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h4 class="mb-0 fw-bold text-white"><i class="fas fa-heartbeat text-primary me-2"></i>SmartHealth</h4>
            <span class="badge bg-primary mt-2">Admin Portal</span>
        </div>
        <div class="d-flex flex-column gap-1 mt-4">
            <a asp-controller="AdminDashboard" asp-action="Index" class="nav-link text-decoration-none"><i class="fas fa-chart-pie me-3"></i>Tổng quan</a>
            <a asp-controller="AdminDoctor" asp-action="Index" class="nav-link text-decoration-none"><i class="fas fa-user-md me-3"></i>Quản lý Bác sĩ</a>
            <a asp-controller="AdminPatient" asp-action="Index" class="nav-link text-decoration-none"><i class="fas fa-users me-3"></i>Quản lý Bệnh nhân</a>
            <a asp-controller="StandardThreshold" asp-action="Index" class="nav-link text-decoration-none"><i class="fas fa-sliders me-3"></i>Ngưỡng Chuẩn Y Tế</a>
        </div>
        <div class="mt-auto p-4">
            <a href="/" class="btn btn-outline-light w-100 rounded-pill"><i class="fas fa-external-link-alt me-2"></i>Về Website</a>
        </div>
    </div>

    <div class="main-content">
        <div class="topbar shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <span class="fw-bold text-dark">Quản trị viên</span>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-light text-danger fw-bold rounded-pill px-3"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</button>
                </form>
            </div>
        </div>

        <div class="page-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm rounded-4"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 shadow-sm rounded-4"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>