<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin SmartHealth</title>
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <!-- Use Google Fonts 'Outfit' and 'Inter' for premium look -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        :root {
            --bg-body: #f4f7f9;
            --bg-sidebar: #0b1c2e; /* Deep medical blue */
            --color-primary: #0ea5e9;
            --color-primary-dark: #0284c7;
            --color-success: #10b981;
            --color-danger: #ef4444;
            --sidebar-width: 260px;
        }

        body {
            font-family: 'Inter', sans-serif;
            display: flex;
            min-height: 100vh;
            background-color: var(--bg-body);
            margin: 0;
            color: #334155;
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand {
            font-family: 'Outfit', sans-serif;
        }

        /* ─── SIDEBAR ─── */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--bg-sidebar);
            color: #fff;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; bottom: 0; left: 0;
            z-index: 1000;
            box-shadow: 4px 0 15px rgba(0,0,0,0.05);
        }

        .sidebar-header {
            padding: 28px 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .sidebar-header i {
            font-size: 1.8rem;
            color: var(--color-primary);
            filter: drop-shadow(0 0 8px rgba(14, 165, 233, 0.4));
        }

        .sidebar-header .brand-text {
            font-weight: 800;
            font-size: 1.4rem;
            letter-spacing: -0.5px;
            color: #fff;
            margin: 0;
        }

        .admin-badge {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            background: rgba(14, 165, 233, 0.2);
            color: var(--color-primary);
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: 700;
            margin-top: 4px;
            display: inline-block;
        }

        .nav-menu {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 20px 16px;
        }

        .nav-item-link {
            color: #94a3b8;
            padding: 12px 18px;
            font-weight: 500;
            font-size: 0.95rem;
            text-decoration: none;
            border-radius: 12px;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
        }

        .nav-item-link i {
            width: 24px;
            font-size: 1.1rem;
            margin-right: 12px;
            transition: transform 0.25s ease;
        }

        .nav-item-link:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.05);
        }

        .nav-item-link:hover i {
            transform: translateX(3px);
            color: var(--color-primary);
        }

        .nav-item-link.active {
            background: linear-gradient(90deg, rgba(14,165,233,0.15) 0%, rgba(14,165,233,0) 100%);
            color: #fff;
            border-left: 3px solid var(--color-primary);
            border-radius: 0 12px 12px 0;
        }

        .nav-item-link.active i {
            color: var(--color-primary);
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 24px 16px;
        }

        .btn-website {
            background: rgba(255,255,255,0.05);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            padding: 10px 15px;
            font-weight: 500;
            transition: all 0.2s;
        }

        .btn-website:hover {
            background: #fff;
            color: var(--bg-sidebar);
        }

        /* ─── MAIN CONTENT ─── */
        .main-wrapper {
            flex: 1;
            min-width: 0;
            margin-left: var(--sidebar-width);
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: #fff;
            padding: 14px 32px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 999;
            box-shadow: 0 1px 2px rgba(0,0,0,0.03);
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-info {
            text-align: right;
            max-width: 220px;
        }

        .user-name {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            color: #1e293b;
            font-size: 0.95rem;
            margin: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .user-role {
            color: #64748b;
            font-size: 0.75rem;
            margin: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .topbar-icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            text-decoration: none;
            transition: all .2s ease;
        }

        .topbar-icon-btn:hover,
        .topbar-icon-btn.active {
            color: #fff;
            background: var(--color-primary);
            border-color: var(--color-primary);
            box-shadow: 0 8px 18px rgba(14, 165, 233, .22);
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #eff6ff;
            color: var(--color-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            font-weight: bold;
        }

        .btn-logout {
            background: #fee2e2;
            color: var(--color-danger);
            border: none;
            border-radius: 8px;
            padding: 8px 16px;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.2s;
        }

        .btn-logout:hover {
            background: var(--color-danger);
            color: #fff;
        }

        /* ─── PAGE CONTENT ─── */
        .page-content {
            padding: 32px;
            flex: 1;
            min-width: 0;
        }

        .page-header {
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1050;
        }

        .custom-alert {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #fff;
            padding: 16px 20px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            border-left: 4px solid;
            animation: slideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            margin-bottom: 12px;
            font-weight: 500;
            font-size: 0.95rem;
        }

        .custom-alert.success {
            border-color: var(--color-success);
            color: #064e3b;
        }
        .custom-alert.success i { color: var(--color-success); font-size: 1.2rem; }

        .custom-alert.error {
            border-color: var(--color-danger);
            color: #7f1d1d;
        }
        .custom-alert.error i { color: var(--color-danger); font-size: 1.2rem; }

        @@keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        /* Card styles for general use in views */
        .admin-card {
            background: #fff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
            padding: 24px;
        }

        /* Modern Table Styles */
        .modern-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .modern-table th {
            background: #f8fafc;
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            padding: 16px 20px;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }
        .modern-table td {
            padding: 16px 20px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
            color: #334155;
            font-size: 0.9rem;
            white-space: nowrap;
        }
        .modern-table tbody tr {
            transition: background 0.2s;
        }
        .modern-table tbody tr:hover {
            background: #f8fafc;
        }
        .modern-badge {
            padding: 6px 12px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
            white-space: nowrap;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    }

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-notes-medical"></i>
            <div>
                <h2 class="brand-text">SmartHealth</h2>
                <div class="admin-badge">Admin Portal</div>
            </div>
        </div>
        <div class="d-flex flex-column gap-1 mt-4">
            @if (User.IsInRole("2"))
            {
                <a asp-controller="AdminDashboard" asp-action="Index" class="nav-item-link @(controller == "AdminDashboard" && action == "Index" ? "active" : "")">
                    <i class="fas fa-th-large"></i> Tổng quan
                </a>
                <a asp-controller="AdminDashboard" asp-action="PatientStatistics" class="nav-item-link @(controller == "AdminDashboard" && action == "PatientStatistics" ? "active" : "")">
                    <i class="fas fa-chart-area"></i> Thống kê Lâm sàng
                </a>
                <a asp-controller="AdminDashboard" asp-action="HabitStatistics" class="nav-item-link @(controller == "AdminDashboard" && action == "HabitStatistics" ? "active" : "")">
                    <i class="fas fa-heartbeat"></i> Thống kê Thói quen
                </a>
                <a asp-controller="AdminNews" asp-action="Index" class="nav-item-link @(controller == "AdminNews" ? "active" : "")">
                    <i class="fas fa-newspaper"></i> Quản lý Tin tức
                </a>
                <a asp-controller="AdminDoctor" asp-action="Index" class="nav-item-link @(controller == "AdminDoctor" ? "active" : "")">
                    <i class="fas fa-user-md"></i> Quản lý Bác sĩ
                </a>
                <a asp-controller="AdminPatient" asp-action="Index" class="nav-item-link @(controller == "AdminPatient" ? "active" : "")">
                    <i class="fas fa-users"></i> Quản lý Bệnh nhân
                </a>
                <a asp-controller="StandardThreshold" asp-action="Index" class="nav-item-link @(controller == "StandardThreshold" ? "active" : "")">
                    <i class="fas fa-sliders-h"></i> Ngưỡng Chuẩn Y Tế
                </a>
                <a asp-controller="AdminAuditLog" asp-action="Index" class="nav-item-link @(controller == "AdminAuditLog" ? "active" : "")">
                    <i class="fas fa-clipboard-check"></i> Nhật ký hoạt động
                </a>
                <a asp-controller="AdminEmailTemplate" asp-action="Index" class="nav-item-link @(controller == "AdminEmailTemplate" ? "active" : "")">
                    <i class="fas fa-envelope-open-text"></i> Mẫu Email
                </a>
                <a asp-controller="AdminPatientInterface" asp-action="Index" class="nav-item-link @(controller == "AdminPatientInterface" ? "active" : "")">
                    <i class="fas fa-palette"></i> Giao diện bệnh nhân
                </a>
            }
            @if (User.IsInRole("3"))
            {
                <a asp-controller="Receptionist" asp-action="Index" class="nav-item-link @(controller == "Receptionist" && action == "Index" ? "active" : "")">
                    <i class="fas fa-cash-register"></i> Thanh toán & Thu ngân
                </a>
                <a asp-controller="Receptionist" asp-action="Patients" class="nav-item-link @(controller == "Receptionist" && action == "Patients" ? "active" : "")">
                    <i class="fas fa-user-injured"></i> Danh sách bệnh nhân
                </a>
                <a asp-controller="ReceptionistNews" asp-action="Index" class="nav-item-link @(controller == "ReceptionistNews" ? "active" : "")">
                    <i class="fas fa-newspaper"></i> Quản lý Tin tức
                </a>
            }


         
        </div>

        <div class="sidebar-footer">
            <a href="/" class="btn btn-website w-100 d-block text-center text-decoration-none">
                <i class="fas fa-globe me-2"></i> Về Website
            </a>
        </div>
    </div>

    <!-- Main Content Wrapper -->
    <div class="main-wrapper">
        <!-- Topbar -->
        <div class="topbar">
            <div class="user-profile">
                @{
                    var adminName = User.FindFirst("FullName")?.Value ?? "Quản trị viên";
                    var adminEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity?.Name ?? "Admin";
                }
                <div class="user-info">
                    <p class="user-name">@adminName</p>
                    <p class="user-role">@adminEmail</p>
                </div>
                <div class="user-info d-none">
                    <p class="user-name">Quản trị viên</p>
                    <p class="user-role">Hệ thống cấp cao</p>
                </div>
                <div class="avatar">
                    <i class="fas fa-user-shield"></i>
                </div>
                <a asp-controller="AdminSettings"
                   asp-action="Index"
                   class="topbar-icon-btn @(controller == "AdminSettings" ? "active" : "")"
                   title="Cài đặt admin"
                   aria-label="Cài đặt admin">
                    <i class="fas fa-gear"></i>
                </a>
                <div style="border-left: 1px solid #e2e8f0; height: 30px; margin: 0 8px;"></div>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn-logout">
                        <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                    </button>
                </form>
            </div>
        </div>

        <!-- Page Content -->
        <div class="page-content">
            <!-- Toast Notifications Container -->
            <div class="toast-container" id="toastContainer">
                @if (TempData["Success"] != null)
                {
                    <div class="custom-alert success">
                        <i class="fas fa-check-circle"></i>
                        <span>@TempData["Success"]</span>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="custom-alert error">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                }
            </div>

            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Auto-hide alerts script -->
    <script>
        $(document).ready(function() {
            setTimeout(function() {
                $('.custom-alert').fadeOut('slow', function() {
                    $(this).remove();
                });
            }, 5000);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
