@model SmartHealthMonitoring.Common.PagedResult<SmartHealthMonitoring.ViewModels.Admin.AdminPatientListViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Bệnh nhân";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Quản lý Bệnh nhân</h1>
        <p class="text-muted mt-2 mb-0">Danh sách toàn bộ bệnh nhân đã đăng ký trong hệ thống</p>
    </div>
</div>

<div class="admin-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="modern-table">
            <thead>
                <tr>
                    <th style="width: 50px;"></th>
                    <th>Họ và tên</th>
                    <th>Thông tin liên hệ</th>
                    <th>Giới tính / Ngày sinh</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pat in Model.Items)
                {
                    <tr>
                        <td class="text-center">
                            <div class="avatar" style="width: 36px; height: 36px; font-size: 1rem; margin: 0 auto; background: rgba(16, 185, 129, 0.1); color: var(--color-success);">
                                @pat.FullName.Substring(0, 1).ToUpper()
                            </div>
                        </td>
                        <td>
                            <div class="fw-bold" style="color: #0f172a; font-size: 0.95rem;">@pat.FullName</div>
                            <div class="text-muted" style="font-size: 0.8rem;">ID: #@pat.UserId</div>
                        </td>
                        <td>
                            <div class="text-muted" style="font-size: 0.85rem;"><i class="fas fa-envelope text-primary opacity-75 me-2"></i>@pat.Email</div>
                            <div class="text-muted mt-1" style="font-size: 0.85rem;"><i class="fas fa-phone text-success opacity-75 me-2"></i>@(pat.Phone ?? "Chưa cập nhật")</div>
                        </td>
                        <td>
                            @if (pat.Sex == 1)
                            {
                                <div class="fw-medium text-info" style="font-size: 0.9rem;"><i class="fas fa-mars me-1"></i> Nam</div>
                            }
                            else
                            {
                                <div class="fw-medium text-danger" style="font-size: 0.9rem;"><i class="fas fa-venus me-1"></i> Nữ</div>
                            }
                            <div class="text-muted mt-1" style="font-size: 0.8rem;"><i class="fas fa-calendar-alt opacity-75 me-1"></i>@pat.DateOfBirth.ToString("dd/MM/yyyy")</div>
                        </td>
                        <td>
                            @if (pat.IsDeleted)
                            {
                                <span class="modern-badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                    <i class="fas fa-lock me-1"></i> Bị khóa
                                </span>
                                @if (!string.IsNullOrEmpty(pat.LockReason))
                                {
                                    <div class="text-danger mt-1 fw-medium" style="font-size: 0.75rem;">
                                        @pat.LockReason
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="modern-badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                    <i class="fas fa-check-circle me-1"></i> Bình thường
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            @if (pat.IsDeleted)
                            {
                                <form asp-action="ToggleLock" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@pat.UserId" />
                                    <button type="submit" class="btn btn-sm btn-success rounded-pill fw-bold px-3 shadow-sm" onclick="return confirm('Xác nhận mở khóa tài khoản bệnh nhân này?');">
                                        <i class="fas fa-unlock me-1"></i> Mở
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill fw-bold px-3" data-bs-toggle="modal" data-bs-target="#lockModal-pat-@pat.UserId">
                                    <i class="fas fa-lock me-1"></i> Khóa
                                </button>
                            }
                        </td>
                    </tr>

                    <!-- Lock Modal -->
                    <div class="modal fade" id="lockModal-pat-@pat.UserId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow-lg">
                                <form asp-action="ToggleLock" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-header border-bottom-0 p-4 pb-0">
                                        <h5 class="modal-title fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <i class="fas fa-user-lock text-danger me-2"></i>Khóa tài khoản
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-4 pt-3">
                                        <p class="text-muted mb-3">Vui lòng nhập lý do khóa tài khoản của bệnh nhân <strong>@pat.FullName</strong>.</p>
                                        <input type="hidden" name="userId" value="@pat.UserId" />
                                        <div class="mb-0">
                                            <textarea name="lockReason" class="form-control rounded-3 border-secondary" rows="3" placeholder="Ví dụ: Tài khoản giả mạo, Spam dữ liệu ảo..." required></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-top-0 p-4 pt-0">
                                        <button type="button" class="btn btn-light rounded-pill px-4 fw-medium" data-bs-dismiss="modal">Hủy</button>
                                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Xác nhận Khóa</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-4 border-top" style="background: #f8fafc;">
            <span class="text-muted fw-medium" style="font-size: 0.85rem;">Hiển thị trang @Model.Page / @Model.TotalPages</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 ms-1" asp-action="Index" asp-route-page="@(Model.Page - 1)">Trước</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 ms-1" asp-action="Index" asp-route-page="@(Model.Page + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>