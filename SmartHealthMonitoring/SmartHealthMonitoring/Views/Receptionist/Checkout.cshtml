@model SmartHealthMonitoring.Models.Payment
@{
    ViewData["Title"] = $"Thanh toán Hóa đơn #{Model.Id:D5}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var vietQrUrl     = ViewBag.VietQrUrl as string ?? "";
    var bankId        = ViewBag.BankId as string ?? "";
    var accountNo     = ViewBag.AccountNo as string ?? "";
    var accountName   = ViewBag.AccountName as string ?? "";
    var transferContent = ViewBag.TransferContent as string ?? "";
}

@section Styles {
<style>
    .payment-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        border: none;
        overflow: hidden;
    }

    .bill-header {
        background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);
        padding: 28px 32px;
        color: white;
    }

    .method-tab {
        cursor: pointer;
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        padding: 18px 24px;
        transition: all 0.25s ease;
        background: #fff;
    }

    .method-tab:hover {
        border-color: #0ea5e9;
        background: #f0f9ff;
    }

    .method-tab.active {
        border-color: #0ea5e9;
        background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
        box-shadow: 0 4px 15px rgba(14,165,233,0.15);
    }

    .method-tab .method-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .cash-icon  { background: #dcfce7; color: #16a34a; }
    .qr-icon    { background: #ede9fe; color: #7c3aed; }

    .qr-container {
        background: #fafafa;
        border: 2px dashed #cbd5e1;
        border-radius: 20px;
        padding: 32px;
        text-align: center;
    }

    .qr-container img {
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.12);
        max-width: 280px;
    }

    .status-check {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #e2e8f0;
        color: #94a3b8;
        transition: all 0.3s;
        flex-shrink: 0;
    }

    .status-check.checked {
        background: #dcfce7;
        color: #16a34a;
    }

    .service-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
    }

    .service-item:last-child { border-bottom: none; }

    .pulse-ring {
        width: 12px; height: 12px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 0 rgba(34,197,94,0.4);
        animation: pulse-anim 1.5s infinite;
        display: inline-block;
    }

    @@keyframes pulse-anim {
        0%   { box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
        70%  { box-shadow: 0 0 0 8px rgba(34,197,94,0); }
        100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
    }
</style>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Thanh toán Hóa đơn</h3>
        <span class="text-muted small">Phiếu #@Model.Id.ToString("D5") — Bệnh nhân: <strong>@Model.Patient.User.FullName</strong></span>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light rounded-pill px-4">
        <i class="fas fa-arrow-left me-2"></i>Quay lại
    </a>
</div>

<div class="row g-4">
    <!-- ───── Cột trái: Hóa đơn ───── -->
    <div class="col-lg-5">
        <div class="payment-card h-100">
            <div class="bill-header">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="mb-1 opacity-80 small">PHÒNG KHÁM SMART HEALTH</p>
                        <h4 class="fw-bold mb-0">Hóa đơn #@Model.Id.ToString("D5")</h4>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-white text-warning fw-bold px-3 py-2">Chờ thanh toán</span>
                    </div>
                </div>
            </div>

            <div class="p-4">
                <!-- Thông tin -->
                <div class="row mb-3 text-sm">
                    <div class="col-6">
                        <div class="text-muted small mb-1">Bệnh nhân</div>
                        <div class="fw-bold">@Model.Patient.User.FullName</div>
                    </div>
                    <div class="col-6 text-end">
                        <div class="text-muted small mb-1">Bác sĩ yêu cầu</div>
                        <div class="fw-bold">Bs. @Model.Doctor.User.FullName</div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small mb-1">Ngày lập phiếu</div>
                    <div class="fw-medium">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>

                <hr class="my-3">

                <!-- Chi tiết dịch vụ -->
                <div class="mb-3">
                    <div class="text-muted small fw-bold mb-2 text-uppercase">Dịch vụ đăng ký</div>
                    @foreach (var d in Model.PaymentDetails)
                    {
                        <div class="service-item">
                            <span><i class="fas fa-circle-check text-primary me-2 small"></i>@d.Service.Name</span>
                            <span class="fw-medium">@d.PriceAtTime.ToString("N0") đ</span>
                        </div>
                    }
                </div>

                <!-- Tổng tiền -->
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background:#fff7ed;">
                    <span class="fw-bold text-dark">TỔNG THANH TOÁN</span>
                    <span class="fw-bold fs-4 text-danger">@Model.TotalAmount.ToString("N0") đ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ───── Cột phải: Chọn phương thức ───── -->
    <div class="col-lg-7">
        <div class="payment-card p-4">
            <h5 class="fw-bold mb-1">Chọn phương thức thanh toán</h5>
            <p class="text-muted small mb-4">Chọn hình thức phù hợp với bệnh nhân</p>

            <!-- Toggle method -->
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="method-tab active" id="tab-cash" onclick="selectMethod('cash')">
                        <div class="d-flex align-items-center gap-3">
                            <div class="method-icon cash-icon"><i class="fas fa-money-bill-wave"></i></div>
                            <div>
                                <div class="fw-bold text-dark">Tiền mặt</div>
                                <div class="text-muted small">Thu trực tiếp</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="method-tab" id="tab-qr" onclick="selectMethod('qr')">
                        <div class="d-flex align-items-center gap-3">
                            <div class="method-icon qr-icon"><i class="fas fa-qrcode"></i></div>
                            <div>
                                <div class="fw-bold text-dark">Chuyển khoản QR</div>
                                <div class="text-muted small">VietQR + SePay</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Panel TIỀN MẶT ── -->
            <div id="panel-cash">
                <div class="p-4 rounded-4" style="background:#f8fafc; border: 1px solid #e2e8f0;">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="method-icon cash-icon" style="width:40px;height:40px;font-size:1.1rem;border-radius:10px;">
                            <i class="fas fa-hand-holding-usd"></i>
                        </div>
                        <div>
                            <div class="fw-bold">Thanh toán tiền mặt tại quầy</div>
                            <div class="text-muted small">Thu đủ <strong class="text-danger">@Model.TotalAmount.ToString("N0") đ</strong> từ bệnh nhân rồi xác nhận</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 p-3 rounded-3 mb-4" style="background:#dcfce7;">
                        <div class="status-check checked"><i class="fas fa-check fa-xs"></i></div>
                        <span class="small fw-medium text-success">Phương thức thanh toán tức thì, không cần chờ</span>
                    </div>

                    <button class="btn btn-success w-100 rounded-pill fw-bold py-3 fs-5 shadow"
                            id="btn-cash-confirm" onclick="confirmCash()">
                        <i class="fas fa-check-circle me-2"></i>Xác nhận Bệnh nhân đã thanh toán
                    </button>
                </div>
            </div>

            <!-- ── Panel QR ── -->
            <div id="panel-qr" style="display:none;">
                <div class="qr-container mb-3">
                    <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                        <span class="pulse-ring"></span>
                        <span class="text-muted small fw-medium" id="qr-status-text">Đang chờ bệnh nhân chuyển khoản...</span>
                    </div>

                    <img src="@vietQrUrl" alt="VietQR Payment" id="qr-img"
                         onerror="this.src='https://placehold.co/280x280?text=QR+Error'"
                         style="width:280px;height:280px;object-fit:contain;" />

                    <div class="mt-3">
                        <div class="fw-bold text-dark">@accountName</div>
                        <div class="text-muted small">@bankId — @accountNo</div>
                        <div class="mt-2 p-2 rounded-2 d-inline-block" style="background:#f1f5f9;">
                            <span class="text-muted small">Nội dung CK:</span>
                            <strong class="text-primary ms-1">@transferContent</strong>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info border-0 rounded-3 small d-flex align-items-center gap-2">
                    <i class="fas fa-info-circle text-info"></i>
                    Hệ thống sẽ tự động xác nhận khi nhận được giao dịch khớp nội dung chuyển khoản (qua SePay webhook).
                    Hoặc bạn có thể xác nhận thủ công bên dưới.
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-success rounded-pill px-4 fw-bold" onclick="confirmCash()">
                        <i class="fas fa-check me-1"></i>Xác nhận thủ công
                    </button>
                    <button class="btn btn-light rounded-pill px-4 text-muted" onclick="stopPolling()">
                        <i class="fas fa-stop me-1"></i>Dừng chờ
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const PAYMENT_ID = @Model.Id;
    let pollingInterval = null;
    let currentMethod = 'cash';

    function selectMethod(method) {
        currentMethod = method;
        document.getElementById('tab-cash').classList.toggle('active', method === 'cash');
        document.getElementById('tab-qr').classList.toggle('active', method === 'qr');
        document.getElementById('panel-cash').style.display = method === 'cash' ? 'block' : 'none';
        document.getElementById('panel-qr').style.display  = method === 'qr'   ? 'block' : 'none';

        if (method === 'qr') {
            startPolling();
        } else {
            stopPolling();
        }
    }

    function startPolling() {
        stopPolling();
        pollingInterval = setInterval(async () => {
            try {
                const res  = await fetch(`/Receptionist/CheckQrPayment?id=${PAYMENT_ID}`);
                const data = await res.json();
                if (data.paid) {
                    stopPolling();
                    document.getElementById('qr-status-text').textContent = '✅ Đã nhận được thanh toán!';
                    document.getElementById('qr-status-text').classList.add('text-success', 'fw-bold');
                    document.querySelector('.pulse-ring').style.background = '#22c55e';
                    Swal.fire({
                        icon: 'success',
                        title: 'Thanh toán thành công!',
                        text: 'Hệ thống đã ghi nhận giao dịch chuyển khoản.',
                        confirmButtonText: 'Về danh sách'
                    }).then(() => window.location.href = '/Receptionist');
                }
            } catch (e) { /* bỏ qua lỗi mạng tạm thời */ }
        }, 3000);
    }

    function stopPolling() {
        if (pollingInterval) { clearInterval(pollingInterval); pollingInterval = null; }
    }

    function confirmCash() {
        Swal.fire({
            title: 'Xác nhận thanh toán tiền mặt?',
            html: `Bệnh nhân <strong>@Model.Patient.User.FullName</strong> đã thanh toán <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") đ</span>?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#16a34a',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="fas fa-check me-1"></i>Đã nhận tiền',
            cancelButtonText: 'Hủy'
        }).then(async (result) => {
            if (!result.isConfirmed) return;

            const btn = document.getElementById('btn-cash-confirm');
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...'; }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const res   = await fetch('/Receptionist/ConfirmCash', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: 'id=' + PAYMENT_ID
                });
                const data = await res.json();

                if (data.success) {
                    await Swal.fire({ icon: 'success', title: 'Thành công!', text: data.message, timer: 1800, showConfirmButton: false });
                    window.location.href = '/Receptionist';
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Xác nhận Bệnh nhân đã thanh toán'; }
                }
            } catch (e) {
                Swal.fire('Lỗi', 'Đã xảy ra lỗi kết nối.', 'error');
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Xác nhận Bệnh nhân đã thanh toán'; }
            }
        });
    }

    // Dừng polling khi rời trang
    window.addEventListener('beforeunload', stopPolling);
</script>
@Html.AntiForgeryToken()
}
