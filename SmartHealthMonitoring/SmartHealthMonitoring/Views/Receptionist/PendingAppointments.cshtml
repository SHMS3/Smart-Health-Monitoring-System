@model List<SmartHealthMonitoring.Models.Appointment>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Duyệt lịch hẹn khám - SmartHealth";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-slate-800" style="font-weight: 700; color: #1e293b;">
            <i class="fas fa-calendar-check text-primary me-2"></i>Phê duyệt lịch hẹn khám
        </h1>
        <span class="badge bg-primary px-3 py-2 fs-6">Có @Model.Count yêu cầu cần xử lý</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius: 10px;">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius: 10px;">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="card-title mb-0 fw-bold text-slate-700">Danh sách yêu cầu chờ duyệt</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-slate-500 font-semibold" style="font-size: 0.85rem;">
                    <tr>
                        <th class="ps-4">MÃ LỊCH HẸN</th>
                        <th>BỆNH NHÂN / LIÊN HỆ</th>
                        <th>BÁC SĨ / CHUYÊN KHOA</th>
                        <th>THỜI GIAN HẸN</th>
                        <th>LOẠI YÊU CẦU</th>
                        <th>CHI TIẾT / LÝ DO</th>
                        <th class="text-end pe-4" style="width: 260px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fas fa-calendar-times fa-3x mb-3 d-block opacity-25"></i>
                                <span class="fw-semibold">Tuyệt vời! Không có yêu cầu đặt hoặc hủy lịch nào đang chờ duyệt.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-slate-700">#APT-@appt.Id</td>
                                <td>
                                    <div class="fw-semibold text-slate-800">@appt.Patient.User.FullName</div>
                                    <div class="text-muted small">
                                        <i class="fas fa-phone-alt me-1"></i>@appt.Patient.Phone
                                    </div>
                                    <div class="text-muted small">
                                        <i class="fas fa-envelope me-1"></i>@appt.Patient.User.Email
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-slate-800">BS. @appt.Doctor.User.FullName</div>
                                    <div class="text-muted small">Chuyên khoa: @appt.Doctor.Specialty</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">@appt.Slot.SlotStart.ToString("HH:mm") - @appt.Slot.SlotEnd.ToString("HH:mm")</div>
                                    <div class="text-muted small">Ngày @appt.Slot.SlotStart.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    @if (appt.Status == SmartHealthMonitoring.Models.AppointmentStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2" style="border-radius: 20px; font-weight: 600;">
                                            <i class="fas fa-plus-circle me-1"></i>Chờ duyệt đặt lịch
                                        </span>
                                    }
                                    else if (appt.Status == SmartHealthMonitoring.Models.AppointmentStatus.CancellationPending)
                                    {
                                        <span class="badge bg-danger px-3 py-2" style="border-radius: 20px; font-weight: 600; background-color: #fee2e2 !important; color: #ef4444 !important;">
                                            <i class="fas fa-minus-circle me-1"></i>Yêu cầu hủy lịch
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small" style="max-width: 250px; white-space: normal; word-break: break-all;">
                                    @appt.PatientNote
                                </td>
                                <td class="text-end pe-4">
                                    @if (appt.Status == SmartHealthMonitoring.Models.AppointmentStatus.Pending)
                                    {
                                        <div class="d-flex justify-content-end gap-2">
                                            <form asp-action="ApproveBooking" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="appointmentId" value="@appt.Id" />
                                                <button type="submit" class="btn btn-success btn-sm px-3 py-2 d-flex align-items-center gap-1" style="border-radius: 8px; font-weight: 600;">
                                                    <i class="fas fa-check"></i> Duyệt đặt
                                                </button>
                                            </form>
                                            <form asp-action="RejectBooking" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="appointmentId" value="@appt.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm px-3 py-2 d-flex align-items-center gap-1" style="border-radius: 8px; font-weight: 600;" onclick="return confirm('Bạn có chắc chắn muốn từ chối yêu cầu đặt lịch hẹn này?')">
                                                    <i class="fas fa-times"></i> Từ chối
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else if (appt.Status == SmartHealthMonitoring.Models.AppointmentStatus.CancellationPending)
                                    {
                                        <div class="d-flex justify-content-end gap-2">
                                            <form asp-action="ApproveCancellation" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="appointmentId" value="@appt.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm px-3 py-2 d-flex align-items-center gap-1" style="border-radius: 8px; font-weight: 600;">
                                                    <i class="fas fa-trash-alt"></i> Duyệt hủy
                                                </button>
                                            </form>
                                            <form asp-action="RejectCancellation" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="appointmentId" value="@appt.Id" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm px-3 py-2 d-flex align-items-center gap-1" style="border-radius: 8px; font-weight: 600;">
                                                    <i class="fas fa-times"></i> Không hủy
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
