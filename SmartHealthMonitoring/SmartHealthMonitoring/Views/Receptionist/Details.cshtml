@model SmartHealthMonitoring.Models.Payment
@{
    ViewData["Title"] = "Chi tiết Thanh toán";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Chi tiết Phiếu #@Model.Id.ToString("D5")</h3>
    <a asp-action="Index" class="btn btn-light rounded-pill px-4"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Thông tin chung</h5>
                <p><strong>Bệnh nhân:</strong> @Model.Patient.User.FullName</p>
                <p><strong>Bác sĩ yêu cầu:</strong> Bs. @Model.Doctor.User.FullName</p>
                <p><strong>Ngày tạo:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                <p>
                    <strong>Trạng thái:</strong>
                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                    }
                    else if (Model.Status == "Paid")
                    {
                        <span class="badge bg-success">Đã thanh toán</span>
                    }
                </p>
                @if (Model.PaymentMethod != null)
                {
                    <p>
                        <strong>Phương thức:</strong>
                        @(Model.PaymentMethod == "Cash" ? "💵 Tiền mặt" : "📱 Chuyển khoản QR")
                    </p>
                }
                @if (Model.PaidAt.HasValue)
                {
                    <p><strong>Ngày thanh toán:</strong> @Model.PaidAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tên dịch vụ</th>
                            <th class="text-end pe-4">Đơn giá</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.PaymentDetails)
                        {
                            <tr>
                                <td class="ps-4">@detail.Service.Name</td>
                                <td class="text-end pe-4">@detail.PriceAtTime.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td class="text-end">Tổng cộng:</td>
                            <td class="text-end pe-4 text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        @if (Model.Status == "Pending")
        {
            <div class="text-end mt-4">
                <a asp-action="Checkout" asp-route-id="@Model.Id"
                   class="btn btn-lg btn-primary rounded-pill px-5 fw-bold shadow">
                    <i class="fas fa-cash-register me-2"></i> Tiến hành Thu tiền
                </a>
            </div>
        }
    </div>
</div>
