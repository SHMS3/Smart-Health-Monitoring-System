@using SmartHealthMonitoring.Models
@model Patient

@{
    ViewData["Title"] = "Chi tiết Bệnh nhân";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title">Hồ sơ Bệnh nhân</h1>
    <a asp-action="Patients" class="btn btn-outline-secondary" style="border-radius: 8px; font-weight: 600;">
        <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
    </a>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="admin-card text-center h-100">
            <div class="avatar mx-auto mb-3" style="width: 100px; height: 100px; font-size: 3rem; background: rgba(14, 165, 233, 0.1);">
                <i class="fas fa-user text-primary"></i>
            </div>
            <h3 class="mb-1 fw-bold" style="font-family: 'Outfit', sans-serif;">@Model.User.FullName</h3>
            <p class="text-muted mb-3">Mã BN: #@Model.Id.ToString("D4")</p>
            
            <div class="d-flex justify-content-center gap-2 mb-3">
                <span class="modern-badge" style="background: rgba(16, 185, 129, 0.1); color: var(--color-success);">
                    <i class="fas fa-check-circle me-1"></i>Đang hoạt động
                </span>
                @if (Model.Sex == 1)
                {
                    <span class="modern-badge" style="background: rgba(14, 165, 233, 0.1); color: var(--color-primary);">
                        <i class="fas fa-mars me-1"></i>Nam
                    </span>
                }
                else
                {
                    <span class="modern-badge" style="background: rgba(239, 68, 68, 0.1); color: var(--color-danger);">
                        <i class="fas fa-venus me-1"></i>Nữ
                    </span>
                }
            </div>

            <hr class="text-muted">

            <div class="text-start mt-4">
                <p class="mb-2"><i class="fas fa-envelope text-primary me-2" style="width: 20px;"></i> <strong>Email:</strong><br><span class="text-muted ms-4">@Model.User.Email</span></p>
                <p class="mb-2"><i class="fas fa-phone text-primary me-2" style="width: 20px;"></i> <strong>Điện thoại:</strong><br><span class="text-muted ms-4">@(Model.Phone ?? "Chưa có")</span></p>
            </div>
        </div>
    </div>
    
    <div class="col-md-8 mb-4">
        <div class="admin-card h-100">
            <h4 class="mb-4 text-primary" style="font-family: 'Outfit', sans-serif;"><i class="fas fa-info-circle me-2"></i>Thông tin cá nhân</h4>
            
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td class="text-muted" style="width: 30%;">Ngày sinh:</td>
                        <td class="fw-bold">@Model.DateOfBirth.ToString("dd/MM/yyyy")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">CCCD/CMND:</td>
                        <td class="fw-bold">@(Model.CitizenId ?? "Chưa có")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Địa chỉ:</td>
                        <td class="fw-bold">@(Model.Address ?? "Chưa có")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Ngày tạo hồ sơ:</td>
                        <td class="fw-bold">@Model.User.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                </tbody>
            </table>

            <hr class="text-muted mt-4 mb-4">

            <h4 class="mb-4 text-primary" style="font-family: 'Outfit', sans-serif;"><i class="fas fa-notes-medical me-2"></i>Chỉ số Sức khỏe Cơ bản</h4>
            <div class="alert alert-info border-0" style="background: rgba(14, 165, 233, 0.05); border-radius: 12px;">
                <i class="fas fa-info-circle me-2"></i>Thông tin chi tiết về sức khỏe và lịch sử khám sẽ được cập nhật bởi bác sĩ chuyên khoa. Lễ tân chỉ xem các thông tin hành chính.
            </div>
        </div>
    </div>
</div>
