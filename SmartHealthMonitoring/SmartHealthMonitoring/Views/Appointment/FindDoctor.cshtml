@model List<SmartHealthMonitoring.Controllers.DoctorSlotViewModel>
@{
    ViewData["Title"] = "Đặt lịch khám";
    var specialties  = ViewBag.Specialties as List<string> ?? new();
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    body { font-family: 'Inter', sans-serif; background: #f0f4f8; }
    .page-header {
        background: linear-gradient(135deg, #1a6b3a 0%, #27ae60 100%);
        color: white; border-radius: 20px; padding: 32px 40px; margin-bottom: 28px;
    }
    .filter-bar {
        background: white; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.06);
        padding: 20px 28px; margin-bottom: 24px; display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;
    }
    .filter-bar .form-control, .filter-bar .form-select {
        border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: .9rem;
    }
    .filter-bar .form-control:focus, .filter-bar .form-select:focus { border-color: #27ae60; box-shadow: none; }
    .doctor-card {
        background: white; border-radius: 20px; box-shadow: 0 2px 12px rgba(0,0,0,.07);
        overflow: hidden; margin-bottom: 20px; transition: box-shadow .2s;
    }
    .doctor-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,.13); }
    .doctor-header { padding: 24px 28px; border-bottom: 1px solid #f0f4f8; display: flex; align-items: center; gap: 18px; }
    .doctor-avatar {
        width: 60px; height: 60px; border-radius: 50%;
        background: linear-gradient(135deg, #1a6b3a, #27ae60);
        display: flex; align-items: center; justify-content: center;
        color: white; font-weight: 700; font-size: 1.4rem; flex-shrink: 0;
    }
    .slot-grid { padding: 20px 28px; display: flex; flex-wrap: wrap; gap: 10px; }
    .slot-btn {
        padding: 8px 18px; border-radius: 10px; font-size: .88rem; font-weight: 500;
        border: 1.5px solid; cursor: pointer; transition: all .2s; text-decoration: none;
    }
    .slot-btn.available {
        border-color: #22c55e; color: #16a34a; background: #f0fdf4;
    }
    .slot-btn.available:hover { background: #22c55e; color: white; transform: translateY(-1px); }
    .slot-btn.taken { border-color: #e2e8f0; color: #94a3b8; background: #f8fafc; cursor: not-allowed; }
    .no-slots { color: #94a3b8; font-size: .9rem; padding: 8px 0; }
    .badge-specialty {
        background: #e0f2fe; color: #0369a1; border-radius: 20px;
        padding: 4px 12px; font-size: .78rem; font-weight: 600;
    }
</style>

<div class="container pt-5 mt-3 pb-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="page-header">
        <h1 class="h3 mb-1 fw-bold">🏥 Đặt lịch khám bệnh</h1>
        <p class="mb-0 opacity-75">Chọn bác sĩ và khung giờ phù hợp với bạn.</p>
    </div>

    <!-- Filter -->
    <form method="get" class="filter-bar" onsubmit="return validateDates()">
        <div class="row g-3 w-100">
            <!-- Hàng 1 -->
            <div class="col-md-4 col-sm-6">
                <label class="form-label small text-muted mb-1">Tên bác sĩ</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-user-md text-muted"></i></span>
                    <input type="text" name="doctorName" class="form-control" value="@ViewBag.DoctorName" placeholder="Nhập tên bác sĩ...">
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <label class="form-label small text-muted mb-1">Từ ngày</label>
                <input type="date" id="fromDate" name="fromDate" class="form-control" value="@(((DateOnly)ViewBag.FromDate).ToString("yyyy-MM-dd"))" min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-4 col-sm-6">
                <label class="form-label small text-muted mb-1">Đến ngày</label>
                <input type="date" id="toDate" name="toDate" class="form-control" value="@(((DateOnly)ViewBag.ToDate).ToString("yyyy-MM-dd"))" min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")">
            </div>

            <!-- Hàng 2 -->
            <div class="col-md-3 col-sm-6">
                <label class="form-label small text-muted mb-1">Chuyên khoa</label>
                <select name="specialty" class="form-select">
                    <option value="">Tất cả chuyên khoa</option>
                    @foreach (var sp in specialties)
                    {
                        <option value="@sp" selected="@(ViewBag.Specialty == sp ? "selected" : null)">@sp</option>
                    }
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <label class="form-label small text-muted mb-1">Giới tính</label>
                <select name="gender" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="1" selected="@(ViewBag.Gender != null && (byte)ViewBag.Gender == 1 ? "selected" : null)">Nam</option>
                    <option value="0" selected="@(ViewBag.Gender != null && (byte)ViewBag.Gender == 0 ? "selected" : null)">Nữ</option>
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <label class="form-label small text-muted mb-1">Buổi khám</label>
                <select name="session" class="form-select">
                    <option value="">Cả ngày</option>
                    <option value="Morning" selected="@(ViewBag.Session == "Morning" ? "selected" : null)">Sáng (trước 12h)</option>
                    <option value="Afternoon" selected="@(ViewBag.Session == "Afternoon" ? "selected" : null)">Chiều (sau 12h)</option>
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <label class="form-label small text-muted mb-1">Số phòng</label>
                <select name="roomNumber" class="form-select">
                    <option value="">Tất cả phòng</option>
                    @if (ViewBag.RoomNumbers != null)
                    {
                        foreach (string rm in ViewBag.RoomNumbers)
                        {
                            <option value="@rm" selected="@(ViewBag.RoomNumber == rm ? "selected" : null)">@rm</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 col-sm-12 d-flex align-items-end">
                <button type="submit" class="btn fw-semibold rounded-3 w-100" style="background:#27ae60;color:white;padding:10px 24px">
                    <i class="fas fa-search me-2"></i>Tìm kiếm
                </button>
            </div>
        </div>
    </form>

    <!-- Doctor list + slots -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-user-md fa-3x mb-3 d-block opacity-25"></i>
            <p>Không tìm thấy bác sĩ phù hợp.</p>
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="doctor-card">
            <div class="doctor-header">
                <div class="doctor-avatar">@item.Doctor.User.FullName.Substring(0, 1).ToUpper()</div>
                <div>
                    <div class="fw-bold fs-6">BS. @item.Doctor.User.FullName</div>
                    <span class="badge-specialty">@item.Doctor.Specialty</span>
                    @if (!string.IsNullOrEmpty(item.Doctor.RoomNumber))
                    {
                        <span class="badge-specialty" style="background:#fef3c7;color:#92400e;margin-left:4px">
                            <i class="fas fa-door-open me-1"></i>@item.Doctor.RoomNumber
                        </span>
                    }
                </div>
                <div class="ms-auto text-muted small">
                    <i class="fas fa-calendar-week me-1"></i>@item.TotalAvailableSlots slot trống trong 7 ngày
                </div>
            </div>
             <div class="slot-grid flex-column">
                @if (item.TotalAvailableSlots > 0)
                {
                    foreach (var dateGroup in item.WeeklySlots.OrderBy(k => k.Key))
                    {
                        if (dateGroup.Value.Any())
                        {
                            <div class="w-100 mt-2 mb-2">
                                <div class="fw-bold text-success mb-2" style="font-size: 0.9rem;">
                                    <i class="fas fa-calendar-day me-1"></i>@dateGroup.Key.ToString("dd/MM/yyyy")
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach(var slot in dateGroup.Value)
                                    {
                                        <a href="/Appointment/VerifyOtp?slotId=@slot.Id" class="slot-btn available" id="slot-btn-@slot.Id">
                                            @slot.SlotStart.ToString("HH:mm") - @slot.SlotEnd.ToString("HH:mm")
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="no-slots">Không có ca khám trống nào trong khoảng thời gian tìm kiếm.</div>
                }

                <!-- SCH-07: Form đăng ký theo dõi waitlist -->
                <div class="border-top pt-3 mt-3 w-100">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="small text-muted fw-semibold"><i class="fas fa-bell me-1" style="color:#6366f1"></i>Đăng ký theo dõi slot trống:</span>
                        <input type="date" class="form-control form-control-sm d-inline-block w-auto" 
                               id="wl-date-@item.Doctor.Id" 
                               min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" 
                               value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                        <button class="btn btn-sm text-white btn-join-wl" 
                                style="background:#6366f1; border-radius:8px; font-weight:600;"
                                onclick="joinWaitlist(@item.Doctor.Id)">
                            <i class="fas fa-paper-plane me-1"></i>Đăng ký nhận Email
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Toast Container cho thông báo -->
<div id="toastContainer" style="position:fixed; top:24px; right:24px; z-index:1100; display:flex; flex-direction:column; gap:10px;"></div>

@section Scripts {
    <script>
        function validateDates() {
            var from = document.getElementById("fromDate").value;
            var to = document.getElementById("toDate").value;
            if (from && to && from > to) {
                alert("Ngày bắt đầu không được lớn hơn ngày kết thúc!");
                return false;
            }
            return true;
        }

        // SCH-07: Đăng ký waitlist AJAX
        function joinWaitlist(doctorId) {
            const dateInput = document.getElementById(`wl-date-${doctorId}`);
            if (!dateInput || !dateInput.value) {
                showToast('error', 'Vui lòng chọn ngày cần theo dõi.');
                return;
            }
            
            fetch('/Appointment/JoinWaitlist', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    doctorId: doctorId,
                    watchDate: dateInput.value
                })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast('success', data.message);
                } else {
                    showToast('error', data.message || 'Không thể đăng ký.');
                }
            })
            .catch(() => {
                showToast('error', 'Có lỗi xảy ra, vui lòng thử lại.');
            });
        }

        function showToast(type, message) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.style.background = 'white';
            toast.style.borderRadius = '14px';
            toast.style.padding = '16px 22px';
            toast.style.boxShadow = '0 8px 30px rgba(0,0,0,.12)';
            toast.style.display = 'flex';
            toast.style.alignItems = 'center';
            toast.style.gap = '12px';
            toast.style.minWidth = '300px';
            toast.style.animation = 'slideInRight .4s ease';
            toast.style.borderLeft = type === 'success' ? '4px solid #22c55e' : '4px solid #ef4444';
            
            // Keyframe animation definition inline if not defined
            if (!document.getElementById('slideInRightKeyframe')) {
                const style = document.createElement('style');
                style.id = 'slideInRightKeyframe';
                style.innerHTML = `
                    @@keyframes slideInRight {
                        from { transform: translateX(100%); opacity: 0; }
                        to { transform: translateX(0); opacity: 1; }
                    }
                `;
                document.head.appendChild(style);
            }

            toast.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}" 
                   style="color:${type === 'success' ? '#22c55e' : '#ef4444'}; font-size:1.2rem"></i>
                <span style="font-size:.88rem; font-weight:500">${message}</span>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity .3s';
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Khởi tạo kết nối SignalR tới appointmentHub
            const appointmentConnection = new signalR.HubConnectionBuilder()
                .withUrl("/appointmentHub")
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            appointmentConnection.on("SlotStatusChanged", function (slotId, status) {
                console.log(`[SignalR] Nhận thay đổi trạng thái slot ${slotId}: ${status}`);
                const slotBtn = document.getElementById(`slot-btn-${slotId}`);
                if (slotBtn) {
                    if (status === "Available") {
                        // Trả lại trạng thái khả dụng và hiện lại slot
                        slotBtn.style.display = "inline-block";
                        slotBtn.classList.remove("taken");
                        slotBtn.classList.add("available");
                    } else {
                        // Ẩn slot đi khỏi giao diện khi đã bị giữ hoặc đã đặt
                        slotBtn.style.display = "none";
                    }
                }
            });

            // Lắng nghe thêm sự kiện SlotBooked
            appointmentConnection.on("SlotBooked", function (slotId) {
                console.log(`[SignalR] Slot ${slotId} đã được đặt.`);
                const slotBtn = document.getElementById(`slot-btn-${slotId}`);
                if (slotBtn) {
                    slotBtn.style.display = "none";
                }
            });

            appointmentConnection.start()
                .then(() => console.log("[SignalR] Kết nối thành công tới AppointmentHub."))
                .catch(err => console.error("[SignalR] Lỗi kết nối:", err));
        });
    </script>
}
