@model List<SmartHealthMonitoring.Models.Appointment>
@{
    ViewData["Title"] = "Hàng đợi bệnh nhân";
    var selectedDate = (DateOnly)ViewBag.SelectedDate;
    var today        = DateOnly.FromDateTime(DateTime.UtcNow);
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    body { font-family: 'Inter', sans-serif; background: #f0f4f8; }
    .page-header { background: linear-gradient(135deg, #1e3a5f, #2d6a9f); color: white; border-radius: 20px; padding: 32px 40px; margin-bottom: 28px; }
    .date-nav { display: flex; gap: 10px; align-items: center; margin-bottom: 24px; }
    .date-btn {
        padding: 8px 18px; border-radius: 10px; border: 1.5px solid #e2e8f0;
        background: white; color: #475569; font-size: .88rem; text-decoration: none; transition: all .2s;
    }
    .date-btn:hover, .date-btn.active { background: #2d6a9f; color: white; border-color: #2d6a9f; }
    .queue-table { background: white; border-radius: 20px; box-shadow: 0 2px 12px rgba(0,0,0,.07); overflow: hidden; }
    .queue-table table { width: 100%; border-collapse: collapse; }
    .queue-table th {
        background: #f8fafc; padding: 14px 20px; font-size: .82rem;
        font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .4px;
        border-bottom: 1px solid #f0f4f8;
    }
    .queue-table td { padding: 18px 20px; border-bottom: 1px solid #f8fafc; vertical-align: middle; }
    .queue-table tr:last-child td { border-bottom: none; }
    .queue-table tr:hover td { background: #f8fafc; }
    .order-badge {
        width: 36px; height: 36px; border-radius: 50%;
        background: linear-gradient(135deg, #1e3a5f, #2d6a9f);
        color: white; font-weight: 700; font-size: .9rem;
        display: flex; align-items: center; justify-content: center;
    }
    .patient-name { font-weight: 600; color: #1e293b; }
    .time-chip {
        background: #e0f2fe; color: #0369a1; border-radius: 8px;
        padding: 4px 12px; font-size: .85rem; font-weight: 600; display: inline-block;
    }
    .note-text { font-size: .85rem; color: #64748b; max-width: 220px; }
    .btn-examine {
        background: linear-gradient(135deg, #1a6b3a, #27ae60); color: white;
        border: none; border-radius: 8px; padding: 7px 18px; font-size: .85rem; font-weight: 600;
        text-decoration: none; cursor: pointer; transition: opacity .2s; display: inline-block;
    }
    .btn-examine:hover { opacity: .9; color: white; }
    .empty-queue { text-align: center; padding: 60px; color: #94a3b8; }
    .stat-chip { background: #f0f4f8; border-radius: 10px; padding: 10px 18px; font-size: .85rem; }
    .stat-chip span { font-weight: 700; font-size: 1.2rem; color: #1e3a5f; display: block; }
</style>

<div class="container pt-5 mt-3 pb-5">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-1 fw-bold">🏥 Hàng đợi bệnh nhân</h1>
                <p class="mb-0 opacity-75">Ngày @selectedDate.ToString("dd/MM/yyyy") — @Model.Count bệnh nhân</p>
            </div>
            <div class="d-flex gap-3">
                <div class="stat-chip text-center">
                    <span>@Model.Count</span>
                    Tổng BN
                </div>
                <div class="stat-chip text-center" style="background:#dcfce7">
                    <span style="color:#16a34a">@Model.Count(a => a.Status == SmartHealthMonitoring.Models.AppointmentStatus.Completed)</span>
                    Đã khám
                </div>
            </div>
        </div>
    </div>

    <!-- Date Navigation -->
    <div class="date-nav">
        <a asp-action="DoctorQueue" asp-route-date="@selectedDate.AddDays(-1).ToString("yyyy-MM-dd")" class="date-btn">
            ← Hôm qua
        </a>
        <a asp-action="DoctorQueue" asp-route-date="@today.ToString("yyyy-MM-dd")"
           class="date-btn @(selectedDate == today ? "active" : "")">
            Hôm nay
        </a>
        <a asp-action="DoctorQueue" asp-route-date="@selectedDate.AddDays(1).ToString("yyyy-MM-dd")" class="date-btn">
            Ngày mai →
        </a>
        <input type="date" class="form-control rounded-3 ms-auto"
               value="@selectedDate.ToString("yyyy-MM-dd")"
               style="max-width:180px;border:1.5px solid #e2e8f0"
               onchange="window.location='/Appointment/DoctorQueue?date='+this.value">
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 border-0 shadow-sm mb-4">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="queue-table">
        @if (!Model.Any())
        {
            <div class="empty-queue">
                <i class="fas fa-calendar-times fa-3x d-block mb-3 opacity-25"></i>
                <p>Không có bệnh nhân nào trong ngày này.</p>
                <a asp-action="Index" asp-controller="DoctorSchedule" class="btn btn-outline-secondary rounded-3 mt-2">
                    Cấu hình lịch làm việc
                </a>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Giờ hẹn</th>
                        <th>Bệnh nhân</th>
                        <th>Triệu chứng</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 0; }
                    @foreach (var a in Model.OrderBy(x => x.Slot.SlotStart))
                    {
                        i++;
                        <tr>
                            <td><div class="order-badge">@i</div></td>
                            <td>
                                <span class="time-chip">
                                    @a.Slot.SlotStart.ToString("HH:mm")
                                </span>
                            </td>
                            <td>
                                <div class="patient-name">@a.Patient.User.FullName</div>
                                <div class="text-muted small">ID: #@a.PatientId</div>
                            </td>
                            <td>
                                <div class="note-text">
                                    @(string.IsNullOrEmpty(a.PatientNote) ? "—" : a.PatientNote)
                                </div>
                            </td>
                            <td>
                                @if (a.Status == SmartHealthMonitoring.Models.AppointmentStatus.Confirmed)
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3">Chờ khám</span>
                                }
                                else if (a.Status == SmartHealthMonitoring.Models.AppointmentStatus.Completed)
                                {
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3">Đã khám</span>
                                }
                            </td>
                            <td>
                                @if (a.Status == SmartHealthMonitoring.Models.AppointmentStatus.Confirmed)
                                {
                                    <a asp-controller="ClinicalExam"
                                       asp-action="Create"
                                       asp-route-patientId="@a.PatientId"
                                       class="btn-examine">
                                        <i class="fas fa-stethoscope me-1"></i>Bắt đầu khám
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Hoàn tất</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
