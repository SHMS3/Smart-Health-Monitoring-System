@model dynamic
@{
    ViewData["Title"] = "Xác thực mã OTP - SmartHealth";
    var slotId = (int)ViewBag.SlotId;
    var doctorName = (string)ViewBag.DoctorName;
    var specialty = (string)ViewBag.Specialty;
    var slotStart = (DateTime)ViewBag.SlotStart;
    var slotEnd = (DateTime)ViewBag.SlotEnd;
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #1e293b; }
    .otp-container { max-width: 500px; margin: 60px auto; padding: 40px; background: white; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05); }
    .header-logo { text-align: center; margin-bottom: 24px; color: #27ae60; font-size: 2rem; font-weight: 700; }
    .otp-title { font-size: 1.5rem; font-weight: 700; text-align: center; color: #0f172a; margin-bottom: 8px; }
    .otp-subtitle { text-align: center; color: #64748b; font-size: 0.9rem; margin-bottom: 30px; line-height: 1.5; }
    .booking-summary { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 16px; margin-bottom: 24px; font-size: 0.88rem; }
    .booking-summary p { margin: 6px 0; }
    .otp-input { letter-spacing: 12px; font-size: 24px; text-align: center; font-weight: 700; border: 2px solid #e2e8f0; border-radius: 10px; padding: 12px; transition: border-color 0.2s; }
    .otp-input:focus { border-color: #27ae60; outline: none; box-shadow: 0 0 0 3px rgba(39, 174, 96, 0.1); }
    .btn-verify { background-color: #27ae60; color: white; border: none; font-weight: 600; padding: 12px; border-radius: 10px; width: 100%; transition: background-color 0.2s; margin-top: 16px; }
    .btn-verify:hover { background-color: #219653; }
    .btn-back { display: block; text-align: center; color: #64748b; font-size: 0.88rem; text-decoration: none; margin-top: 20px; font-weight: 500; }
    .btn-back:hover { color: #0f172a; text-decoration: underline; }
</style>

<div class="container">
    <div class="otp-container">
        <div class="header-logo">
            <i class="fas fa-stethoscope me-2"></i>SmartHealth
        </div>
        <h2 class="otp-title">Xác thực mã OTP</h2>
        <p class="otp-subtitle">
            Chúng tôi đã gửi mã xác thực OTP 6 chữ số vào địa chỉ email tài khoản của quý khách. Vui lòng nhập mã bên dưới để tiếp tục đặt lịch khám.
        </p>

        <div class="booking-summary">
            <p><strong><i class="fas fa-user-md me-2" style="color: #27ae60;"></i>Bác sĩ:</strong> BS. @doctorName</p>
            <p><strong><i class="fas fa-tags me-2" style="color: #27ae60;"></i>Chuyên khoa:</strong> @specialty</p>
            <p><strong><i class="fas fa-calendar-alt me-2" style="color: #27ae60;"></i>Thời gian:</strong> @slotStart.ToString("HH:mm") – @slotEnd.ToString("HH:mm") (ngày @slotStart.ToString("dd/MM/yyyy"))</p>
        </div>

        <form asp-action="VerifyOtp" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="slotId" value="@slotId" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

            <div class="mb-3 text-center">
                <input type="text" name="otpCode" class="form-control otp-input" required maxlength="6" autofocus autocomplete="off" placeholder="------" />
            </div>

            <button type="submit" class="btn-verify">
                <i class="fas fa-shield-alt me-2"></i>Xác minh OTP
            </button>
        </form>

        <a asp-action="FindDoctor" class="btn-back">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách bác sĩ
        </a>
    </div>
</div>
