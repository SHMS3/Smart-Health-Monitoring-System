@model IEnumerable<SmartHealthMonitoring.ViewModels.PatientListDto>
@{
    ViewData["Title"] = "Danh sách Bệnh nhân";
}

<div class="container-xl" style="margin-top: 90px; margin-bottom: 50px;">
    <h2 class="text-primary fw-bold mb-4">
        <i class="fa-solid fa-users-medical me-2"></i> Danh sách Bệnh nhân
    </h2>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-4 py-3">Họ và Tên</th>
                            <th class="py-3">Tuổi</th>
                            <th class="py-3">Giới tính</th>
                            <th class="py-3">Số điện thoại</th>
                            <th class="pe-4 py-3 text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-semibold text-dark">@item.FullName</td>
                                    <td class="py-3">@item.Age</td>
                                    <td class="py-3">@item.Gender</td>
                                    <td class="py-3">@(string.IsNullOrEmpty(item.PhoneNumber) ? "-" : item.PhoneNumber)</td>

                                    <td class="pe-4 py-3 text-end">
                                        <a asp-action="PatientHealth" asp-route-patientId="@item.PatientId" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                                            <i class="fa-solid fa-eye me-1"></i> Xem hồ sơ
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-folder-open fs-1 text-light mb-3 d-block"></i>
                                    Chưa có bệnh nhân nào trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>