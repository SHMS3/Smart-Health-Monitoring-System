@model SmartHealthMonitoring.Common.PagedResult<SmartHealthMonitoring.ViewModels.PatientListViewModel>
@{
    ViewData["Title"] = "Bảng điều khiển Bác sĩ";
}

<style>
    .doc-container {
        max-width: 1280px;
        margin: 0 auto;
    }

    .table-doctor {
        border-collapse: separate;
        border-spacing: 0 8px;
    }

        .table-doctor thead th {
            border: none;
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            padding: 16px 20px;
        }

        .table-doctor tbody tr {
            background: #ffffff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
            border-radius: 12px;
            transition: all 0.2s ease;
        }

            .table-doctor tbody tr:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(14,165,233,0.08);
            }

        .table-doctor tbody td {
            border: none;
            padding: 16px 20px;
            vertical-align: middle;
        }

            .table-doctor tbody td:first-child {
                border-top-left-radius: 12px;
                border-bottom-left-radius: 12px;
            }

            .table-doctor tbody td:last-child {
                border-top-right-radius: 12px;
                border-bottom-right-radius: 12px;
            }

        .form-section {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 24px;
            height: 100%;
        }

        .section-title {
            font-size: 1rem;
            font-weight: 700;
            color: #334155;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
        }

        .bg-red-soft {
            background: #fee2e2;
            color: #ef4444;
        }

        .bg-blue-soft {
            background: #e0f2fe;
            color: #0ea5e9;
        }

        .bg-purple-soft {
            background: #f3e8ff;
            color: #8b5cf6;
        }
</style>

<div class="container pt-5 mt-4 pb-5 doc-container">


    @* ─── Banner cảnh báo chưa xử lý ─── *@
    @if (ViewBag.UnresolvedAlertCount != null && (int)ViewBag.UnresolvedAlertCount > 0)
    {
        <div class="alert border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center gap-3"
             style="background: linear-gradient(135deg, #fee2e2, #fecaca); border-left: 4px solid #ef4444 !important;">
            <div style="width:44px;height:44px;background:#ef4444;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="fas fa-exclamation-triangle text-white fs-5"></i>
            </div>
            <div class="flex-grow-1">
                <div class="fw-bold text-danger fs-6">Cảnh báo chưa được xử lý!</div>
                <div class="text-danger small">Hệ thống đang có <strong>@ViewBag.UnresolvedAlertCount</strong> cảnh báo AI cần bác sĩ tiếp nhận và xử lý khẩn cấp.</div>
            </div>
            <a asp-controller="WarningAlert" asp-action="Dashboard" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold flex-shrink-0">
                <i class="fas fa-bell me-1"></i> Xem ngay
            </a>
        </div>
    }


    @* ─── SECTION: Danh sách Bệnh nhân ─── *@
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Danh sách Bệnh nhân</h4>
            <p class="text-muted small mb-0">Quản lý và theo dõi chỉ số sức khỏe của bệnh nhân được phân công</p>
        </div>

        @* ─── Widget Ca Trực ─── *@
        <div class="card border-0 shadow-sm rounded-4 px-4 py-3 d-flex flex-row align-items-center gap-3" style="min-width:260px;">
            <div id="shiftIconWrapper"
                 style="width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
                        background:@((bool)(ViewBag.IsOnShift ?? false) ? "#dcfce7" : "#f1f5f9");">
                <i id="shiftIcon" class="fas @((bool)(ViewBag.IsOnShift ?? false) ? "fa-user-md text-success" : "fa-moon text-secondary") fs-5"></i>
            </div>
            <div class="flex-grow-1">
                <div class="fw-bold text-dark small mb-0">Ca trực của tôi</div>
                <div id="shiftBadge" class="badge rounded-pill px-2 mt-1"
                     style="background:@((bool)(ViewBag.IsOnShift ?? false) ? "#dcfce7" : "#f1f5f9");
                            color:@((bool)(ViewBag.IsOnShift ?? false) ? "#16a34a" : "#64748b"); font-size:0.72rem;">
                    @((bool)(ViewBag.IsOnShift ?? false) ? "● Đang trực" : "○ Ngoài ca")
                </div>
            </div>
            <div class="form-check form-switch mb-0 ms-2">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="shiftToggle" style="width:2.4rem;height:1.2rem;cursor:pointer;"
                       @((bool)(ViewBag.IsOnShift ?? false) ? "checked" : "")>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-transparent">
        <div class="table-responsive">
            <table class="table table-doctor align-middle mb-0 text-nowrap">
                <thead>
                    <tr>
                        <th class="ps-4">Mã BN</th>
                        <th>Họ và tên</th>
                        <th>Tuổi</th>
                        <th>Giới tính</th>
                        <th>Số điện thoại</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 bg-white rounded-4">
                                <div class="text-muted mb-2"><i class="fas fa-users-slash fa-2x opacity-25"></i></div>
                                <h6 class="fw-bold text-secondary mb-0">Không tìm thấy bệnh nhân nào</h6>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var patient in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@patient.PatientId.ToString("D5")</td>
                                <td class="fw-bold text-dark">@patient.FullName</td>
                                <td><span class="badge bg-light text-dark border px-2 py-1 rounded-3">@patient.Age tuổi</span></td>
                                <td>
                                    @if (patient.SexDisplay == "Nam")
                                    {
                                        <span class="text-info fw-medium"><i class="fas fa-mars me-1"></i> Nam</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-medium"><i class="fas fa-venus me-1"></i> Nữ</span>
                                    }
                                </td>
                                <td class="text-muted"><i class="fas fa-phone-alt me-2 small"></i>@patient.Phone</td>
                                <td class="text-end pe-4">
                                    <a asp-controller="DoctorDashboard" asp-action="PatientProfile" asp-route-patientId="@patient.PatientId" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm">
                                        <i class="fas fa-folder-open me-1"></i> Xem hồ sơ
                                    </a>
                                    <a asp-controller="ClinicalRecord" asp-action="Index_ListPatient" asp-route-id="@patient.PatientId" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm">
                                        <i class="fas fa-history me-1"></i> Xem bệnh án
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mt-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                <span class="text-muted small">
                    Hiển thị trang <strong>@Model.Page</strong> / @Model.TotalPages (Tổng số: <strong>@Model.TotalCount</strong> bệnh nhân)
                </span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                            <a class="page-link rounded-start-pill px-3" asp-action="Index" asp-route-page="@(Model.Page - 1)">Trước</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link px-3" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-end-pill px-3" asp-action="Index" asp-route-page="@(Model.Page + 1)">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>


@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggle      = document.getElementById('shiftToggle');
        const badge       = document.getElementById('shiftBadge');
        const iconEl      = document.getElementById('shiftIcon');
        const iconWrapper = document.getElementById('shiftIconWrapper');
        if (!toggle) return;

        toggle.addEventListener('change', async function () {
            toggle.disabled = true;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            try {
                const resp = await fetch('/DoctorDashboard/ToggleShift', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                });
                const data = await resp.json();

                if (data.success) {
                    if (data.isOnShift) {
                        badge.textContent       = '● Đang trực';
                        badge.style.background  = '#dcfce7';
                        badge.style.color       = '#16a34a';
                        iconWrapper.style.background = '#dcfce7';
                        iconEl.className        = 'fas fa-user-md text-success fs-5';
                    } else {
                        badge.textContent       = '○ Ngoài ca';
                        badge.style.background  = '#f1f5f9';
                        badge.style.color       = '#64748b';
                        iconWrapper.style.background = '#f1f5f9';
                        iconEl.className        = 'fas fa-moon text-secondary fs-5';
                    }
                } else {
                    // Nếu lỗi thì revert toggle
                    toggle.checked = !toggle.checked;
                    alert(data.message);
                }
            } catch {
                toggle.checked = !toggle.checked;
                alert('Lỗi kết nối. Vui lòng thử lại.');
            } finally {
                toggle.disabled = false;
            }
        });
    });
</script>
}
