@model SmartHealthMonitoring.ViewModels.PatientDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Bệnh Nhân";
}

<div class="container-xl" style="margin-top: 90px; margin-bottom: 50px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">
            <i class="fa-solid fa-clipboard-user me-2"></i> Hồ sơ Sức khỏe Bệnh nhân
        </h2>
        <a asp-controller="DoctorDashboard" asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow-sm border-0 text-white rounded-3" style="background: var(--grad) !important;">
                <div class="card-body p-4 d-flex align-items-center gap-4">
                    <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 85px; height: 85px;">
                        <i class="fa-solid fa-user fs-1"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1">@Model.FullName</h3>
                        <div class="d-flex flex-wrap gap-4 mt-2" style="font-size: 0.95rem;">
                            <span><i class="fa-solid fa-cake-candles opacity-75 me-1"></i> @Model.Age tuổi</span>
                            <span><i class="fa-solid fa-venus-mars opacity-75 me-1"></i> @Model.Gender</span>
                            <span>
                                <i class="fa-solid fa-droplet opacity-75 me-1 text-danger"></i> Nhóm máu:
                                <span class="fw-semibold">@(string.IsNullOrEmpty(Model.BloodType) ? "Chưa cập nhật" : Model.BloodType)</span>
                            </span>
                            <span>
                                <i class="fa-solid fa-phone opacity-75 me-1"></i>
                                @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fa-solid fa-heart-pulse text-success me-2"></i> Chi tiết các chỉ số sinh tồn đã ghi nhận
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted">
                                <tr>
                                    <th class="ps-4 py-3" style="width: 20%">Thời gian</th>
                                    <th class="py-3" style="width: 20%">Loại chỉ số</th>
                                    <th class="py-3" style="width: 15%">Giá trị đo</th>
                                    <th class="py-3" style="width: 15%">Cảnh báo</th>
                                    <th class="py-3" style="width: 30%">Ghi chú của bệnh nhân</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.MetricsHistory.Any())
                                {
                                    foreach (var item in Model.MetricsHistory)
                                    {
                                        <tr>
                                            <td class="ps-4 py-3 text-muted">@item.MeasuredAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="py-3 fw-semibold text-dark">@item.MetricName</td>
                                            <td class="py-3">
                                                <span class="badge bg-info text-dark fs-6 px-3 py-2 fw-bold rounded-pill shadow-sm">
                                                    @item.Value @item.Unit
                                                </span>
                                            </td>
                                            <td class="py-3">
                                                @* Logic giả lập cảnh báo *@
                                                @if (item.MetricName.ToLower().Contains("huyết áp") && item.Value >= 140)
                                                {
                                                    <span class="badge bg-danger px-2 py-1 shadow-sm"><i class="fa-solid fa-triangle-exclamation"></i> Cao</span>
                                                }
                                                else if (item.MetricName.ToLower().Contains("nhịp tim") && (item.Value > 100 || item.Value < 60))
                                                {
                                                    <span class="badge bg-warning text-dark px-2 py-1 shadow-sm"><i class="fa-solid fa-bell"></i> Bất thường</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success px-2 py-1 shadow-sm"><i class="fa-solid fa-check"></i> Ổn định</span>
                                                }
                                            </td>
                                            <td class="py-3 text-secondary">@(string.IsNullOrEmpty(item.Notes) ? "Không có" : item.Notes)</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="fa-solid fa-folder-open fs-1 text-light mb-3 d-block"></i>
                                            Bệnh nhân này chưa có dữ liệu sức khỏe nào.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>