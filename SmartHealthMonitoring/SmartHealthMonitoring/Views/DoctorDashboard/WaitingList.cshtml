@using SmartHealthMonitoring.Models
@model SmartHealthMonitoring.Common.PagedResult<SmartHealthMonitoring.Models.WaitingPatient>

@{
    ViewData["Title"] = "Danh sách chờ khám";
    Layout = "_Layout";
}

<style>
    .doc-container { max-width: 1280px; margin: 0 auto; }
    .table-doctor { border-collapse: separate; border-spacing: 0 8px; }
    .table-doctor thead th { border: none; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; padding: 16px 20px; }
    .table-doctor tbody tr { background: #ffffff; box-shadow: 0 2px 6px rgba(0,0,0,0.02); border-radius: 12px; transition: all 0.2s ease; }
    .table-doctor tbody tr:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(14,165,233,0.08); }
    .table-doctor tbody td { border: none; padding: 16px 20px; vertical-align: middle; }
    .table-doctor tbody td:first-child { border-top-left-radius: 12px; border-bottom-left-radius: 12px; }
    .table-doctor tbody td:last-child { border-top-right-radius: 12px; border-bottom-right-radius: 12px; }
</style>

<div class="container pt-5 mt-4 pb-5 doc-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title" style="font-weight: 700; color: #1e293b;">Danh sách chờ khám</h1>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-transparent">
        <div class="table-responsive">
        <table class="table table-doctor align-middle mb-0 text-nowrap">
            <thead>
                <tr>
                    <th class="ps-4">STT</th>
                    <th>Thời gian ĐK</th>
                    <th>Họ và tên</th>
                    <th>Số điện thoại</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var wp in Model.Items)
                    {
                        <tr id="waiting-row-@wp.Id">
                            <td class="ps-4"><span class="badge bg-primary fs-6">@wp.SequenceNumber</span></td>
                            <td class="text-muted"><i class="fas fa-clock me-1 small"></i> @wp.CreatedAt.AddHours(7).ToString("HH:mm")</td>
                            <td class="fw-bold text-dark">@wp.Patient.User.FullName</td>
                            <td class="text-muted"><i class="fas fa-phone-alt me-1 small"></i> @(wp.Patient.Phone ?? "N/A")</td>
                            <td>
                                @if (wp.Status == 0)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="fas fa-hourglass-half"></i> Đang chờ</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-2 py-1"><i class="fas fa-check"></i> Đã tiếp nhận</span>
                                }
                            </td>
                            <td id="action-cell-@wp.Id" class="text-end pe-4">
                                @if (wp.Status == 0)
                                {
                                    <button class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm btn-accept" data-id="@wp.Id" data-patient-id="@wp.PatientId" data-patient-name="@wp.Patient.User.FullName">
                                        <i class="fas fa-stethoscope me-1"></i> Tiếp nhận khám
                                    </button>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" onclick="openServiceModal(@wp.Id, @wp.PatientId, '@wp.Patient.User.FullName')">
                                            <i class="fas fa-plus-circle me-1"></i> Thêm dịch vụ
                                        </button>
                                        @{
                                            var patientsWithPayments = ViewBag.PatientsWithPayments as List<int> ?? new List<int>();
                                        }
                                        @if (patientsWithPayments.Contains(wp.PatientId))
                                        {
                                            <a asp-controller="ClinicalRecord" asp-action="Index" asp-route-id="@wp.PatientId" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm">
                                                <i class="fas fa-history me-1"></i> Vào khám
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold shadow-sm btn-cancel-exam" data-id="@wp.Id">
                                                <i class="fas fa-times me-1"></i> Hủy khám
                                            </button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted bg-white rounded-4 shadow-sm">
                            <i class="fas fa-check-circle fa-4x mb-3 text-success opacity-75"></i>
                            <h5 class="fw-bold mb-1">Tuyệt vời!</h5>
                            <p class="mb-0">Không có bệnh nhân nào đang chờ khám.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <!-- Phân trang -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm shadow-sm">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link rounded-circle mx-1" asp-action="WaitingList" asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>


<!-- Modal Thêm Dịch Vụ Khám -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-labelledby="serviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="serviceModalLabel">Thêm dịch vụ khám cho <span id="modalPatientName" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalPatientId" />
                <div class="row g-3" id="servicesListBody">
                    <!-- Dịch vụ sẽ được load qua AJAX -->
                    <div class="col-12 text-center text-muted">
                        <span class="spinner-border spinner-border-sm me-2"></span> Đang tải danh sách dịch vụ...
                    </div>
                </div>
                <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-5 text-dark">Tổng tiền:</span>
                    <span class="fw-bold fs-4 text-danger" id="totalAmountText">0 đ</span>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" id="btnSubmitServices" onclick="submitServices()">
                    <i class="fas fa-paper-plane me-1"></i> Gửi yêu cầu thanh toán
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $('.btn-accept').click(function () {
                var btn = $(this);
                var waitingId = btn.data('id');
                var patientId = btn.data('patient-id');

                var patientName = btn.data('patient-name');

                // Disable button to prevent double clicks
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');

                $.ajax({
                    url: '@Url.Action("AcceptPatient", "DoctorDashboard")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ waitingId: waitingId }),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (res) {
                        if (res.success) {
                            // Update UI
                            var actionCell = $('#action-cell-' + waitingId);
                            var statusCell = $('#waiting-row-' + waitingId).find('td:nth-child(5)');
                            
                            statusCell.html('<span class="badge bg-success px-2 py-1"><i class="fas fa-check"></i> Đã tiếp nhận</span>');
                            
                            var newButtons = `
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" onclick="openServiceModal(${waitingId}, ${patientId}, '${patientName}')">
                                        <i class="fas fa-plus-circle me-1"></i> Thêm dịch vụ
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold shadow-sm btn-cancel-exam" data-id="${waitingId}">
                                        <i class="fas fa-times me-1"></i> Hủy khám
                                    </button>
                                </div>
                            `;
                            actionCell.html(newButtons);
                            
                            toastr.success("Tiếp nhận bệnh nhân thành công.");
                        } else {
                            toastr.error(res.message);
                            btn.prop('disabled', false).html('<i class="fas fa-stethoscope me-1"></i> Tiếp nhận khám');
                        }
                    },
                    error: function () {
                        toastr.error("Có lỗi xảy ra khi gọi server.");
                        btn.prop('disabled', false).html('<i class="fas fa-stethoscope me-1"></i> Tiếp nhận khám');
                    }
                });
            });

            // Handle Cancel Exam
            $(document).on('click', '.btn-cancel-exam', function () {
                var btn = $(this);
                var waitingId = btn.data('id');
                
                Swal.fire({
                    title: 'Xác nhận hủy khám?',
                    text: 'Bệnh nhân này sẽ được chuyển sang trạng thái đã hủy.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Đồng ý hủy',
                    cancelButtonText: 'Không'
                }).then((result) => {
                    if (result.isConfirmed) {
                        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>...');
                        $.ajax({
                            url: '@Url.Action("CancelExam", "DoctorDashboard")',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ waitingId: waitingId }),
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (res) {
                                if (res.success) {
                                    $('#waiting-row-' + waitingId).fadeOut(400, function() { $(this).remove(); });
                                    toastr.success(res.message);
                                } else {
                                    toastr.error(res.message);
                                    btn.prop('disabled', false).html('<i class="fas fa-times me-1"></i> Hủy khám');
                                }
                            },
                            error: function () {
                                toastr.error("Có lỗi xảy ra khi gọi server.");
                                btn.prop('disabled', false).html('<i class="fas fa-times me-1"></i> Hủy khám');
                            }
                        });
                    }
                });
            });
        });
        
        let currentServices = [];

        function openServiceModal(waitingId, patientId, patientName) {
            document.getElementById('serviceModal').setAttribute('data-waiting-id', waitingId);
            document.getElementById('modalPatientId').value = patientId;
            document.getElementById('modalPatientName').textContent = patientName;
            document.getElementById('totalAmountText').textContent = '0 đ';
            
            const tbody = document.getElementById('servicesListBody');
            tbody.innerHTML = '<div class="col-12 text-center text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Đang tải danh sách dịch vụ...</div>';

            // Gọi API lấy danh sách dịch vụ
            fetch('@Url.Action("GetServices", "DoctorDashboard")')
                .then(response => response.json())
                .then(result => {
                    if(result.success) {
                        currentServices = result.data;
                        tbody.innerHTML = '';
                        if(currentServices.length === 0) {
                            tbody.innerHTML = '<div class="col-12 text-center text-muted">Không có dịch vụ nào khả dụng</div>';
                            return;
                        }

                        currentServices.forEach(s => {
                            let iconClass = 'fa-stethoscope';
                            let bgClass = 'bg-blue-soft';
                            if (s.name.includes('Huyết áp') || s.name.includes('Triệu chứng')) {
                                iconClass = 'fa-heartbeat';
                                bgClass = 'bg-red-soft';
                            } else if (s.name.includes('Huyết học')) {
                                iconClass = 'fa-tint';
                                bgClass = 'bg-blue-soft';
                            } else if (s.name.includes('Điện tâm đồ') || s.name.includes('Mạch vành')) {
                                iconClass = 'fa-wave-square';
                                bgClass = 'bg-purple-soft';
                            }

                            let descHtml = '';
                            if (s.description) {
                                let items = s.description.split('|');
                                descHtml = '<ul class="list-unstyled mt-3 mb-0 small text-muted border-top pt-2">';
                                items.forEach(item => {
                                    descHtml += `<li class="mb-1 d-flex align-items-start"><i class="fas fa-check text-success mt-1 me-2" style="font-size:0.75rem"></i><span>${item}</span></li>`;
                                });
                                descHtml += '</ul>';
                            }

                            const col = document.createElement('div');
                            col.className = 'col-lg-4 col-md-6 mb-3';
                            col.innerHTML = `
                                <div class="form-section position-relative h-100 d-flex flex-column" style="cursor:pointer;" onclick="toggleCheckbox(${s.id})">
                                    <div class="position-absolute top-0 end-0 p-3">
                                        <input class="form-check-input service-checkbox fs-5" type="checkbox" id="chk_service_${s.id}" value="${s.id}" data-price="${s.price}" onchange="calculateTotal()" onclick="event.stopPropagation()">
                                    </div>
                                    <div class="section-title">
                                        <div class="section-icon ${bgClass}"><i class="fas ${iconClass}"></i></div>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-2">${s.name}</h6>
                                    <p class="text-danger fw-bold mb-0 fs-5">${s.price.toLocaleString('vi-VN')} đ</p>
                                    <div class="mt-auto">
                                        ${descHtml}
                                    </div>
                                </div>
                            `;
                            tbody.appendChild(col);
                        });
                    } else {
                        tbody.innerHTML = `<div class="col-12 text-center text-danger">Lỗi: ${result.message}</div>`;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    tbody.innerHTML = '<div class="col-12 text-center text-danger">Đã có lỗi xảy ra khi tải dịch vụ.</div>';
                });

            const modal = new bootstrap.Modal(document.getElementById('serviceModal'));
            modal.show();
        }

        function toggleCheckbox(id) {
            const chk = document.getElementById('chk_service_' + id);
            if(chk) {
                chk.checked = !chk.checked;
                calculateTotal();
            }
        }

        function calculateTotal() {
            let total = 0;
            document.querySelectorAll('.service-checkbox:checked').forEach(cb => {
                total += parseFloat(cb.getAttribute('data-price'));
            });
            document.getElementById('totalAmountText').textContent = total.toLocaleString('vi-VN') + ' đ';
        }

        function submitServices() {
            const patientId = document.getElementById('modalPatientId').value;
            const selectedIds = Array.from(document.querySelectorAll('.service-checkbox:checked')).map(cb => parseInt(cb.value));

            if (selectedIds.length === 0) {
                Swal.fire('Lỗi', 'Vui lòng chọn ít nhất một dịch vụ.', 'warning');
                return;
            }

            const btn = document.getElementById('btnSubmitServices');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...';

            fetch('@Url.Action("CreatePayment", "DoctorDashboard")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ patientId: parseInt(patientId), serviceIds: selectedIds })
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    Swal.fire('Thành công', result.message, 'success').then(() => {
                        const modalEl = document.getElementById('serviceModal');
                        const waitingId = modalEl.getAttribute('data-waiting-id');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        modal.hide();
                        
                        const actionCell = $('#action-cell-' + waitingId);
                        if (actionCell.length) {
                            const newButtons = `
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" onclick="openServiceModal(${waitingId}, ${patientId}, '${document.getElementById('modalPatientName').textContent}')">
                                        <i class="fas fa-plus-circle me-1"></i> Thêm dịch vụ
                                    </button>
                                    <a href="/ClinicalRecord/Index/${patientId}" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm">
                                        <i class="fas fa-history me-1"></i> Vào khám
                                    </a>
                                </div>
                            `;
                            actionCell.html(newButtons);
                        }
                    });
                } else {
                    Swal.fire('Lỗi', result.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Lỗi', 'Đã xảy ra lỗi kết nối.', 'error');
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane me-1"></i> Gửi yêu cầu thanh toán';
            });
        }
    </script>
}
