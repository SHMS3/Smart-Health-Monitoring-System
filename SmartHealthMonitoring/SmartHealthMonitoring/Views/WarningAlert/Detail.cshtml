@model SmartHealthMonitoring.ViewModels.WarningAlertDetailViewModel

@{
    ViewData["Title"] = "Chi tiết cảnh báo";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold text-danger mb-0">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Chi tiết cảnh báo #@Model.Alert.Id
        </h2>

        <a asp-action="Dashboard"
           class="btn btn-outline-secondary">

            <i class="fas fa-arrow-left me-1"></i>
            Quay lại

        </a>

    </div>

    <!-- ALERT INFO -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-danger text-white">

            Thông tin cảnh báo

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <strong>Mức rủi ro:</strong>

                    @if (Model.Alert.Prediction.RiskLevel == 0)
                    {
                        <span class="badge bg-success">Thấp</span>
                    }
                    else if (Model.Alert.Prediction.RiskLevel == 1)
                    {
                        <span class="badge bg-warning text-dark">
                            Trung bình
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Cao</span>
                    }

                </div>

                <div class="col-md-4">

                    <strong>Điểm AI:</strong>

                    @((Model.Alert.Prediction.RiskScore * 100).ToString("0.00"))%

                </div>

                <div class="col-md-4">

                    <strong>Ngày tạo:</strong>

                    @Model.Alert.FlaggedAt.ToString("dd/MM/yyyy HH:mm")

                </div>

            </div>

            <hr />

            <div class="row">

                <div class="col-md-6">

                    <strong>Trạng thái:</strong>

                    @switch (Model.Alert.Status)
                    {
                        case 0:
                            <span class="badge bg-danger">
                                Chờ xử lý
                            </span>
                            break;

                        case 1:
                            <span class="badge bg-warning text-dark">
                                Đang xử lý
                            </span>
                            break;

                        case 2:
                            <span class="badge bg-success">
                                Đã xử lý
                            </span>
                            break;
                    }

                </div>

                <div class="col-md-6">

                    <strong>Bác sĩ tiếp nhận:</strong>

                    @(Model.Alert.ClaimedByDoctor?.User?.FullName ?? "Chưa có")

                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Alert.ResolutionNote))
            {
                <hr />

                <div>

                    <strong>Ghi chú xử lý:</strong>

                    <div class="alert alert-light mt-2">

                        @Model.Alert.ResolutionNote

                    </div>

                </div>
            }

        </div>

    </div>

    <!-- PATIENT -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white">

            Thông tin bệnh nhân

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <strong>Họ tên:</strong><br />

                    @Model.Alert.Patient.User.FullName

                </div>

                <div class="col-md-4">

                    <strong>SĐT:</strong><br />

                    @Model.Alert.Patient.Phone

                </div>

                <div class="col-md-4">

                    <strong>CCCD:</strong><br />

                    @Model.Alert.Patient.CitizenId

                </div>

            </div>

            <hr />

            <div>

                <strong>Địa chỉ:</strong><br />

                @Model.Alert.Patient.Address

            </div>

        </div>

    </div>

    <!-- VITAL LOG -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-info text-white">

            10 lần ghi nhận sức khỏe gần nhất

        </div>

        <div class="card-body p-0">

            <table class="table table-striped mb-0">

                <thead>

                    <tr>

                        <th>Ngày</th>
                        <th>HA</th>
                        <th>Nhịp tim</th>
                        <th>Đau ngực</th>
                        <th>Exercise Angina</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var log in Model.RecentVitalLogs)
                    {
                        <tr>

                            <td>
                                @log.LoggedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @log.SystolicBp/@log.DiastolicBp
                            </td>

                            <td>
                                @log.HeartRate bpm
                            </td>

                            <td>
                                @log.ChestPainLevel
                            </td>

                            <td>

                                @(log.HasExerciseAngina ? "Có" : "Không")

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- CLINICAL RECORD -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-success text-white">

            10 hồ sơ khám gần nhất

        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead>

                    <tr>

                        <th>Ngày khám</th>
                        <th>BP</th>
                        <th>Cholesterol</th>
                        <th>Max HR</th>
                        <th>OldPeak</th>
                        <th>ECG</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var record in Model.ClinicalRecords)
                    {
                        <tr>

                            <td>
                                @record.VisitDate.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @record.RestingBp
                            </td>

                            <td>
                                @record.Cholesterol
                            </td>

                            <td>
                                @record.MaxHeartRate
                            </td>

                            <td>
                                @record.OldPeak
                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(record.EcgImageUrl))
                                {
                                    <a href="@record.EcgImageUrl"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">

                                        Xem ECG

                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Không có
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>