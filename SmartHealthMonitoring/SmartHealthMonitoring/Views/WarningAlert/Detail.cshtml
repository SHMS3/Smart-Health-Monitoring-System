@model SmartHealthMonitoring.ViewModels.WarningAlertDetailViewModel

@{
    ViewData["Title"] = "Chi tiết cảnh báo";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold text-danger mb-0">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Chi tiết cảnh báo #@Model.Alert.Id
        </h2>

        <a asp-action="Dashboard"
           class="btn btn-outline-secondary">

            <i class="fas fa-arrow-left me-1"></i>
            Quay lại

        </a>

    </div>

    <!-- ALERT INFO -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-danger text-white">

            Thông tin cảnh báo

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <strong>Mức rủi ro:</strong>

                    @if (Model.Alert.Prediction.RiskLevel == 0)
                    {
                        <span class="badge bg-success">Thấp</span>
                    }
                    else if (Model.Alert.Prediction.RiskLevel == 1)
                    {
                        <span class="badge bg-warning text-dark">
                            Trung bình
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Cao</span>
                    }

                </div>

                <div class="col-md-4">

                    <strong>Điểm AI:</strong>

                    @((Model.Alert.Prediction.RiskScore * 100).ToString("0.00"))%

                </div>

                <div class="col-md-4">

                    <strong>Ngày tạo:</strong>

                    @Model.Alert.FlaggedAt.ToString("dd/MM/yyyy HH:mm")

                </div>

            </div>

            <hr />

            <div class="row">

                <div class="col-md-6">

                    <strong>Trạng thái:</strong>

                    @switch (Model.Alert.Status)
                    {
                        case 0:
                            <span class="badge bg-danger">
                                Chờ xử lý
                            </span>
                            break;

                        case 1:
                            <span class="badge bg-warning text-dark">
                                Đang xử lý
                            </span>
                            break;

                        case 2:
                            <span class="badge bg-success">
                                Đã xử lý
                            </span>
                            break;
                    }

                </div>

                <div class="col-md-6">

                    <strong>Bác sĩ tiếp nhận:</strong>

                    @(Model.Alert.ClaimedByDoctor?.User?.FullName ?? "Chưa có")

                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Alert.ResolutionNote))
            {
                <hr />

                <div>

                    <strong>Ghi chú xử lý:</strong>

                    <div class="alert alert-light mt-2">

                        @Model.Alert.ResolutionNote

                    </div>

                </div>
            }

        </div>

    </div>

    <!-- PATIENT -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white">

            Thông tin bệnh nhân

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <strong>Họ tên:</strong><br />

                    @Model.Alert.Patient.User.FullName

                </div>

                <div class="col-md-4">

                    <strong>SĐT:</strong><br />

                    @Model.Alert.Patient.Phone

                </div>

                <div class="col-md-4">

                    <strong>CCCD:</strong><br />

                    @Model.Alert.Patient.CitizenId

                </div>

            </div>

            <hr />

            <div>

                <strong>Địa chỉ:</strong><br />

                @Model.Alert.Patient.Address

            </div>

        </div>

    </div>

    <!-- VITAL LOG -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-info text-white">

            10 lần ghi nhận sức khỏe gần nhất

        </div>

        <div class="card-body p-0">

            <table class="table table-striped mb-0">

                <thead>

                    <tr>

                        <th>Ngày</th>
                        <th>HA</th>
                        <th>Nhịp tim</th>
                        <th>Mức độ đau ngực</th>
                        <th>Exercise Angina</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var log in Model.RecentVitalLogs)
                    {
                        <tr>

                            <td>
                                @log.LoggedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @log.SystolicBp/@log.DiastolicBp
                            </td>

                            <td>
                                @log.HeartRate bpm
                            </td>

                            <td>
                                @log.ChestPainLevel
                            </td>

                            <td>

                                @(log.HasExerciseAngina ? "Có" : "Không")

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- CLINICAL RECORD -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-success text-white">

            10 hồ sơ khám gần nhất

        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead>

                    <tr>

                        <th>Ngày khám</th>
                        <th>BP</th>
                        <th>Cholesterol</th>
                        <th>Max HR</th>
                        <th>OldPeak</th>
                        <th>ECG</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var record in Model.ClinicalRecords)
                    {
                        <tr>

                            <td>
                                @record.VisitDate.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @record.RestingBp
                            </td>

                            <td>
                                @record.Cholesterol
                            </td>

                            <td>
                                @record.MaxHeartRate
                            </td>

                            <td>
                                @record.OldPeak
                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(record.EcgImageUrl))
                                {
                                    <a href="@record.EcgImageUrl"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">

                                        Xem ECG

                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Không có
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
    @if (Model.Alert.Status == 1)
    {
    <div class="card shadow-sm border-0 mt-4">

        
        <div class="card-header bg-warning">

            <strong>Xử lý cảnh báo</strong>

        </div>

        <div class="card-body">

            <form asp-action="Resolve"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Alert.Id" />

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Ghi chú xử lý
                    </label>

                    <textarea name="resolutionNote"
                              class="form-control"
                              rows="4"
                              required
                              placeholder="Nhập ghi chú xử lý..."></textarea>

                </div>

                <h6 class="border-bottom pb-2 mb-3">
                    Cập nhật ngưỡng cảnh báo (Tùy chọn)
                </h6>

                <div class="row">

                        <div class="col-md-3 mb-3">

                            <label>HA Tâm Thu Cảnh Báo</label>

                            <input type="number"
                                   name="systolicBpWarning"
                                   class="form-control"
                                   placeholder="VD: @(Model.Alert.Patient.PatientThreshold?.SystolicBpWarning)" />

                        </div>

                        <div class="col-md-3 mb-3">

                            <label>HA Tâm Thu Nguy Hiểm</label>

                            <input type="number"
                                   name="systolicBpDanger"
                                   class="form-control"
                                   placeholder="VD: @(Model.Alert.Patient.PatientThreshold?.SystolicBpDanger)" />

                        </div>

                        <div class="col-md-3 mb-3">

                            <label>HA Tâm Trương Cảnh Báo</label>

                            <input type="number"
                                   name="diastolicBpWarning"
                                   class="form-control"
                                   placeholder="VD: @(Model.Alert.Patient.PatientThreshold?.DiastolicBpWarning)" />

                        </div>

                        <div class="col-md-3 mb-3">

                            <label>HA Tâm Trương Nguy Hiểm</label>

                            <input type="number"
                                   name="diastolicBpDanger"
                                   class="form-control"
                                   placeholder="VD: @(Model.Alert.Patient.PatientThreshold?.DiastolicBpDanger)" />

                        </div>

                        <div class="col-md-3 mb-3">

                            <label>Nhịp tim thấp nguy hiểm</label>

                            <input type="number"
                                   name="heartRateDangerMin"
                                   class="form-control"
                                   placeholder="VD: @(Model.Alert.Patient.PatientThreshold?.HeartRateDangerMin)" />

                        </div>

                        <div class="col-md-3 mb-3">

                            <label>Nhịp tim thấp cảnh báo</label>

                            <input type="number"
                                   name="heartRateWarningMin"
                                   class="form-control"
                                   placeholder="VD: @(Model.Alert.Patient.PatientThreshold?.HeartRateWarningMin)" />

                        </div>

                        <div class="col-md-3 mb-3">

                            <label>Nhịp tim cao cảnh báo</label>

                            <input type="number"
                                   name="heartRateWarningMax"
                                   class="form-control"
                                   placeholder="VD: @(Model.Alert.Patient.PatientThreshold?.HeartRateWarningMax)" />

                        </div>

                        <div class="col-md-3 mb-3">

                            <label>Nhịp tim cao nguy hiểm</label>

                            <input type="number"
                                   name="heartRateDangerMax"
                                   class="form-control"
                                   placeholder="VD: @(Model.Alert.Patient.PatientThreshold?.HeartRateDangerMax)" />

                        </div>

                </div>

                <hr />

                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="checkbox"
                           name="sendEmailInvitation"
                           value="true"
                           id="sendEmail"
                           checked />

                    <label class="form-check-label"
                           for="sendEmail">

                        Gửi email mời tái khám

                    </label>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Ngày tái khám
                    </label>

                    <input type="datetime-local"
                           name="appointmentDate"
                           class="form-control" />

                </div>

                <button type="submit"
                        class="btn btn-success">

                    <i class="fas fa-check-circle me-1"></i>
                    Hoàn tất xử lý

                </button>

            </form>

        </div>

    </div>
        

        }


</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {

        const sendEmail = document.getElementById('sendEmail');
        const appointmentDate = document.querySelector('[name="appointmentDate"]');

        function toggleRequired() {
            appointmentDate.required = sendEmail.checked;
        }

        sendEmail.addEventListener('change', toggleRequired);

        toggleRequired();
    });
</script>