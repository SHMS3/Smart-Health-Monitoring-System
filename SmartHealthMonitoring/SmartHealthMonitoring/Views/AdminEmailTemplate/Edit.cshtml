@model SmartHealthMonitoring.ViewModels.Admin.EmailTemplateEditViewModel

@{
    ViewData["Title"] = "Sửa mẫu Email";
    Layout = "_AdminLayout";
}

<style>
    .template-edit-header {
        background: linear-gradient(135deg, #0f172a 0%, #164e63 55%, #0f766e 100%);
        border-radius: 16px;
        padding: 1.8rem 2.5rem;
        color: #fff;
        margin-bottom: 2rem;
    }

    .template-edit-header h4 {
        margin-bottom: .35rem;
        font-weight: 800;
    }

    .template-edit-header p {
        color: rgba(255,255,255,.78);
        margin: 0;
    }

    .edit-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 4px 20px rgba(15,23,42,.08);
        overflow: hidden;
    }

    .edit-panel-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 1rem 1.25rem;
        font-weight: 800;
        color: #0f172a;
    }

    .edit-panel-body {
        padding: 1.25rem;
    }

    .form-label {
        color: #334155;
        font-size: .88rem;
        font-weight: 700;
    }

    .form-control {
        border-radius: 10px;
        border: 1.5px solid #dbe3ec;
        font-size: .92rem;
    }

    .form-control:focus {
        border-color: #0ea5e9;
        box-shadow: 0 0 0 3px rgba(14,165,233,.12);
    }

    .html-editor {
        min-height: 620px;
        font-family: Consolas, "Courier New", monospace;
        font-size: .86rem;
        line-height: 1.55;
        resize: vertical;
    }

    .mode-tabs {
        display: inline-flex;
        gap: 6px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 5px;
    }

    .mode-tab {
        border: 0;
        border-radius: 9px;
        padding: 8px 14px;
        font-weight: 800;
        color: #475569;
        background: transparent;
    }

    .mode-tab.active {
        background: #0ea5e9;
        color: #fff;
        box-shadow: 0 8px 18px rgba(14,165,233,.22);
    }

    .editor-help {
        background: #ecfeff;
        border: 1px solid #a5f3fc;
        color: #155e75;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: .86rem;
        margin-bottom: 1rem;
    }

    .token-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .token-chip {
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #0f172a;
        border-radius: 999px;
        padding: 7px 11px;
        font-size: .78rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .15s ease;
    }

    .token-chip:hover {
        background: #e0f2fe;
        border-color: #7dd3fc;
        color: #075985;
    }

    .preview-frame {
        width: 100%;
        height: 560px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #fff;
    }

    .help-text {
        color: #64748b;
        font-size: .82rem;
    }

    .template-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 999px;
        padding: 5px 12px;
        font-size: .78rem;
        font-weight: 700;
        margin-top: .5rem;
    }

    .advanced-pane {
        display: none;
    }

    .advanced-pane.active,
    .visual-pane.active {
        display: block;
    }

    .visual-pane {
        display: block;
    }
</style>

<div class="template-edit-header">
    <h4><i class="fas fa-pen-to-square me-2"></i>@Model.DisplayName</h4>
    <p>@Model.Description</p>
    <div class="template-badge">
        <i class="fas fa-file-code"></i>@Model.TemplateName
    </div>
</div>

<form asp-action="Edit" method="post" id="emailTemplateForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TemplateName" />
    <input type="hidden" asp-for="EditorMode" />

    <div class="row g-4">
        <div class="col-xl-7">
            <div class="edit-panel">
                <div class="edit-panel-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
                    <span><i class="fas fa-envelope-open-text me-2 text-primary"></i>Nội dung mẫu</span>
                    <div class="mode-tabs" role="tablist">
                        <button type="button" class="mode-tab active" data-mode="visual">
                            <i class="fas fa-pen me-1"></i>Soạn thảo dễ
                        </button>
                        <button type="button" class="mode-tab" data-mode="advanced">
                            <i class="fas fa-code me-1"></i>HTML nâng cao
                        </button>
                    </div>
                </div>
                <div class="edit-panel-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label">Tiêu đề email</label>
                        <input asp-for="Subject" class="form-control" maxlength="200" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                        <div class="help-text mt-1">Có thể dùng biến như <strong>{{PatientName}}</strong> trong tiêu đề.</div>
                    </div>

                    <div id="visualPane" class="visual-pane active">
                        <div class="editor-help">
                            Chế độ này chỉ sửa phần nội dung chính của email. Màu sắc, font chữ và bố cục trong mẫu gốc vẫn được giữ lại khi lưu.
                        </div>
                        <label asp-for="BodyContent" class="form-label">Nội dung email</label>
                        <textarea asp-for="BodyContent" class="form-control" rows="18"></textarea>
                        <span asp-validation-for="BodyContent" class="text-danger small"></span>
                    </div>

                    <div id="advancedPane" class="advanced-pane">
                        <div class="editor-help">
                            Chế độ nâng cao cho phép sửa toàn bộ HTML, bao gồm cả CSS trong phần head.
                        </div>
                        <label asp-for="HtmlContent" class="form-label">Toàn bộ HTML</label>
                        <textarea asp-for="HtmlContent" class="form-control html-editor" spellcheck="false"></textarea>
                        <span asp-validation-for="HtmlContent" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button type="submit" class="btn btn-success fw-bold px-4">
                            <i class="fas fa-save me-2"></i>Lưu thay đổi
                        </button>
                        <button type="button" class="btn btn-outline-primary fw-bold px-4" id="refreshPreviewBtn">
                            <i class="fas fa-eye me-2"></i>Xem bản đang sửa
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="edit-panel mb-4">
                <div class="edit-panel-header">
                    <i class="fas fa-tags me-2 text-info"></i>Biến có thể dùng
                </div>
                <div class="edit-panel-body">
                    <div class="token-list">
                        @foreach (var token in Model.Tokens)
                        {
                            <button type="button" class="token-chip" data-token="@token">@token</button>
                        }
                    </div>
                    <div class="help-text mt-3">
                        Bấm vào biến để chèn nhanh. Khi gửi email, hệ thống sẽ tự thay bằng dữ liệu thật.
                    </div>
                </div>
            </div>

            <div class="edit-panel">
                <div class="edit-panel-header d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-desktop me-2 text-success"></i>Preview</span>
                    @if (Model.LastModifiedAt.HasValue)
                    {
                        <small class="text-muted fw-normal">@Model.LastModifiedAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                    }
                </div>
                <div class="edit-panel-body">
                    <iframe id="templatePreview" class="preview-frame"></iframe>
                    <textarea id="initialPreviewHtml" class="d-none">@Model.PreviewHtml</textarea>
                    <div class="help-text mt-2">
                        Preview dùng dữ liệu mẫu. Nội dung thực tế sẽ thay các biến bằng thông tin bệnh nhân/bác sĩ khi gửi.
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>
    <script src="~/js/admin-email-template-editor.js" asp-append-version="true"></script>
}
