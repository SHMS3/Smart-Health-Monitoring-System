@model SmartHealthMonitoring.ViewModels.Admin.EmailTemplateEditViewModel

@{
    ViewData["Title"] = "Sửa mẫu Email";
    Layout = "_AdminLayout";
}

<style>
    .template-edit-header {
        background: linear-gradient(135deg, #0f172a 0%, #164e63 55%, #0f766e 100%);
        border-radius: 16px;
        padding: 1.8rem 2.5rem;
        color: #fff;
        margin-bottom: 2rem;
    }

    .template-edit-header h4 {
        margin-bottom: .35rem;
        font-weight: 800;
    }

    .template-edit-header p {
        color: rgba(255,255,255,.78);
        margin: 0;
    }

    .edit-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 4px 20px rgba(15,23,42,.08);
        overflow: hidden;
    }

    .edit-panel-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 1rem 1.25rem;
        font-weight: 800;
        color: #0f172a;
    }

    .edit-panel-body {
        padding: 1.25rem;
    }

    .form-label {
        color: #334155;
        font-size: .88rem;
        font-weight: 700;
    }

    .form-control {
        border-radius: 10px;
        border: 1.5px solid #dbe3ec;
        font-size: .92rem;
    }

    .form-control:focus {
        border-color: #0ea5e9;
        box-shadow: 0 0 0 3px rgba(14,165,233,.12);
    }

    .html-editor {
        min-height: 620px;
        font-family: Consolas, "Courier New", monospace;
        font-size: .86rem;
        line-height: 1.55;
        resize: vertical;
    }

    .editor-mode .btn {
        border-radius: 8px;
        font-size: .82rem;
        font-weight: 700;
    }

    .editor-mode .btn.active {
        background: #0f766e;
        border-color: #0f766e;
        color: #fff;
    }

    .visual-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 10px;
        background: #f8fafc;
        border: 1.5px solid #dbe3ec;
        border-bottom: 0;
        border-radius: 10px 10px 0 0;
    }

    .visual-toolbar button {
        width: 36px;
        height: 34px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        background: #fff;
        color: #334155;
    }

    .visual-toolbar button:hover {
        background: #e0f2fe;
        border-color: #7dd3fc;
        color: #075985;
    }

    .visual-toolbar .toolbar-separator {
        width: 1px;
        margin: 3px 2px;
        background: #dbe3ec;
    }

    .visual-editor {
        display: block;
        width: 100%;
        height: 620px;
        border: 1.5px solid #dbe3ec;
        border-radius: 0 0 10px 10px;
        background: #fff;
    }

    .visual-editor:focus {
        border-color: #0ea5e9;
    }

    .editor-help {
        background: #ecfeff;
        border: 1px solid #a5f3fc;
        color: #155e75;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: .86rem;
        margin-bottom: 1rem;
    }

    .token-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .token-chip {
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #0f172a;
        border-radius: 999px;
        padding: 7px 11px;
        font-size: .78rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .15s ease;
    }

    .token-chip:hover {
        background: #e0f2fe;
        border-color: #7dd3fc;
        color: #075985;
    }

    .preview-frame {
        width: 100%;
        height: 560px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #fff;
    }

    .help-text {
        color: #64748b;
        font-size: .82rem;
    }

    .template-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 999px;
        padding: 5px 12px;
        font-size: .78rem;
        font-weight: 700;
        margin-top: .5rem;
    }

</style>

<div class="template-edit-header">
    <h4><i class="fas fa-pen-to-square me-2"></i>@Model.DisplayName</h4>
    <p>@Model.Description</p>
    <div class="template-badge">
        <i class="fas fa-file-code"></i>@Model.TemplateName
    </div>
</div>

<form asp-action="Edit" method="post" id="emailTemplateForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TemplateName" />

    <div class="row g-4">
        <div class="col-xl-7">
            <div class="edit-panel">
                <div class="edit-panel-header">
                    <span><i class="fas fa-envelope-open-text me-2 text-primary"></i>Nội dung mẫu</span>
                </div>
                <div class="edit-panel-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label">Tiêu đề email</label>
                        <input asp-for="Subject" class="form-control" maxlength="200" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                        <div class="help-text mt-1">Có thể dùng biến như <strong>{{PatientName}}</strong> trong tiêu đề.</div>
                    </div>

                    <div class="editor-help">
                        Bấm trực tiếp vào email bên dưới rồi sửa như văn bản thông thường. Không cần biết HTML.
                    </div>
                    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                        <label asp-for="HtmlContent" class="form-label mb-0">Nội dung email</label>
                        <div class="btn-group editor-mode" role="group" aria-label="Chế độ soạn thảo">
                            <button type="button" class="btn btn-outline-secondary active" id="visualModeBtn">Soạn trực quan</button>
                            <button type="button" class="btn btn-outline-secondary" id="htmlModeBtn">HTML nâng cao</button>
                        </div>
                    </div>
                    <div id="visualEditorPanel">
                        <div class="visual-toolbar" role="toolbar" aria-label="Định dạng nội dung">
                            <button type="button" data-command="bold" title="In đậm" aria-label="In đậm"><i class="fas fa-bold"></i></button>
                            <button type="button" data-command="italic" title="In nghiêng" aria-label="In nghiêng"><i class="fas fa-italic"></i></button>
                            <button type="button" data-command="underline" title="Gạch chân" aria-label="Gạch chân"><i class="fas fa-underline"></i></button>
                            <span class="toolbar-separator" aria-hidden="true"></span>
                            <button type="button" data-command="insertUnorderedList" title="Danh sách" aria-label="Danh sách"><i class="fas fa-list-ul"></i></button>
                            <button type="button" data-command="createLink" title="Chèn liên kết" aria-label="Chèn liên kết"><i class="fas fa-link"></i></button>
                        </div>
                        <iframe id="visualEditor" class="visual-editor" sandbox="allow-same-origin" title="Soạn nội dung email trực quan"></iframe>
                        <div class="help-text mt-2">Chọn chữ để định dạng. Bấm biến bên phải để chèn dữ liệu tự động.</div>
                    </div>
                    <div id="htmlEditorPanel" hidden>
                        <textarea asp-for="HtmlContent" class="form-control html-editor" spellcheck="false"></textarea>
                        <div class="help-text mt-2">Dành cho người biết HTML và cần chỉnh cấu trúc nâng cao.</div>
                    </div>
                    <span asp-validation-for="HtmlContent" class="text-danger small"></span>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button type="submit" class="btn btn-success fw-bold px-4">
                            <i class="fas fa-save me-2"></i>Lưu thay đổi
                        </button>
                        <button type="button" class="btn btn-outline-primary fw-bold px-4" id="refreshPreviewBtn">
                            <i class="fas fa-eye me-2"></i>Xem bản đang sửa
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="edit-panel mb-4">
                <div class="edit-panel-header">
                    <i class="fas fa-tags me-2 text-info"></i>Dữ liệu tự động
                </div>
                <div class="edit-panel-body">
                    <div class="token-list">
                        @foreach (var token in Model.Tokens)
                        {
                            <button type="button" class="token-chip" data-token="@token">@token</button>
                        }
                    </div>
                    <div class="help-text mt-3">
                        Nội dung dạng <strong>{{...}}</strong> sẽ được hệ thống thay bằng dữ liệu thật khi gửi. Không sửa phần nằm trong hai dấu ngoặc nhọn.
                    </div>
                </div>
            </div>

            <div class="edit-panel">
                <div class="edit-panel-header d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-desktop me-2 text-success"></i>Bản xem trước</span>
                    @if (Model.LastModifiedAt.HasValue)
                    {
                        <small class="text-muted fw-normal">@Model.LastModifiedAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                    }
                </div>
                <div class="edit-panel-body">
                    <iframe id="templatePreview" class="preview-frame" sandbox></iframe>
                    <div class="help-text mt-2">
                        Preview giữ nguyên các biến; hệ thống thay chúng bằng dữ liệu thật khi gửi.
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const editor = document.getElementById('HtmlContent');
        const form = document.getElementById('emailTemplateForm');
        const visualEditor = document.getElementById('visualEditor');
        const visualPanel = document.getElementById('visualEditorPanel');
        const htmlPanel = document.getElementById('htmlEditorPanel');
        const visualModeBtn = document.getElementById('visualModeBtn');
        const htmlModeBtn = document.getElementById('htmlModeBtn');
        const subject = document.getElementById('Subject');
        const preview = document.getElementById('templatePreview');
        let visualDirty = false;
        let insertTarget = 'visual';

        const visualDocument = () => visualEditor.contentDocument;
        const loadVisualEditor = () => {
            visualDirty = false;
            visualEditor.srcdoc = editor.value;
        };
        const saveVisualEditor = () => {
            if (!visualDirty) return;
            editor.value = '<!DOCTYPE html>\n' + visualDocument().documentElement.outerHTML;
            visualDirty = false;
        };
        const refreshPreview = () => {
            saveVisualEditor();
            preview.srcdoc = editor.value;
        };
        const insertIntoInput = (input, value) => {
            input.setRangeText(value, input.selectionStart, input.selectionEnd, 'end');
            input.focus();
        };

        visualEditor.addEventListener('load', () => {
            const doc = visualDocument();
            doc.designMode = 'on';
            doc.addEventListener('input', () => visualDirty = true);
            doc.addEventListener('focusin', () => insertTarget = 'visual');
            doc.addEventListener('click', event => {
                if (event.target.closest('a')) event.preventDefault();
            });
        });

        document.querySelectorAll('[data-command]').forEach(button => button.addEventListener('click', () => {
            let value = null;
            if (button.dataset.command === 'createLink') {
                value = window.prompt('Nhập địa chỉ liên kết:');
                if (!value) return;
            }
            visualEditor.contentWindow.focus();
            visualDocument().execCommand(button.dataset.command, false, value);
            visualDirty = true;
        }));

        visualModeBtn.addEventListener('click', () => {
            visualPanel.hidden = false;
            htmlPanel.hidden = true;
            visualModeBtn.classList.add('active');
            htmlModeBtn.classList.remove('active');
            insertTarget = 'visual';
            loadVisualEditor();
        });
        htmlModeBtn.addEventListener('click', () => {
            saveVisualEditor();
            visualPanel.hidden = true;
            htmlPanel.hidden = false;
            visualModeBtn.classList.remove('active');
            htmlModeBtn.classList.add('active');
            insertTarget = 'html';
            editor.focus();
        });
        subject.addEventListener('focus', () => insertTarget = 'subject');
        editor.addEventListener('focus', () => insertTarget = 'html');

        document.getElementById('refreshPreviewBtn').addEventListener('click', refreshPreview);
        document.querySelectorAll('.token-chip').forEach(button => button.addEventListener('click', () => {
            if (insertTarget === 'subject') return insertIntoInput(subject, button.dataset.token);
            if (insertTarget === 'html') return insertIntoInput(editor, button.dataset.token);

            visualEditor.contentWindow.focus();
            visualDocument().execCommand('insertText', false, button.dataset.token);
            visualDirty = true;
        }));
        form.addEventListener('submit', saveVisualEditor);
        loadVisualEditor();
        refreshPreview();
    </script>
}
